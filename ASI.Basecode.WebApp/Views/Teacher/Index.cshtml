@model ASI.Basecode.WebApp.Models.TeacherDashboardViewModel
@{
    ViewData["Title"] = "Teachers - Acadus";
    Layout = "~/Views/Shared/_AuthenticatedLayout.cshtml";
}

<script src="https://cdn.tailwindcss.com"></script>

<!-- White Section with Statistics Cards -->
<section class="bg-white py-8">
    <div class="container max-w-[1200px] mx-auto px-4">
        <div class="grid grid-cols-3 gap-6 max-w-[900px] mx-auto">
            @await Component.InvokeAsync("StatisticsCard", new { title = "Total activities", value = Model.TotalActivities ?? 0, icon = "activity" })
            @await Component.InvokeAsync("StatisticsCard", new { title = "Graded Activities", value = Model.GradedActivities ?? 0, icon = "graded" })
            @await Component.InvokeAsync("StatisticsCard", new { title = "Total Courses Handled", value = Model.TotalCoursesHandled ?? 0, icon = "courses" })
        </div>
    </div>
</section>

<!-- Green Section with Overview -->
<section class="bg-[#E8F9E8] py-8">
    <div class="container max-w-[1200px] mx-auto px-4">
        <h2 class="text-center font-extrabold m-0 mb-0.5 text-3xl text-gray-900">Overview</h2>
        <p class="text-center m-0 mb-6 text-gray-600 text-base">Stay on top of your upcoming tasks and responsibilities</p>

        <div class="grid grid-cols-1">
            @await Component.InvokeAsync("RecentActivity")
        </div>
    </div>
</section>

@section Scripts {
    <style>
        /* Subtler table outlines */
        #recentActivityTable {
            border: none !important;
        }
        #recentActivityTable thead th {
            border-bottom: 1px solid #f3f4f6 !important;
        }
        #recentActivityTable tbody td {
            border-bottom: 1px solid #f3f4f6 !important;
        }

    </style>
    <script>
        $(document).ready(function() {
            // Destroy existing DataTable instance if it exists
            if ($.fn.DataTable.isDataTable('#recentActivityTable')) {
                $('#recentActivityTable').DataTable().destroy();
            }
            
            $('#recentActivityTable').DataTable({
                paging: false,
                searching: false,
                ordering: true,
                info: false,
                lengthChange: false,
                autoWidth: false,
                columns: [
                    null, // Activity
                    null  // Date & Time
                ]
            });

            // View All Activities Modal
            $('#viewAllActivitiesBtn').on('click', function(e) {
                e.preventDefault();
                showViewAllModal();
            });

            async function showViewAllModal() {
                // Show loading state
                $('#viewAllModal').css('display', 'flex');
                $('#viewAllModalContent').html('<div class="py-10 px-4 text-center text-gray-500">Loading activities...</div>');

                try {
                    const response = await fetch('/Teacher/GetAllRecentActivities');
                    const data = await response.json();

                    if (data.success && data.activities) {
                        let html = '<div class="max-h-[70vh] overflow-y-auto">';
                        html += '<table class="w-full border-collapse">';
                        html += '<thead class="bg-gray-50 sticky top-0 z-10">';
                        html += '<tr><th class="py-3 px-4 text-left font-semibold text-gray-900 border-b-2 border-gray-200">Activity</th>';
                        html += '<th class="py-3 px-4 text-left font-semibold text-gray-900 border-b-2 border-gray-200">Date & Time</th></tr>';
                        html += '</thead><tbody>';

                        if (data.activities.length > 0) {
                            data.activities.forEach((activity, index) => {
                                const isHighlighted = index % 2 === 0;
                                html += `<tr class="${isHighlighted ? 'bg-[#E8F9E8]' : ''} border-b border-gray-200">`;
                                html += `<td class="py-4 px-4 font-bold text-gray-900">${activity.actionDescription}</td>`;
                                html += `<td class="py-4 px-4 text-gray-500">${activity.formattedDate}</td>`;
                                html += '</tr>';
                            });
                        } else {
                            html += '<tr><td colspan="2" class="py-8 px-4 text-center text-gray-500">No activities found.</td></tr>';
                        }

                        html += '</tbody></table></div>';
                        $('#viewAllModalContent').html(html);
                    } else {
                        $('#viewAllModalContent').html('<div class="py-10 px-4 text-center text-red-600">Error loading activities. Please try again.</div>');
                    }
                } catch (error) {
                    console.error('Error loading activities:', error);
                    $('#viewAllModalContent').html('<div class="py-10 px-4 text-center text-red-600">Error loading activities. Please try again.</div>');
                }
            }

            function closeViewAllModal() {
                $('#viewAllModal').css('display', 'none');
            }

            // Close button handlers
            $('#closeViewAllModalBtn, #closeViewAllModalBtnBottom').on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                closeViewAllModal();
            });

            // Close modal when clicking backdrop
            $('#viewAllModalBackdrop').on('click', function(e) {
                if (e.target === this) {
                    closeViewAllModal();
                }
            });

            // Close modal on ESC key
            $(document).on('keydown', function(e) {
                if (e.key === 'Escape' && $('#viewAllModal').css('display') === 'flex') {
                    closeViewAllModal();
                }
            });
        });
    </script>

    <!-- View All Activities Modal -->
    <div id="viewAllModal" class="hidden fixed top-0 left-0 w-full h-full z-[10000] items-center justify-center">
        <div id="viewAllModalBackdrop" class="absolute top-0 left-0 w-full h-full bg-black/50"></div>
        <div class="bg-white rounded-2xl p-0 max-w-[900px] w-[90%] max-h-[90vh] relative z-[10001] shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1)] flex flex-col">
            <div class="p-6 border-b border-gray-200 flex justify-between items-center relative z-[10002]">
                <h2 class="m-0 font-extrabold text-2xl text-gray-900">All Recent Activities</h2>
                <button id="closeViewAllModalBtn" class="bg-transparent border-none text-3xl text-gray-500 cursor-pointer py-1 px-2 leading-none relative z-[10003] hover:text-gray-700">&times;</button>
            </div>
            <div id="viewAllModalContent" class="p-6 overflow-y-auto flex-1 relative z-[10002]">
                <!-- Content will be loaded here -->
            </div>
            <div class="py-4 px-6 border-t border-gray-200 flex justify-end relative z-[10002]">
                <button id="closeViewAllModalBtnBottom" class="bg-emerald-600 text-white border-none rounded-lg py-2.5 px-6 font-semibold cursor-pointer relative z-[10003] hover:bg-emerald-700">Close</button>
            </div>
        </div>
    </div>
}


