@model ASI.Basecode.WebApp.Models.TeacherDashboardViewModel
@{
    ViewData["Title"] = "Teachers - Acadus";
    Layout = "~/Views/Shared/_AuthenticatedLayout.cshtml";
}

<!-- White Section with Statistics Cards -->
<section style="background:#ffffff; padding: 32px 0;">
    <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 16px;">
        <div style="display:grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap:24px; max-width: 900px; margin: 0 auto;">
            @await Component.InvokeAsync("StatisticsCard", new { title = "Total activities", value = Model.TotalActivities ?? 0, icon = "activity" })
            @await Component.InvokeAsync("StatisticsCard", new { title = "Graded Activities", value = Model.GradedActivities ?? 0, icon = "graded" })
            @await Component.InvokeAsync("StatisticsCard", new { title = "Total Courses Handled", value = Model.TotalCoursesHandled ?? 0, icon = "courses" })
        </div>
    </div>
</section>

<!-- Green Section with Overview -->
<section class="bg-[#E8F9E8]" style="padding: 32px 0;">
    <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 16px;">
        <h2 style="text-align:center; font-weight:800; margin:0 0 2px 0; font-size:28px; color:#111827;">Overview</h2>
        <p style="text-align:center; margin:0 0 24px 0; color:#4b5563; font-size:16px;">Stay on top of your upcoming tasks and responsibilities</p>

        <div style="display:grid; grid-template-columns: 1fr;">
            @await Component.InvokeAsync("RecentActivity")
        </div>
    </div>
</section>

@section Scripts {
    <style>
        /* Subtler table outlines */
        #recentActivityTable {
            border: none !important;
        }
        #recentActivityTable thead th {
            border-bottom: 1px solid #f3f4f6 !important;
        }
        #recentActivityTable tbody td {
            border-bottom: 1px solid #f3f4f6 !important;
        }

    </style>
    <script>
        $(document).ready(function() {
            // Destroy existing DataTable instance if it exists
            if ($.fn.DataTable.isDataTable('#recentActivityTable')) {
                $('#recentActivityTable').DataTable().destroy();
            }
            
            $('#recentActivityTable').DataTable({
                paging: false,
                searching: false,
                ordering: true,
                info: false,
                lengthChange: false,
                autoWidth: false,
                columns: [
                    null, // Activity
                    null  // Date & Time
                ]
            });

            // View All Activities Modal
            $('#viewAllActivitiesBtn').on('click', function(e) {
                e.preventDefault();
                showViewAllModal();
            });

            async function showViewAllModal() {
                // Show loading state
                $('#viewAllModal').css('display', 'flex');
                $('#viewAllModalContent').html('<div style="padding:40px; text-align:center; color:#6b7280;">Loading activities...</div>');

                try {
                    const response = await fetch('/Teacher/GetAllRecentActivities');
                    const data = await response.json();

                    if (data.success && data.activities) {
                        let html = '<div style="max-height:70vh; overflow-y:auto;">';
                        html += '<table style="width:100%; border-collapse:collapse;">';
                        html += '<thead style="background:#f9fafb; position:sticky; top:0; z-index:10;">';
                        html += '<tr><th style="padding:12px 16px; text-align:left; font-weight:600; color:#111827; border-bottom:2px solid #e5e7eb;">Activity</th>';
                        html += '<th style="padding:12px 16px; text-align:left; font-weight:600; color:#111827; border-bottom:2px solid #e5e7eb;">Date & Time</th></tr>';
                        html += '</thead><tbody>';

                        if (data.activities.length > 0) {
                            data.activities.forEach((activity, index) => {
                                const isHighlighted = index % 2 === 0;
                                html += `<tr style="${isHighlighted ? 'background:#E8F9E8;' : ''} border-bottom:1px solid #e5e7eb;">`;
                                html += `<td style="padding:16px; font-weight:700; color:#111827;">${activity.actionDescription}</td>`;
                                html += `<td style="padding:16px; color:#6b7280;">${activity.formattedDate}</td>`;
                                html += '</tr>';
                            });
                        } else {
                            html += '<tr><td colspan="2" style="padding:32px; text-align:center; color:#6b7280;">No activities found.</td></tr>';
                        }

                        html += '</tbody></table></div>';
                        $('#viewAllModalContent').html(html);
                    } else {
                        $('#viewAllModalContent').html('<div style="padding:40px; text-align:center; color:#dc2626;">Error loading activities. Please try again.</div>');
                    }
                } catch (error) {
                    console.error('Error loading activities:', error);
                    $('#viewAllModalContent').html('<div style="padding:40px; text-align:center; color:#dc2626;">Error loading activities. Please try again.</div>');
                }
            }

            function closeViewAllModal() {
                $('#viewAllModal').css('display', 'none');
            }

            // Close button handlers
            $('#closeViewAllModalBtn, #closeViewAllModalBtnBottom').on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                closeViewAllModal();
            });

            // Close modal when clicking backdrop
            $('#viewAllModalBackdrop').on('click', function(e) {
                if (e.target === this) {
                    closeViewAllModal();
                }
            });

            // Close modal on ESC key
            $(document).on('keydown', function(e) {
                if (e.key === 'Escape' && $('#viewAllModal').css('display') === 'flex') {
                    closeViewAllModal();
                }
            });
        });
    </script>

    <!-- View All Activities Modal -->
    <div id="viewAllModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; z-index:10000; align-items:center; justify-content:center;">
        <div id="viewAllModalBackdrop" style="position:absolute; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5);"></div>
        <div style="background:#ffffff; border-radius:16px; padding:0; max-width:900px; width:90%; max-height:90vh; position:relative; z-index:10001; box-shadow:0 20px 25px -5px rgba(0,0,0,0.1); display:flex; flex-direction:column;">
            <div style="padding:24px; border-bottom:1px solid #e5e7eb; display:flex; justify-content:space-between; align-items:center; position:relative; z-index:10002;">
                <h2 style="margin:0; font-weight:800; font-size:24px; color:#111827;">All Recent Activities</h2>
                <button id="closeViewAllModalBtn" style="background:transparent; border:none; font-size:28px; color:#6b7280; cursor:pointer; padding:4px 8px; line-height:1; position:relative; z-index:10003;">&times;</button>
            </div>
            <div id="viewAllModalContent" style="padding:24px; overflow-y:auto; flex:1; position:relative; z-index:10002;">
                <!-- Content will be loaded here -->
            </div>
            <div style="padding:16px 24px; border-top:1px solid #e5e7eb; display:flex; justify-content:flex-end; position:relative; z-index:10002;">
                <button id="closeViewAllModalBtnBottom" style="background:#059669; color:#fff; border:none; border-radius:8px; padding:10px 24px; font-weight:600; cursor:pointer; position:relative; z-index:10003;">Close</button>
            </div>
        </div>
    </div>
}


