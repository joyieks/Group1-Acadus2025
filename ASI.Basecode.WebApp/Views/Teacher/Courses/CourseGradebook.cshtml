@model ASI.Basecode.Data.Models.CourseGradebookViewModel
@{
    Layout = "~/Views/Shared/_AuthenticatedLayout.cshtml";
    ViewData["Title"] = "Course Gradebook";
}

<!-- Hero Section -->
<section class="hero-section" style="background:#E8F9E8; display:flex; align-items:center; justify-content:center; text-align:center; position:relative; padding: 40px 0;">
    <a href="/Teacher/FullCourseView/@Model.CourseId" style="position:absolute; top:20px; left:20px; background:#ffffff; color:#059669; border:1px solid #d1d5db; border-radius:8px; padding:8px 16px; font-weight:600; text-decoration:none; transition:background 0.3s; display:flex; align-items:center; gap:8px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5"></path>
            <path d="M12 19l-7-7 7-7"></path>
        </svg>
        Back to Course
    </a>
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 16px;">
        <p style="margin:0 0 4px 0; color:#4b5563; font-size:20px;">@Model.CourseCode</p>
        <h1 style="font-size:48px; font-weight:800; margin:0 0 4px 0; color:#111827;">Course Gradebook</h1>
        <p style="margin:0 0 16px 0; color:#4b5563; font-size:18px;">@Model.SemesterInfo</p>
        <p style="margin:0 0 0 0; color:#6b7280; font-size:14px;">View and manage student grades for this course.</p>
    </div>
</section>

<!-- White Section with Student Grades -->
<section style="background:#ffffff; padding: 40px 0;">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 16px;">
        <h2 style="margin:0 0 24px 0; font-weight:800; font-size:24px; color:#111827;">Student Grades</h2>

        <div style="display:grid; grid-template-columns: 3fr 5fr; gap:24px;">
            <!-- Left Column: Student List -->
            <div>
                <h3 style="margin:0 0 16px 0; font-weight:700; font-size:18px; color:#111827;">Students</h3>
                <div style="border-radius:8px; overflow:hidden; border:1px solid #e5e7eb;">
                    <table id="studentTable" style="width:100%; border-collapse:collapse;">
                        <thead style="background:#059669;">
                            <tr>
                                <th style="padding:12px 16px; text-align:left; font-weight:700; color:#fff; min-width:180px; white-space:nowrap;">Student ID</th>
                                <th style="padding:12px 16px; text-align:left; font-weight:700; color:#fff; min-width:200px; white-space:nowrap;">Name</th>
                                <th style="padding:12px 16px; text-align:left; font-weight:700; color:#fff;">Overall Grade</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model.Students)
                            {
                                <tr onclick="location.href='@Url.Action("CourseGradebook", "Teacher", new { id = Model.CourseId, selectedStudentId = student.StudentId })'"
                                    style="border-bottom:1px solid #e5e7eb; cursor:pointer; transition:background 0.2s;"
                                    onmouseover="this.style.background='#f3f4f6';"
                                    onmouseout="this.style.background='transparent';">
                                    <td style="padding:16px; color:#111827; font-weight:500; white-space:nowrap;">@student.StudentDisplayId</td>
                                    <td style="padding:16px; color:#111827; white-space:nowrap;">@student.Name</td>
                                    <td style="padding:16px; color:#059669; font-weight:600;">@student.AveragePercentage%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Right Column: Grades -->
            <div>
                <h3 style="margin:0 0 16px 0; font-weight:700; font-size:18px; color:#111827;">Grades</h3>

                <!-- Average Section -->
                @if (Model.SelectedStudentDetail != null)
                {
                    <div style="background:#f9fafb; border:1px solid #e5e7eb; border-radius:8px; padding:16px; margin-bottom:20px;">
                        <h4 style="margin:0 0 8px 0; font-weight:600; color:#374151; font-size:14px;">Average (Based on all graded activities)</h4>
                        <div style="font-size:24px; font-weight:800; color:#059669;">@Model.SelectedStudentDetail.Percentage%</div>
                        <div style="font-size:14px; color:#6b7280; margin-top:4px;">Grade: @Model.SelectedStudentDetail.Percentage</div>
                    </div>

                    <!-- Grades Table -->
                    <div style="border-radius:8px; overflow:hidden; border:1px solid #e5e7eb;">
                        <table style="width:100%; border-collapse:collapse;">
                            <thead style="background:#f9fafb;">
                                <tr>
                                    <th style="padding:12px 16px; text-align:left; font-weight:600; color:#374151; border-bottom:1px solid #e5e7eb;">Activity Name</th>
                                    <th style="padding:12px 16px; text-align:left; font-weight:600; color:#374151; border-bottom:1px solid #e5e7eb;">Raw Score</th>
                                    <th style="padding:12px 16px; text-align:left; font-weight:600; color:#374151; border-bottom:1px solid #e5e7eb;">Perfect Score</th>
                                    <th style="padding:12px 16px; text-align:left; font-weight:600; color:#374151; border-bottom:1px solid #e5e7eb;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var activity in Model.SelectedStudentDetail.Activities)
                                {
                                    var rowId = $"row-{activity.ActivityId}";
                                    var formId = $"form-{activity.ActivityId}";
                                    <tr id="@rowId" style="border-bottom:1px solid #f3f4f6;">
                                        <td style="padding:12px 16px; color:#111827; font-weight:500;">@activity.ActivityName</td>

                                        <td style="padding:12px 16px; color:#111827;">
                                            <span class="score-display">@activity.RawScore</span>
                                            <form id="@formId" method="post" asp-action="UpdateScore"
                                                  onsubmit="return validateAndSubmit('@rowId', @activity.MaxScore)"
                                                  style="display:none;" class="score-form">
                                                <input type="hidden" name="studentId" value="@Model.SelectedStudentDetail.StudentId" />
                                                <input type="hidden" name="activityId" value="@activity.ActivityId" />
                                                <input type="hidden" name="courseId" value="@Model.CourseId" />
                                                <input type="text" name="newScore" value="@activity.RawScore"
                                                       style="width:60px; padding:4px 6px; border:1px solid #d1d5db; border-radius:4px;"
                                                       class="score-input" />
                                            </form>
                                        </td>

                                        <td style="padding:12px 16px; color:#059669; font-weight:600;">@activity.MaxScore</td>

                                        <td style="padding:12px 16px;">
                                            <button type="button" class="edit-btn" onclick="enableEdit('@rowId')"
                                                    style="background:#3b82f6; color:#fff; border:none; padding:4px 10px; border-radius:4px;">
                                                Edit
                                            </button>
                                            <button type="submit" form="@formId"
                                                    class="save-btn" style="display:none; background:#059669; color:#fff; border:none; padding:4px 10px; border-radius:4px;">
                                                Save
                                            </button>
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>
                    </div>
                }
                else
                {
                    <div style="font-size:14px; color:#6b7280;">Select a student to view detailed grades.</div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <style>
        /* Table styling */
        #studentTable {
            border: none !important;
        }
        #studentTable thead th {
            border-bottom: 1px solid #f3f4f6 !important;
        }
        #studentTable tbody td {
            border-bottom: 1px solid #f3f4f6 !important;
        }
        /* Student ID column styling - prevent wrapping and ensure adequate width */
        #studentTable thead th:first-child,
        #studentTable tbody td:first-child {
            min-width: 180px !important;
            white-space: nowrap !important;
        }
        /* Name column styling - prevent wrapping and ensure adequate width */
        #studentTable thead th:nth-child(2),
        #studentTable tbody td:nth-child(2) {
            min-width: 200px !important;
            white-space: nowrap !important;
        }
    </style>
    <script>
        $(document).ready(function() {
            $('#studentTable').DataTable({
                "pageLength": 10,
                "lengthChange": false,
                "searching": false,
                "ordering": true,
                "info": true,
                "paging": true,
                "language": {
                    "paginate": {
                        "previous": "Prev",
                        "next": "Next"
                    }
                }
            });
        });

    </script>
    <script>
        function enableEdit(rowId) {
            const row = document.getElementById(rowId);
            const display = row.querySelector('.score-display');
            const form = row.querySelector('.score-form');
            const input = row.querySelector('.score-input');
            const editBtn = row.querySelector('.edit-btn');
            const saveBtn = row.querySelector('.save-btn');

            display.style.display = 'none';
            form.style.display = 'inline-block';
            saveBtn.style.display = 'inline-block';
            editBtn.style.display = 'none';

            input.style.border = '2px solid #3b82f6';
            input.style.backgroundColor = '#eff6ff';
        }

        function validateAndSubmit(rowId, maxScore) {
            const row = document.getElementById(rowId);
            const input = row.querySelector('.score-input');
            const value = parseFloat(input.value);

            if (isNaN(value) || value < 0 || value > maxScore) {
                alert(`Score must be between 0 and ${maxScore}`);
                input.focus();
                return false;
            }

            return true; // allow form to submit
        }
    </script>




}