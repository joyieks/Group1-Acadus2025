@model ASI.Basecode.Data.Models.CourseGradebookViewModel
@{
    Layout = "~/Views/Shared/_AuthenticatedLayout.cshtml";
    ViewData["Title"] = "Course Gradebook";
}

<script src="https://cdn.tailwindcss.com"></script>

<!-- Hero Section -->
<section class="hero-section bg-[#E8F9E8] flex items-center justify-center text-center relative py-10">
    <a href="/Teacher/FullCourseView/@Model.CourseId" class="absolute top-5 left-5 bg-white text-emerald-600 border border-gray-300 rounded-lg py-2 px-4 font-semibold no-underline transition-colors hover:bg-gray-50 flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5"></path>
            <path d="M12 19l-7-7 7-7"></path>
        </svg>
        Back to Course
    </a>
    <div class="max-w-[1200px] mx-auto px-4">
        <p class="m-0 mb-1 text-gray-600 text-xl">@Model.CourseCode</p>
        <h1 class="text-5xl font-extrabold m-0 mb-1 text-gray-900">Course Gradebook</h1>
        <p class="m-0 mb-4 text-gray-600 text-lg">@Model.SemesterInfo</p>
        <p class="m-0 text-gray-500 text-sm">View and manage student grades for this course.</p>
    </div>
</section>

<!-- White Section with Student Grades -->
<section class="bg-white py-10">
    <div class="max-w-[1200px] mx-auto px-4">
        <h2 class="m-0 mb-6 font-extrabold text-2xl text-gray-900">Student Grades</h2>

        <div class="grid gap-6" style="grid-template-columns: 3fr 5fr;">
            <!-- Left Column: Student List -->
            <div>
                <h3 class="m-0 mb-4 font-bold text-lg text-gray-900">Students</h3>
                <div class="rounded-lg overflow-hidden border border-gray-200">
                    <table id="studentTable" class="w-full border-collapse">
                        <thead class="bg-emerald-600">
                            <tr>
                                <th class="py-3 px-4 text-left font-bold text-white min-w-[180px] whitespace-nowrap">Student ID</th>
                                <th class="py-3 px-4 text-left font-bold text-white min-w-[200px] whitespace-nowrap">Name</th>
                                <th class="py-3 px-4 text-left font-bold text-white">Overall Grade</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model.Students)
                            {
                                <tr onclick="location.href='@Url.Action("CourseGradebook", "Teacher", new { id = Model.CourseId, selectedStudentId = student.StudentId })'"
                                    class="border-b border-gray-200 cursor-pointer transition-colors hover:bg-gray-100">
                                    <td class="py-4 px-4 text-gray-900 font-medium whitespace-nowrap">@student.StudentDisplayId</td>
                                    <td class="py-4 px-4 text-gray-900 whitespace-nowrap">@student.Name</td>
                                    <td class="py-4 px-4 text-emerald-600 font-semibold">@student.AveragePercentage%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Right Column: Grades -->
            <div>
                <h3 class="m-0 mb-4 font-bold text-lg text-gray-900">Grades</h3>

                <!-- Average Section -->
                @if (Model.SelectedStudentDetail != null)
                {
                    <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 mb-5">
                        <h4 class="m-0 mb-2 font-semibold text-gray-700 text-sm">Average (Based on all graded activities)</h4>
                        <div class="text-2xl font-extrabold text-emerald-600">@Model.SelectedStudentDetail.Percentage%</div>
                        <div class="text-sm text-gray-500 mt-1">Grade: @Model.SelectedStudentDetail.Percentage</div>
                    </div>

                    <!-- Grades Table -->
                    <div class="rounded-lg overflow-hidden border border-gray-200">
                        <table class="w-full border-collapse">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="py-3 px-4 text-left font-semibold text-gray-700 border-b border-gray-200">Activity Name</th>
                                    <th class="py-3 px-4 text-left font-semibold text-gray-700 border-b border-gray-200">Raw Score</th>
                                    <th class="py-3 px-4 text-left font-semibold text-gray-700 border-b border-gray-200">Perfect Score</th>
                                    <th class="py-3 px-4 text-left font-semibold text-gray-700 border-b border-gray-200">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var activity in Model.SelectedStudentDetail.Activities)
                                {
                                    var rowId = $"row-{activity.ActivityId}";
                                    var formId = $"form-{activity.ActivityId}";
                                    <tr id="@rowId" class="border-b border-gray-100">
                                        <td class="py-3 px-4 text-gray-900 font-medium">@activity.ActivityName</td>

                                        <td class="py-3 px-4 text-gray-900">
                                            <span class="score-display">@activity.RawScore</span>
                                            <form id="@formId" method="post" asp-action="UpdateScore"
                                                  onsubmit="return validateAndSubmit('@rowId', @activity.MaxScore)"
                                                  class="score-form hidden">
                                                <input type="hidden" name="studentId" value="@Model.SelectedStudentDetail.StudentId" />
                                                <input type="hidden" name="activityId" value="@activity.ActivityId" />
                                                <input type="hidden" name="courseId" value="@Model.CourseId" />
                                                <input type="text" name="newScore" value="@activity.RawScore"
                                                       class="score-input w-[60px] py-1 px-1.5 border border-gray-300 rounded" />
                                            </form>
                                        </td>

                                        <td class="py-3 px-4 text-emerald-600 font-semibold">@activity.MaxScore</td>

                                        <td class="py-3 px-4">
                                            <button type="button" class="edit-btn bg-blue-500 text-white border-none py-1 px-2.5 rounded" onclick="enableEdit('@rowId')">
                                                Edit
                                            </button>
                                            <button type="submit" form="@formId"
                                                    class="save-btn hidden bg-emerald-600 text-white border-none py-1 px-2.5 rounded">
                                                Save
                                            </button>
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>
                    </div>
                }
                else
                {
                    <div class="text-sm text-gray-500">Select a student to view detailed grades.</div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <style>
        /* Table styling */
        #studentTable {
            border: none !important;
        }
        #studentTable thead th {
            border-bottom: 1px solid #f3f4f6 !important;
        }
        #studentTable tbody td {
            border-bottom: 1px solid #f3f4f6 !important;
        }
        /* Student ID column styling - prevent wrapping and ensure adequate width */
        #studentTable thead th:first-child,
        #studentTable tbody td:first-child {
            min-width: 180px !important;
            white-space: nowrap !important;
        }
        /* Name column styling - prevent wrapping and ensure adequate width */
        #studentTable thead th:nth-child(2),
        #studentTable tbody td:nth-child(2) {
            min-width: 200px !important;
            white-space: nowrap !important;
        }
    </style>
    <script>
        $(document).ready(function() {
            $('#studentTable').DataTable({
                "pageLength": 10,
                "lengthChange": false,
                "searching": false,
                "ordering": true,
                "info": true,
                "paging": true,
                "language": {
                    "paginate": {
                        "previous": "Prev",
                        "next": "Next"
                    }
                }
            });
        });

    </script>
    <script>
        function enableEdit(rowId) {
            const row = document.getElementById(rowId);
            const display = row.querySelector('.score-display');
            const form = row.querySelector('.score-form');
            const input = row.querySelector('.score-input');
            const editBtn = row.querySelector('.edit-btn');
            const saveBtn = row.querySelector('.save-btn');

            display.style.display = 'none';
            form.style.display = 'inline-block';
            saveBtn.style.display = 'inline-block';
            editBtn.style.display = 'none';

            input.style.border = '2px solid #3b82f6';
            input.style.backgroundColor = '#eff6ff';
        }

        function validateAndSubmit(rowId, maxScore) {
            const row = document.getElementById(rowId);
            const input = row.querySelector('.score-input');
            const value = parseFloat(input.value);

            if (isNaN(value) || value < 0 || value > maxScore) {
                alert(`Score must be between 0 and ${maxScore}`);
                input.focus();
                return false;
            }

            return true; // allow form to submit
        }
    </script>



}