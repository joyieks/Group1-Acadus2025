@model ASI.Basecode.WebApp.Models.TeacherCourseViewModel
@{
    Layout = "~/Views/Shared/_AuthenticatedLayout.cshtml";
    ViewData["Title"] = "Full Course View";
}

<script src="https://cdn.tailwindcss.com"></script>

<style>
    @@keyframes bounce {
        0%, 20%, 50%, 80%, 100% {
            transform: translateY(0);
        }
        40% {
            transform: translateY(-10px);
        }
        60% {
            transform: translateY(-5px);
        }
    }
    .bounce-cta {
        animation: bounce 2s infinite;
    }
</style>

<!-- Hero Section -->
<section class="hero-section min-h-[80vh] bg-[#E8F9E8] flex items-center justify-center text-center relative">
    <a href="/Teacher/Courses" class="absolute top-5 left-5 bg-white text-emerald-600 border border-gray-300 rounded-lg py-2 px-4 font-semibold no-underline transition-colors hover:bg-gray-50 flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5"></path>
            <path d="M12 19l-7-7 7-7"></path>
        </svg>
        Back to Courses
    </a>
    <div class="container max-w-[1200px] mx-auto px-2">
        <p class="m-0 mb-1 text-gray-600 text-2xl">@Model.CourseCode</p>
        <h1 class="text-6xl font-extrabold m-0 mb-1 text-gray-900">@Model.CourseTitle</h1>
        <p class="m-0 mb-6 text-gray-600 text-2xl">@Model.SemesterInfo</p>
        <p class="m-0 mb-8 text-gray-500 text-base">Manage your course students, view top performers, and access quick actions.</p>
        <a href="#students-section" class="bounce-cta bg-emerald-100 text-emerald-800 border-none rounded-2xl py-3 px-8 font-semibold no-underline inline-block transition-colors">↓ Scroll down to see more ↓</a>
    </div>
</section>

<!-- White Section for Students -->
<section id="students-section" class="bg-white py-10">
    <div class="container max-w-[1200px] mx-auto px-4">
        <h2 class="m-0 mb-8 font-extrabold text-2xl text-gray-900">Student List</h2>
        
        <!-- Search bar, Filter, and Add Student button on same row -->
        <div class="flex justify-between items-center mb-6 gap-3">
            <div class="flex items-center gap-3">
                <input type="text" id="studentSearchInput" placeholder="Search for a student ID or name" class="w-[300px] py-2.5 px-4 border border-gray-300 rounded-lg text-sm bg-gray-100">
                <select id="statusFilter" class="py-2.5 px-4 border border-gray-300 rounded-lg text-sm bg-white cursor-pointer min-w-[150px]">
                    <option value="">All Status</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
                <button id="studentSearchBtn" class="bg-emerald-600 text-white border-none rounded-lg py-2.5 px-6 font-semibold cursor-pointer">Search</button>
            </div>
            <button id="addStudentBtn" class="bg-emerald-600 text-white border-none rounded-lg py-2.5 px-6 font-semibold cursor-pointer flex items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 5v14M5 12h14"></path>
                </svg>
                Add Student
            </button>
        </div>
        
        @await Component.InvokeAsync("StudentTable", new { courseId = Model.Id })
    </div>
</section>

@section Scripts {
    @Html.AntiForgeryToken()
    <style>
        /* Pagination button styles similar to RecentActivity */
        .dataTables_paginate .paginate_button {
            background: transparent !important;
            border: none !important;
            border-radius: 8px !important;
            padding: 10px !important;
            color: #374151 !important;
            cursor: pointer !important;
            transition: background-color 0.2s !important;
            margin: 0 2px !important;
        }
        .dataTables_paginate .paginate_button:hover {
            background: #F2F7F2 !important; /* Lighter, more grayish green */
        }
        .dataTables_paginate .paginate_button.current {
            background: #E0F0E0 !important; /* A step darker */
            font-weight: bold !important;
        }
        .dataTables_paginate .paginate_button.disabled {
            opacity: 0.5 !important;
            cursor: not-allowed !important;
        }
        /* Remove button hover effect */
        .remove-student-btn:hover {
            background: #b91c1c !important;
        }
    </style>
    <script>
        const courseId = @Model.Id;
        
        $(document).ready(function() {
            // Initialize DataTables only if the table exists and has correct structure
            var table = $('#studentTable');
            if (table.length && table.find('thead th').length === 5) {
                // Destroy existing DataTable instance if it exists
                if ($.fn.DataTable.isDataTable('#studentTable')) {
                    $('#studentTable').DataTable().destroy();
                }
                
            var dataTable = $('#studentTable').DataTable({
                "pageLength": 10,
                "lengthChange": false,
                "searching": false,
                "ordering": true,
                "info": true,
                "paging": true,
                    "autoWidth": false,
                    "columns": [
                        null, // ID Number
                        null, // Last Name
                        null, // First Name
                        null, // Status
                        { "orderable": false }  // Actions (not sortable)
                    ],
                "language": {
                    "paginate": {
                        "previous": "Prev",
                        "next": "Next"
                    }
                }
            });

            // Search and filter functionality
            var customSearchFunction = function(settings, data, dataIndex) {
                var searchTerm = $('#studentSearchInput').val().toLowerCase();
                var statusFilter = $('#statusFilter').val();

                // Get row data
                var idNumber = data[0].toLowerCase();
                var lastName = data[1].toLowerCase();
                var firstName = data[2].toLowerCase();
                var status = data[3].trim();

                // Apply search filter
                var matchesSearch = searchTerm === '' || 
                    idNumber.includes(searchTerm) || 
                    lastName.includes(searchTerm) || 
                    firstName.includes(searchTerm);

                // Apply status filter
                var matchesStatus = statusFilter === '' || status === statusFilter;

                return matchesSearch && matchesStatus;
            };

            // Add the custom search function
            $.fn.dataTable.ext.search.push(customSearchFunction);

            // Function to reapply filters
            function applyFilters() {
                dataTable.draw();
            }

            // Search input event
            $('#studentSearchInput').on('keyup', function() {
                applyFilters();
            });

            // Status filter change event
            $('#statusFilter').on('change', function() {
                applyFilters();
            });

            // Search button click event
            $('#studentSearchBtn').on('click', function() {
                applyFilters();
            });
            }

            // Add Student Modal
            $('#addStudentBtn').on('click', function() {
                loadAvailableStudents();
                $('#addStudentModal').css('display', 'flex');
            });

            $('.modal-close, .modal-backdrop').on('click', function() {
                $('#addStudentModal').css('display', 'none');
            });

            // Search in modal
            $('#modalStudentSearch').on('input', function() {
                const searchTerm = $(this).val().toLowerCase();
                $('#availableStudentsList tr').each(function() {
                    const idNumber = $(this).find('td:eq(0)').text().toLowerCase();
                    const firstName = $(this).find('td:eq(1)').text().toLowerCase();
                    const lastName = $(this).find('td:eq(2)').text().toLowerCase();
                    if (idNumber.includes(searchTerm) || firstName.includes(searchTerm) || lastName.includes(searchTerm)) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            });

            // Confirm enrollment
            $(document).on('click', '.enroll-student-btn', function() {
                const studentId = $(this).data('student-id');
                const idNumber = $(this).data('id-number');
                const firstName = $(this).data('first-name');
                const lastName = $(this).data('last-name');

                // Show custom confirmation modal
                showEnrollmentConfirmation(studentId, firstName, lastName, idNumber);
            });

            // Confirm enrollment from custom modal
            $(document).on('click', '#confirmEnrollBtn', function() {
                const studentId = $(this).data('student-id');
                $('#enrollmentConfirmModal').css('display', 'none');
                enrollStudent(studentId);
            });

            // Cancel enrollment from custom modal
            $(document).on('click', '#cancelEnrollBtn, .enrollment-modal-backdrop', function() {
                $('#enrollmentConfirmModal').css('display', 'none');
            });

            // Remove Student button click
            $(document).on('click', '.remove-student-btn', function() {
                const studentId = $(this).data('student-id');
                const idNumber = $(this).data('id-number');
                const firstName = $(this).data('first-name');
                const lastName = $(this).data('last-name');

                // Show custom removal confirmation modal
                showRemoveConfirmation(studentId, firstName, lastName, idNumber);
            });

            // Confirm removal from custom modal
            $(document).on('click', '#confirmRemoveBtn', function() {
                const studentId = $(this).data('student-id');
                $('#removeConfirmModal').css('display', 'none');
                removeStudent(studentId);
            });

            // Cancel removal from custom modal
            $(document).on('click', '#cancelRemoveBtn, .remove-modal-backdrop', function() {
                $('#removeConfirmModal').css('display', 'none');
            });
        });

        async function loadAvailableStudents() {
            try {
                $('#availableStudentsList').html('<tr><td colspan="4" class="text-center py-8 px-4 text-gray-500">Loading students...</td></tr>');
                
                const response = await fetch(`/Teacher/GetAvailableStudents?courseId=${courseId}`);
                const data = await response.json();

                // Log debug info
                if (data.debug) {
                    console.log('GetAvailableStudents Debug Info:', data.debug);
                }

                if (data.success && data.students && data.students.length > 0) {
                    let html = '';
                    data.students.forEach(student => {
                        html += `
                            <tr class="border-b border-gray-200">
                                <td class="py-3 px-4 text-gray-900">${student.idNumber}</td>
                                <td class="py-3 px-4 text-gray-900">${student.firstName}</td>
                                <td class="py-3 px-4 text-gray-900">${student.lastName}</td>
                                <td class="py-3 px-4">
                                    <button class="enroll-student-btn bg-emerald-600 text-white border-none rounded-md py-1.5 px-4 font-semibold cursor-pointer text-xs" 
                                            data-student-id="${student.studentId}"
                                            data-id-number="${student.idNumber}"
                                            data-first-name="${student.firstName}"
                                            data-last-name="${student.lastName}">
                                        Select
                                    </button>
                                </td>
                            </tr>
                        `;
                    });
                    $('#availableStudentsList').html(html);
                } else {
                    let message = 'No available students found.';
                    if (data.debug) {
                        if (data.debug.totalStudents === 0) {
                            message = 'No students found in database. Please create students first using the Admin panel.';
                        } else if (data.debug.enrolledCount > 0 && data.debug.availableCount === 0) {
                            message = `All ${data.debug.totalStudents} students are already enrolled in this course.`;
                        }
                    }
                    $('#availableStudentsList').html(`<tr><td colspan="4" class="text-center py-8 px-4 text-gray-500">${message}</td></tr>`);
                }
            } catch (error) {
                console.error('Error loading available students:', error);
                $('#availableStudentsList').html('<tr><td colspan="4" class="text-center py-8 px-4 text-red-600">Error loading students. Please check the console for details.</td></tr>');
            }
        }

        function showEnrollmentConfirmation(studentId, firstName, lastName, idNumber) {
            $('#enrollmentConfirmStudentName').text(`${firstName} ${lastName}`);
            $('#enrollmentConfirmStudentId').text(idNumber);
            $('#confirmEnrollBtn').data('student-id', studentId);
            $('#enrollmentConfirmModal').css('display', 'flex');
        }

        async function enrollStudent(studentId) {
            try {
                // Show loading state
                $('#confirmEnrollBtn').prop('disabled', true).text('Enrolling...');
                
                // Get anti-forgery token
                const token = $('input[name="__RequestVerificationToken"]').val() || '';
                
                const response = await fetch('/Teacher/EnrollStudent', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        courseId: courseId,
                        studentId: studentId
                    })
                });

                const data = await response.json();

                if (data.success) {
                    // Show success message
                    showSuccessMessage('Student enrolled successfully!');
                    $('#enrollmentConfirmModal').css('display', 'none');
                    $('#addStudentModal').css('display', 'none');
                    // Small delay before reload to ensure modal is closed
                    setTimeout(function() {
                        location.reload();
                    }, 100);
                } else {
                    showErrorMessage(data.message || 'Failed to enroll student');
                    $('#confirmEnrollBtn').prop('disabled', false).text('Confirm');
                }
            } catch (error) {
                console.error('Error enrolling student:', error);
                showErrorMessage('Error enrolling student. Please try again.');
                $('#confirmEnrollBtn').prop('disabled', false).text('Confirm');
            }
        }

        function showSuccessMessage(message) {
            const messageDiv = $('<div>')
                .css({
                    'position': 'fixed',
                    'top': '20px',
                    'right': '20px',
                    'background': '#059669',
                    'color': '#fff',
                    'padding': '16px 24px',
                    'border-radius': '8px',
                    'box-shadow': '0 4px 6px rgba(0,0,0,0.1)',
                    'z-index': '10000',
                    'font-weight': '600',
                    'min-width': '300px'
                })
                .text(message);
            $('body').append(messageDiv);
            setTimeout(function() {
                messageDiv.fadeOut(300, function() {
                    $(this).remove();
                });
            }, 3000);
        }

        function showErrorMessage(message) {
            const messageDiv = $('<div>')
                .css({
                    'position': 'fixed',
                    'top': '20px',
                    'right': '20px',
                    'background': '#dc2626',
                    'color': '#fff',
                    'padding': '16px 24px',
                    'border-radius': '8px',
                    'box-shadow': '0 4px 6px rgba(0,0,0,0.1)',
                    'z-index': '10000',
                    'font-weight': '600',
                    'min-width': '300px'
                })
                .text(message);
            $('body').append(messageDiv);
            setTimeout(function() {
                messageDiv.fadeOut(300, function() {
                    $(this).remove();
                });
            }, 4000);
        }

        function showRemoveConfirmation(studentId, firstName, lastName, idNumber) {
            $('#removeConfirmStudentName').text(`${firstName} ${lastName}`);
            $('#removeConfirmStudentId').text(idNumber);
            $('#confirmRemoveBtn').data('student-id', studentId);
            $('#removeConfirmModal').css('display', 'flex');
        }

        async function removeStudent(studentId) {
            try {
                // Show loading state
                $('#confirmRemoveBtn').prop('disabled', true).text('Removing...');
                
                // Get anti-forgery token
                const token = $('input[name="__RequestVerificationToken"]').val() || '';
                
                const response = await fetch(`/Teacher/DropStudent?courseId=${courseId}&studentId=${encodeURIComponent(studentId)}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    }
                });

                const data = await response.json();

                if (data.success) {
                    // Show success message
                    showSuccessMessage('Student removed successfully!');
                    $('#removeConfirmModal').css('display', 'none');
                    // Small delay before reload to ensure modal is closed
                    setTimeout(function() {
                        location.reload();
                    }, 100);
                } else {
                    showErrorMessage(data.message || 'Failed to remove student');
                    $('#confirmRemoveBtn').prop('disabled', false).text('Confirm');
                }
            } catch (error) {
                console.error('Error removing student:', error);
                showErrorMessage('Error removing student. Please try again.');
                $('#confirmRemoveBtn').prop('disabled', false).text('Confirm');
            }
        }
    </script>
}

<!-- Add Student Modal -->
<div id="addStudentModal" class="hidden fixed top-0 left-0 w-full h-full bg-black/50 z-[1000] items-center justify-center">
    <div class="modal-backdrop absolute top-0 left-0 w-full h-full"></div>
    <div class="bg-white rounded-2xl p-8 max-w-[800px] w-[90%] max-h-[90vh] overflow-y-auto relative z-[1001] shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1)]">
        <div class="flex justify-between items-center mb-6">
            <h2 class="m-0 font-extrabold text-2xl text-gray-900">Add Student to Course</h2>
            <button class="modal-close bg-transparent border-none text-2xl text-gray-500 cursor-pointer p-0 w-8 h-8 flex items-center justify-center">&times;</button>
        </div>
        
        <div class="mb-6">
            <input type="text" id="modalStudentSearch" placeholder="Search by ID Number, First Name, or Last Name" class="w-full py-3 px-4 border border-gray-300 rounded-lg text-sm">
        </div>

        <div class="border border-gray-200 rounded-lg overflow-hidden">
            <table class="w-full border-collapse">
                <thead>
                    <tr class="bg-emerald-600">
                        <th class="py-3 px-4 text-left font-bold text-white">ID Number</th>
                        <th class="py-3 px-4 text-left font-bold text-white">First Name</th>
                        <th class="py-3 px-4 text-left font-bold text-white">Last Name</th>
                        <th class="py-3 px-4 text-left font-bold text-white">Action</th>
                    </tr>
                </thead>
                <tbody id="availableStudentsList">
                    <tr>
                        <td colspan="4" class="text-center py-8 px-4 text-gray-500">Loading students...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Enrollment Confirmation Modal -->
<div id="enrollmentConfirmModal" class="hidden fixed top-0 left-0 w-full h-full bg-black/50 z-[2000] items-center justify-center">
    <div class="enrollment-modal-backdrop absolute top-0 left-0 w-full h-full"></div>
    <div class="bg-white rounded-2xl p-8 max-w-[500px] w-[90%] relative z-[2001] shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1)]">
        <div class="text-center mb-6">
            <div class="w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
            </div>
            <h2 class="m-0 mb-3 font-extrabold text-2xl text-gray-900">Confirm Enrollment</h2>
            <p class="m-0 text-gray-500 text-base leading-relaxed">
                Are you sure you want to enroll<br>
                <strong class="text-gray-900" id="enrollmentConfirmStudentName"></strong><br>
                <span class="text-emerald-600 text-sm" id="enrollmentConfirmStudentId"></span><br>
                in this course?
            </p>
        </div>
        <div class="flex gap-3 justify-end">
            <button id="cancelEnrollBtn" class="bg-gray-100 text-gray-700 border-none rounded-lg py-3 px-6 font-semibold cursor-pointer text-sm">
                Cancel
            </button>
            <button id="confirmEnrollBtn" class="bg-emerald-600 text-white border-none rounded-lg py-3 px-6 font-semibold cursor-pointer text-sm">
                Confirm
            </button>
        </div>
    </div>
</div>

<!-- Remove Student Confirmation Modal -->
<div id="removeConfirmModal" class="hidden fixed top-0 left-0 w-full h-full bg-black/50 z-[2000] items-center justify-center">
    <div class="remove-modal-backdrop absolute top-0 left-0 w-full h-full"></div>
    <div class="bg-white rounded-2xl p-8 max-w-[500px] w-[90%] relative z-[2001] shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1)]">
        <div class="text-center mb-6">
            <div class="w-16 h-16 bg-red-50 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 6L6 18M6 6l12 12"></path>
                </svg>
            </div>
            <h2 class="m-0 mb-3 font-extrabold text-2xl text-gray-900">Confirm Removal</h2>
            <p class="m-0 text-gray-500 text-base leading-relaxed">
                Are you sure you want to remove<br>
                <strong class="text-gray-900" id="removeConfirmStudentName"></strong><br>
                <span class="text-red-600 text-sm" id="removeConfirmStudentId"></span><br>
                from this course?
            </p>
        </div>
        <div class="flex gap-3 justify-end">
            <button id="cancelRemoveBtn" class="bg-gray-100 text-gray-700 border-none rounded-lg py-3 px-6 font-semibold cursor-pointer text-sm">
                Cancel
            </button>
            <button id="confirmRemoveBtn" class="bg-red-600 text-white border-none rounded-lg py-3 px-6 font-semibold cursor-pointer text-sm">
                Confirm
            </button>
        </div>
    </div>
</div>

<!-- Green Section with Top Students and Quick Actions -->
<section class="bg-[#E8F9E8] py-10">
    <div class="container max-w-[1200px] mx-auto px-4">
        <div class="grid grid-cols-2 gap-6">
            <div>
                @await Component.InvokeAsync("TopStudents", new { courseId = Model.Id })
            </div>
            <div>
                @await Component.InvokeAsync("QuickActions", Model.Id)
            </div>
        </div>
    </div>
</section>
