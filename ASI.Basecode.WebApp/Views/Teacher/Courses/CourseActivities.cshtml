@model ASI.Basecode.Service.ServiceModels.TeacherCourseModel
@{
    Layout = "~/Views/Shared/_AuthenticatedLayout.cshtml";
    ViewData["Title"] = "Course Activities";
    var selectedActivity = ViewBag.SelectedActivity as dynamic;
    var students = ViewBag.Students as IEnumerable<dynamic>;

    // compute a safe bool for visibility so dynamic->bool conversion is evaluated once
    bool isVisible = false;
    if (selectedActivity != null)
    {
        // handle bool or nullable bool safely
        try { isVisible = (bool?)(selectedActivity.IsVisible) ?? false; } catch { isVisible = false; }
    }
}

<!-- Hero Section -->
<section class="bg-emerald-50 flex items-center justify-center text-center relative py-10">
    <a href="/Teacher/FullCourseView/@Model.Id" class="absolute top-5 left-5 bg-white text-emerald-600 border border-gray-300 rounded-lg px-4 py-2 font-semibold no-underline transition-colors hover:bg-gray-50 flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5"></path>
            <path d="M12 19l-7-7 7-7"></path>
        </svg>
        Back to Course
    </a>
    <div class="max-w-7xl mx-auto px-4">
        <p class="m-0 mb-1 text-gray-600 text-xl">@Model.CourseCode</p>
        <h1 class="text-5xl font-extrabold m-0 mb-1 text-gray-900">Course Activities</h1>
        <p class="m-0 mb-4 text-gray-600 text-lg">@Model.SemesterInfo</p>
        <p class="m-0 text-gray-500 text-sm">Manage and organize course activities and assignments.</p>
    </div>
</section>

<!-- White Section with Activities Management -->
<section class="bg-white py-10">
    <div class="max-w-7xl mx-auto px-4">
        <h2 class="m-0 mb-6 font-extrabold text-2xl text-gray-900">Activities Management</h2>

        <div class="grid grid-cols-1 lg:grid-cols-8 gap-6">
            <!-- Left Column: Activities List -->
            <div class="lg:col-span-3">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="m-0 font-bold text-lg text-gray-900">Activities</h3>
                    <button onclick="openAddActivityModal()" class="bg-emerald-600 text-white border-0 rounded-lg px-4 py-2 font-semibold cursor-pointer flex items-center gap-2">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 5v14"></path>
                            <path d="M5 12h14"></path>
                        </svg>
                        Activity
                    </button>
                </div>

                @if (Model.Activities == null || !Model.Activities.Any())
                {
                    <div class="rounded-lg border border-gray-200 bg-gray-50 p-8 text-center">
                        <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        <h3 class="text-lg font-medium text-gray-900 mb-2">No activities yet</h3>
                        <p class="text-sm text-gray-500 mb-4">Get started by creating your first activity for this course.</p>
                    </div>
                }
                else
                {
                    <div class="rounded-lg overflow-hidden border border-gray-200">
                        <table class="w-full border-collapse">
                            <thead class="bg-emerald-600">
                                <tr>
                                    <th class="px-4 py-3 text-left font-bold text-white">Activity</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var activity in Model.Activities)
                                {
                                    var isSelected = selectedActivity != null && selectedActivity.Id == activity.Id;
                                    <tr class="border-b border-gray-200 cursor-pointer hover:bg-gray-50 @(isSelected ? "selected-activity" : "")">
                                        <td class="px-4 py-4 text-gray-900 font-medium">
                                            <a href="@Url.Action("CourseActivities", new { id = Model.CourseId, activityId = activity.Id })"
                                               class="block no-underline text-gray-900">
                                                @activity.Title
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Right Column: Activity Details -->
            <div class="lg:col-span-5">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="m-0 font-bold text-lg text-gray-900">Activity Details</h3>
                    @if (selectedActivity != null)
                    {
                        <button id="editButton" onclick="toggleEditMode()" class="bg-emerald-600 text-white border-0 rounded-lg px-4 py-2 font-semibold cursor-pointer hover:bg-emerald-700">Edit</button>
                    }
                </div>

                @if (selectedActivity == null)
                {
                    <div class="bg-gray-50 border border-gray-200 rounded-lg p-12 text-center">
                        <svg class="mx-auto h-16 w-16 text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" />
                        </svg>
                        <h3 class="text-lg font-medium text-gray-900 mb-2">Select an activity</h3>
                        <p class="text-sm text-gray-500">Choose an activity from the list to view and edit its details.</p>
                    </div>
                }
                else
                {
                    <form method="post" action="@Url.Action("UpdateActivity", new { id = Model.CourseId, activityId = selectedActivity.Id })">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="CourseId" value="@Model.CourseId" />
                        <div class="bg-gray-50 border border-gray-200 rounded-lg p-6">
                            <div class="mb-5">
                                <label class="block font-semibold text-gray-700 mb-2">Name</label>
                                <div id="nameDisplay" class="text-gray-900 text-base">@selectedActivity.Title</div>
                                <input id="nameInput" name="Title" type="text" value="@selectedActivity.Title" class="hidden w-full px-3 py-2 border border-gray-300 rounded-md text-base" required>
                            </div>

                            <div class="mb-5">
                                <label class="block font-semibold text-gray-700 mb-2">Description</label>
                                <div id="descriptionDisplay" class="text-gray-900 text-sm leading-relaxed">@(selectedActivity.Description ?? "No description provided")</div>
                                <textarea id="descriptionInput" name="Description" rows="4" class="hidden w-full px-3 py-2 border border-gray-300 rounded-md text-sm leading-relaxed">@selectedActivity.Description</textarea>
                            </div>

                            <div class="mb-5">
                                <label class="block font-semibold text-gray-700 mb-2">Due Date</label>
                                <div id="dueDateDisplay" class="text-gray-900 text-base">
                                    @if (selectedActivity.DueDate != null)
                                    {
                                        @($"{selectedActivity.DueDate:MMMM dd, yyyy - hh:mm tt}")
                                    }
                                    else
                                    {
                                        <span class="text-gray-500">No due date set</span>
                                    }
                                </div>
                                <input id="dueDateInput" name="DueDate" type="datetime-local" value="@(selectedActivity.DueDate?.ToString("yyyy-MM-ddTHH:mm"))" class="hidden w-full px-3 py-2 border border-gray-300 rounded-md text-base">
                            </div>

                            <div class="mb-5">
                                <label class="block font-semibold text-gray-700 mb-2">Maximum Score</label>
                                <div id="maxScoreDisplay" class="text-gray-900 text-base">@selectedActivity.MaxScore points</div>
                                <input id="maxScoreInput" name="MaxScore" type="number" value="@selectedActivity.MaxScore" min="0" class="hidden w-full px-3 py-2 border border-gray-300 rounded-md text-base" required>
                            </div>

                            <div class="flex justify-between items-center">
                                <div>
                                    <label class="block font-semibold text-gray-700 mb-2">Visibility</label>
                                    <div id="visibilityDisplay" class="flex items-center gap-3">
                                        <label class="flex items-center gap-2 cursor-default">
                                            <input type="radio" name="view_IsVisible" value="true" @(isVisible ? "checked" : null) disabled class="m-0">
                                            <span class="text-gray-900 text-sm">Visible to students</span>
                                        </label>
                                        <label class="flex items-center gap-2 cursor-default">
                                            <input type="radio" name="view_IsVisible" value="false" @(!isVisible ? "checked" : null) disabled class="m-0">
                                            <span class="text-gray-900 text-sm">Hidden from students</span>
                                        </label>
                                    </div>
                                    <div id="visibilityEdit" class="hidden items-center gap-3">
                                        <label class="flex items-center gap-2 cursor-pointer">
                                            <input type="radio" name="IsVisible" value="true" @(isVisible ? "checked" : null) class="m-0">
                                            <span class="text-gray-900 text-sm">Visible to students</span>
                                        </label>
                                        <label class="flex items-center gap-2 cursor-pointer">
                                            <input type="radio" name="IsVisible" value="false" @(!isVisible ? "checked" : null) class="m-0">
                                            <span class="text-gray-900 text-sm">Hidden from students</span>
                                        </label>
                                    </div>
                                </div>
                                <div id="editActions" class="hidden">
                                    <button type="submit" class="bg-emerald-600 text-white border-0 rounded-md px-4 py-2 font-semibold cursor-pointer mr-2 hover:bg-emerald-700">Save</button>
                                    <button type="button" onclick="cancelEdit()" class="bg-gray-500 text-white border-0 rounded-md px-4 py-2 font-semibold cursor-pointer hover:bg-gray-600">Cancel</button>
                                </div>
                            </div>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</section>

@* Student Activity Performance section *@
<section class="bg-white py-10">
    <div class="max-w-7xl mx-auto px-4">
        <h2 class="m-0 mb-6 font-extrabold text-2xl text-gray-900">Student Activity Performance</h2>

        @if (selectedActivity == null)
{
            <div class="rounded-lg border border-gray-200 bg-gray-50 p-8 text-center">
                <h3 class="text-lg font-medium text-gray-900 mb-2">Select an activity</h3>
                <p class="text-sm text-gray-500">Choose an activity first to view students and their submissions.</p>
            </div>
        }
        else if (students == null || !students.Any())
        {
            <div class="rounded-lg border border-gray-200 bg-gray-50 p-8 text-center">
                <h3 class="text-lg font-medium text-gray-900 mb-2">No students enrolled</h3>
                <p class="text-sm text-gray-500">There are no students enrolled in this course yet.</p>
            </div>
        }
        else
        {
            <div class="rounded-lg overflow-hidden border border-gray-200">
                <table class="w-full border-collapse">
                    <thead class="bg-emerald-600">
                        <tr>
                            <th class="px-4 py-3 text-left font-bold text-white">First Name</th>
                            <th class="px-4 py-3 text-left font-bold text-white">Last Name</th>
                            <th class="px-4 py-3 text-left font-bold text-white">Grade</th>
                            <th class="px-4 py-3 text-left font-bold text-white">Status</th>
                            <th class="px-4 py-3 text-left font-bold text-white">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in students)
                        {
                            var rowClass = students.ToList().IndexOf(student) % 2 == 0 ? "" : "bg-gray-50";
                            <tr class="@rowClass border-b border-gray-200">
                                <td class="px-4 py-4 text-gray-900 font-medium">@student.FirstName</td>
                                <td class="px-4 py-4 text-gray-900 font-medium">@student.LastName</td>
                                <td class="px-4 py-4">
                                    @if (student.Grade != null)
                                    {
                                        var percentage = Math.Round((double)student.Grade / selectedActivity.MaxScore * 100);
                                        <span>@student.Grade/@selectedActivity.MaxScore (@percentage%)</span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-500">Not graded</span>
                                    }
                                </td>
                                <td class="px-4 py-4">
                                    @if (student.Status == "Submitted")
                                    {
                                        <span class="bg-emerald-100 text-emerald-800 px-2 py-1 rounded text-xs font-semibold">Submitted</span>
                                    }
                                    else if (student.Status == "Late")
                                    {
                                        <span class="bg-orange-200 text-orange-800 px-2 py-1 rounded text-xs font-semibold">Late</span>
                                    }
                                    else if (student.Status == "Graded")
                                    {
                                        <span class="bg-emerald-100 text-emerald-800 px-2 py-1 rounded text-xs font-semibold">Graded</span>
                                    }
                                    else
                                    {
                                        <span class="bg-gray-200 text-gray-700 px-2 py-1 rounded text-xs font-semibold">@student.Status</span>
                                    }
                                </td>
                                <td class="px-4 py-4">
                                    @if (selectedActivity != null)
                                    {
                                        <button type="button"
                                                class="bg-emerald-600 text-white border-0 rounded-md px-3 py-1.5 font-semibold cursor-pointer hover:bg-emerald-700"
                                                onclick="openGradeModal(this)"
                                                data-student-id="@student.Id"
                                                data-student-name="@($"{student.FirstName} {student.LastName}")"
                                                data-activity-id="@selectedActivity.Id"
                                                data-activity-name="@selectedActivity.Title"
                                                data-max-score="@selectedActivity.MaxScore">
                                            Grade Activity
                                        </button>

                                    }
                                    else
                                    {
                                        <button disabled class="bg-gray-300 text-gray-700 rounded-md px-3 py-1.5 font-semibold cursor-not-allowed">Select activity</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>


<!-- Grade Activity Modal -->
<div id="gradeActivityModal" class="grade-modal hidden fixed inset-0 bg-black bg-opacity-50 backdrop-blur-sm z-50 items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-white rounded-2xl w-11/12 max-w-lg max-h-screen overflow-hidden shadow-2xl transform scale-90 transition-transform duration-300">
        <form id="gradeForm" method="post" action="@Url.Action("GradeActivity", new { id = Model.Id })">
            @Html.AntiForgeryToken()
            <input type="hidden" name="StudentId" id="modalStudentId">
            <input type="hidden" name="ActivityId" id="modalActivityId">

            <div class="flex justify-between items-center px-8 pt-6 pb-4 border-b border-gray-200">
                <h3 id="modalActivityTitle" class="m-0 text-xl font-bold text-gray-900">Grade Activity</h3>
                <button type="button" onclick="closeGradeModal()" class="bg-transparent border-0 text-2xl text-gray-500 cursor-pointer p-0 w-8 h-8 flex items-center justify-center rounded-md hover:bg-gray-100">&times;</button>
            </div>
            <div class="px-8 py-6">
                <div class="mb-5">
                    <strong id="studentNameDisplay">Student Name</strong> - <strong id="activityNameDisplay">Activity Name</strong>
                </div>
                <div class="mb-5">
                    <label class="block font-semibold text-gray-700 mb-2">Grade</label>
                    <input type="number" name="Grade" id="gradeValue" min="0" step="0.01" class="w-full px-3 py-2 border border-gray-300 rounded-md text-base" required>
                    <p class="text-xs text-gray-500 mt-1">Maximum score: <span id="modalMaxScore"></span> points</p>
                </div>
                <div class="mb-5">
                    <label class="block font-semibold text-gray-700 mb-2">Feedback</label>
                    <textarea name="Feedback" id="feedbackInput" rows="4" placeholder="Provide feedback for the student's work..." class="w-full px-3 py-3 border border-gray-300 rounded-lg text-sm leading-relaxed resize-y"></textarea>
                </div>
                <div class="flex gap-3 justify-end mt-6">
                    <button type="button" onclick="closeGradeModal()" class="px-6 py-2.5 rounded-lg text-sm font-semibold cursor-pointer bg-white text-gray-500 border border-gray-300 hover:bg-gray-50">Cancel</button>
                    <button type="submit" class="px-6 py-2.5 rounded-lg text-sm font-semibold cursor-pointer bg-emerald-600 text-white border-0 hover:bg-emerald-700">Submit Grade</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Add Activity Modal -->
<div id="addActivityModal" class="add-activity-modal hidden fixed inset-0 bg-black bg-opacity-50 backdrop-blur-sm z-50 items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-white rounded-2xl w-11/12 max-w-2xl max-h-screen overflow-hidden shadow-2xl transform scale-90 transition-transform duration-300">
        <form method="post" action="@Url.Action("CreateActivity", new { id = Model.CourseId })">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.CourseId" />

            <div class="flex justify-between items-center px-8 pt-6 pb-4 border-b border-gray-200">
                <h3 class="m-0 text-xl font-bold text-gray-900">Add New Activity</h3>
                <button type="button" onclick="closeAddActivityModal()" class="bg-transparent border-0 text-2xl text-gray-500 cursor-pointer p-0 w-8 h-8 flex items-center justify-center rounded hover:bg-gray-100">&times;</button>
            </div>
            <div class="px-8 py-6 max-h-[calc(90vh-120px)] overflow-y-auto">
                <div class="mb-5">
                    <label class="block font-semibold text-gray-700 mb-2">Name *</label>
                    <input name="Title" type="text" placeholder="Enter activity name" class="w-full px-3 py-2 border border-gray-300 rounded-md text-base" required>
                </div>

                <div class="mb-5">
                    <label class="block font-semibold text-gray-700 mb-2">Description</label>
                    <textarea name="Description" rows="4" placeholder="Enter activity description" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm leading-relaxed"></textarea>
                </div>

                <div class="mb-5">
                    <label class="block font-semibold text-gray-700 mb-2">Due Date</label>
                    <input name="DueDate" type="datetime-local" class="w-full px-3 py-2 border border-gray-300 rounded-md text-base">
                </div>

                <div class="mb-5">
                    <label class="block font-semibold text-gray-700 mb-2">Maximum Score *</label>
                    <input name="MaxScore" type="number" min="0" placeholder="Enter maximum score" class="w-full px-3 py-2 border border-gray-300 rounded-md text-base" required>
                </div>

                <div class="mb-6">
                    <label class="block font-semibold text-gray-700 mb-2">Visibility</label>
                    <div class="flex items-center gap-3">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="IsVisible" value="true" checked class="m-0">
                            <span class="text-gray-900 text-sm">Visible to students</span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="IsVisible" value="false" class="m-0">
                            <span class="text-gray-900 text-sm">Hidden from students</span>
                        </label>
                    </div>
                </div>

                <div class="flex justify-end gap-3 pt-4 border-t border-gray-200">
                    <button type="button" onclick="closeAddActivityModal()" class="bg-gray-500 text-white border-0 rounded-md px-5 py-2.5 font-semibold cursor-pointer hover:bg-gray-600">Cancel</button>
                    <button type="submit" class="bg-emerald-600 text-white border-0 rounded-md px-5 py-2.5 font-semibold cursor-pointer hover:bg-emerald-700">Add Activity</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <style>
        .grade-modal.show,
        .add-activity-modal.show {
            display: flex !important;
            opacity: 1 !important;
        }

            .grade-modal.show > div,
            .add-activity-modal.show > div {
                transform: scale(1) !important;
            }

        .selected-activity {
            background-color: #e0f2fe !important;
            border-left: 4px solid #059669 !important;
        }
    </style>
    <script>
        let isEditMode = false;

        function toggleEditMode() {
            isEditMode = !isEditMode;
            const editButton = document.getElementById('editButton');
            const editActions = document.getElementById('editActions');

            if (isEditMode) {
                editButton.textContent = 'Cancel';
                editButton.className = 'bg-gray-500 text-white border-0 rounded-lg px-4 py-2 font-semibold cursor-pointer hover:bg-gray-600';
                editButton.type = 'button';
                editActions.classList.remove('hidden');

                document.getElementById('nameDisplay').classList.add('hidden');
                document.getElementById('nameInput').classList.remove('hidden');
                document.getElementById('nameInput').removeAttribute('disabled');

                document.getElementById('descriptionDisplay').classList.add('hidden');
                document.getElementById('descriptionInput').classList.remove('hidden');
                document.getElementById('descriptionInput').removeAttribute('disabled');

                document.getElementById('dueDateDisplay').classList.add('hidden');
                document.getElementById('dueDateInput').classList.remove('hidden');
                document.getElementById('dueDateInput').removeAttribute('disabled');

                document.getElementById('maxScoreDisplay').classList.add('hidden');
                document.getElementById('maxScoreInput').classList.remove('hidden');
                document.getElementById('maxScoreInput').removeAttribute('disabled');

                document.getElementById('visibilityDisplay').classList.add('hidden');
                document.getElementById('visibilityEdit').classList.remove('hidden');
                document.getElementById('visibilityEdit').classList.add('flex');
                document.querySelectorAll('#visibilityEdit input').forEach(input => input.removeAttribute('disabled'));
            } else {
                cancelEdit();
            }
        }

        function cancelEdit() {
            isEditMode = false;
            const editButton = document.getElementById('editButton');
            const editActions = document.getElementById('editActions');

            editButton.textContent = 'Edit';
            editButton.className = 'bg-emerald-600 text-white border-0 rounded-lg px-4 py-2 font-semibold cursor-pointer hover:bg-emerald-700';
            editActions.classList.add('hidden');

            document.getElementById('nameDisplay').classList.remove('hidden');
            document.getElementById('nameInput').classList.add('hidden');

            document.getElementById('descriptionDisplay').classList.remove('hidden');
            document.getElementById('descriptionInput').classList.add('hidden');

            document.getElementById('dueDateDisplay').classList.remove('hidden');
            document.getElementById('dueDateInput').classList.add('hidden');

            document.getElementById('maxScoreDisplay').classList.remove('hidden');
            document.getElementById('maxScoreInput').classList.add('hidden');

            document.getElementById('visibilityDisplay').classList.remove('hidden');
            document.getElementById('visibilityEdit').classList.add('hidden');
        }

        function openGradeModal(btn) {
            const studentId = btn.dataset.studentId;
            const studentName = btn.dataset.studentName;
            const activityName = btn.dataset.activityName;
            const activityId = btn.dataset.activityId;
            const maxScore = btn.dataset.maxScore;
            console.log("DEBUG modal args:", studentId, studentName, activityName, activityId);


            document.getElementById('modalStudentId').value = studentId;
            document.getElementById('modalActivityId').value = activityId;

            document.getElementById('studentNameDisplay').textContent = studentName;
            document.getElementById('activityNameDisplay').textContent = activityName;
            document.getElementById('modalActivityTitle').textContent = "Grade: " + activityName;

            document.getElementById('gradeValue').value = "";
            document.getElementById('modalMaxScore').textContent = maxScore;
            document.getElementById('feedbackInput').value = "";

            const modal = document.getElementById('gradeActivityModal');
            modal.classList.remove('hidden');


            setTimeout(() => modal.classList.add('show'), 10);
        }

        function closeGradeModal() {
            const modal = document.getElementById('gradeActivityModal');
            modal.classList.remove('show');
            setTimeout(() => modal.classList.add('hidden'), 300);
        }

        function openAddActivityModal() {
            const modal = document.getElementById('addActivityModal');
            modal.classList.remove('hidden');
            setTimeout(() => modal.classList.add('show'), 10);
        }

        function closeAddActivityModal() {
            const modal = document.getElementById('addActivityModal');
            modal.classList.remove('show');
            setTimeout(() => modal.classList.add('hidden'), 300);
        }

        // safe event listener attachments
        const gradeModalEl = document.getElementById('gradeActivityModal');
        if (gradeModalEl) {
            gradeModalEl.addEventListener('click', function(e) {
                if (e.target === this) {
                    closeGradeModal();
                }
            });
        }

        const addModalEl = document.getElementById('addActivityModal');
        if (addModalEl) {
            addModalEl.addEventListener('click', function(e) {
                if (e.target === this) {
                    closeAddActivityModal();
                }
            });
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeGradeModal();
                closeAddActivityModal();
            }
        });
    </script>
}