        }

        .add-activity-modal-body {
            padding: 24px 32px;
            max-height: calc(90vh - 120px);
            overflow-y: auto;
        }
    </style>
    <script>
        $(document).ready(function() {
            $('#activitiesTable').DataTable({
                "pageLength": 10,
                "lengthChange": false,
                "searching": false,
                "ordering": true,
                "info": true,
                "paging": true,
                "language": {
                    "paginate": {
                        "previous": "Prev",
                        "next": "Next"
                    }
                }
            });

            $('#performanceTable').DataTable({
                "pageLength": 10,
                "lengthChange": false,
                "searching": true,
                "ordering": true,
                "info": true,
                "paging": true,
                "language": {
                    "paginate": {
                        "previous": "Prev",
                        "next": "Next"
                    }
                }
            });
        });

        function selectActivity(activityName) {
            // Remove selected class from all rows
            $('#activitiesTable tbody tr').removeClass('selected-activity');

            // Add selected class to clicked row
            event.currentTarget.classList.add('selected-activity');

            // Here you would typically update the right panel with the selected activity details
            console.log('Selected activity:', activityName);
        }

        let isEditMode = false;

        function toggleEditMode() {
            isEditMode = !isEditMode;
            const editButton = document.getElementById('editButton');
            const editActions = document.getElementById('editActions');

            if (isEditMode) {
                // Switch to edit mode
                editButton.textContent = 'Cancel';
                editButton.style.background = '#6b7280';
                editActions.style.display = 'block';

                // Show input fields, hide display fields
                document.getElementById('nameDisplay').style.display = 'none';
                document.getElementById('nameInput').style.display = 'block';

                document.getElementById('descriptionDisplay').style.display = 'none';
                document.getElementById('descriptionInput').style.display = 'block';

                document.getElementById('dueDateDisplay').style.display = 'none';
                document.getElementById('dueDateInput').style.display = 'block';

                document.getElementById('maxScoreDisplay').style.display = 'none';
                document.getElementById('maxScoreInput').style.display = 'block';

                document.getElementById('visibilityDisplay').style.display = 'none';
                document.getElementById('visibilityEdit').style.display = 'flex';
            } else {
                // Switch back to view mode
                cancelEdit();
            }
        }

        function saveChanges() {
            // Get values from input fields
            const name = document.getElementById('nameInput').value;
            const description = document.getElementById('descriptionInput').value;
            const dueDate = new Date(document.getElementById('dueDateInput').value);
            const maxScore = document.getElementById('maxScoreInput').value;
            const visibility = document.querySelector('input[name="visibilityEdit"]:checked').value;

            // Update display fields
            document.getElementById('nameDisplay').textContent = name;
            document.getElementById('descriptionDisplay').textContent = description;
            document.getElementById('dueDateDisplay').textContent = dueDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            }) + ' - ' + dueDate.toLocaleTimeString('en-US', {
                hour: 'numeric',
                minute: '2-digit',
                hour12: true
            });
            document.getElementById('maxScoreDisplay').textContent = maxScore + ' points';

            // Update visibility display
            const visibilityInputs = document.querySelectorAll('input[name="visibility"]');
            visibilityInputs.forEach(input => {
                input.checked = (input.value === visibility);
            });

            // Switch back to view mode
            toggleEditMode();

            // Here you would typically send the data to the server
            console.log('Saved changes:', { name, description, dueDate, maxScore, visibility });
        }

        function cancelEdit() {
            isEditMode = false;
            const editButton = document.getElementById('editButton');
            const editActions = document.getElementById('editActions');

            // Reset button
            editButton.textContent = 'Edit';
            editButton.style.background = '#059669';
            editActions.style.display = 'none';

            // Show display fields, hide input fields
            document.getElementById('nameDisplay').style.display = 'block';
            document.getElementById('nameInput').style.display = 'none';

            document.getElementById('descriptionDisplay').style.display = 'block';
            document.getElementById('descriptionInput').style.display = 'none';

            document.getElementById('dueDateDisplay').style.display = 'block';
            document.getElementById('dueDateInput').style.display = 'none';

            document.getElementById('maxScoreDisplay').style.display = 'block';
            document.getElementById('maxScoreInput').style.display = 'none';

            document.getElementById('visibilityDisplay').style.display = 'flex';
            document.getElementById('visibilityEdit').style.display = 'none';
        }

        // Grade Activity Modal Functions
        function openGradeModal(studentName, activityName) {
            document.getElementById('studentNameDisplay').textContent = studentName;
            document.getElementById('activityNameDisplay').textContent = activityName;
            document.getElementById('modalActivityTitle').textContent = 'Grade: ' + activityName;
            document.getElementById('feedbackInput').value = '';
            document.getElementById('gradeActivityModal').classList.add('show');
        }

        function closeGradeModal() {
            document.getElementById('gradeActivityModal').classList.remove('show');
        }

        function confirmGrade() {
            const feedback = document.getElementById('feedbackInput').value;
            const studentName = document.getElementById('studentNameDisplay').textContent;
            const activityName = document.getElementById('activityNameDisplay').textContent;

            // Close grade modal
            closeGradeModal();

            // Show success modal
            document.getElementById('successModal').classList.add('show');

            // Here you would typically send the grade and feedback to the server
            console.log('Graded activity:', { studentName, activityName, feedback });
        }

        function closeSuccessModal() {
            document.getElementById('successModal').classList.remove('show');
        }

        function editGrade(studentId) {
            const gradeCell = document.querySelector(`#grade-${studentId}`);
            const gradeDisplay = gradeCell.querySelector('.grade-display');
            const gradeInput = gradeCell.querySelector('.grade-input');
            const editBtn = gradeCell.querySelector('.edit-grade-btn');
            const saveBtn = gradeCell.querySelector('.save-grade-btn');
            const cancelBtn = gradeCell.querySelector('.cancel-grade-btn');

            // Hide display and edit button, show input and action buttons
            gradeDisplay.style.display = 'none';
            editBtn.style.display = 'none';
            gradeInput.style.display = 'inline-block';
            saveBtn.style.display = 'inline-block';
            cancelBtn.style.display = 'inline-block';

            // Set input value to current grade (extract number from "45/50 (90%)" format)
            const currentGradeText = gradeDisplay.textContent.trim();
            const gradeMatch = currentGradeText.match(/^(\d+)/);
            const currentGrade = gradeMatch ? gradeMatch[1] : '';
            gradeInput.value = currentGrade;

            // Focus on input
            gradeInput.focus();

            // Handle Enter key to save, Escape to cancel
            gradeInput.onkeydown = function(e) {
                if (e.key === 'Enter') {
                    saveGrade(studentId);
                } else if (e.key === 'Escape') {
                    cancelGrade(studentId);
                }
            };
        }

        function saveGrade(studentId) {
            const gradeCell = document.querySelector(`#grade-${studentId}`);
            const gradeDisplay = gradeCell.querySelector('.grade-display');
            const gradeInput = gradeCell.querySelector('.grade-input');
            const editBtn = gradeCell.querySelector('.edit-grade-btn');
            const saveBtn = gradeCell.querySelector('.save-grade-btn');
            const cancelBtn = gradeCell.querySelector('.cancel-grade-btn');

            // Get the new grade value
            const newGrade = gradeInput.value.trim();
            const maxScore = 50; // This should come from the activity data

            // Calculate percentage
            const percentage = newGrade ? Math.round((parseInt(newGrade) / maxScore) * 100) : 0;
            const displayText = newGrade ? `${newGrade}/${maxScore} (${percentage}%)` : '-';

            // Update display with new grade
            gradeDisplay.textContent = displayText;

            // Hide input and action buttons, show display and edit button
            gradeDisplay.style.display = 'inline';
            editBtn.style.display = 'inline-block';
            gradeInput.style.display = 'none';
            saveBtn.style.display = 'none';
            cancelBtn.style.display = 'none';

            // Here you would typically send the update to the server
            console.log(`Grade updated for student ${studentId}: ${newGrade}/${maxScore} (${percentage}%)`);
        }

        function cancelGrade(studentId) {
            const gradeCell = document.querySelector(`#grade-${studentId}`);
            const gradeDisplay = gradeCell.querySelector('.grade-display');
            const gradeInput = gradeCell.querySelector('.grade-input');
            const editBtn = gradeCell.querySelector('.edit-grade-btn');
            const saveBtn = gradeCell.querySelector('.save-grade-btn');
            const cancelBtn = gradeCell.querySelector('.cancel-grade-btn');

            // Hide input and action buttons, show display and edit button
            gradeDisplay.style.display = 'inline';
            editBtn.style.display = 'inline-block';
            gradeInput.style.display = 'none';
            saveBtn.style.display = 'none';
            cancelBtn.style.display = 'none';
        }

        // Close modals when clicking outside
        document.getElementById('gradeActivityModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeGradeModal();
            }
        });

        document.getElementById('successModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeSuccessModal();
            }
        });

        // Close modals on ESC key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeGradeModal();
                closeSuccessModal();
                closeAddActivityModal();
            }
        });

        // Add Activity Modal Functions
        function openAddActivityModal() {
            // Reset form fields
            document.getElementById('addActivityName').value = '';
            document.getElementById('addActivityDescription').value = '';
            document.getElementById('addActivityDueDate').value = '';
            document.getElementById('addActivityMaxScore').value = '';
            document.querySelector('input[name="addActivityVisibility"][value="visible"]').checked = true;

            // Show modal
            document.getElementById('addActivityModal').classList.add('show');
        }

        function closeAddActivityModal() {
            document.getElementById('addActivityModal').classList.remove('show');
        }

        function addActivity() {
            // Get form values
            const name = document.getElementById('addActivityName').value.trim();
            const description = document.getElementById('addActivityDescription').value.trim();
            const dueDate = document.getElementById('addActivityDueDate').value;
            const maxScore = document.getElementById('addActivityMaxScore').value;
            const visibility = document.querySelector('input[name="addActivityVisibility"]:checked').value;

            // Basic validation
            if (!name) {
                alert('Please enter an activity name.');
                return;
            }

            // Here you would typically send the data to the server
            console.log('Adding new activity:', {
                name: name,
                description: description,
                dueDate: dueDate,
                maxScore: maxScore,
                visibility: visibility
            });

            // Close modal
            closeAddActivityModal();

            // Show success message (you could implement a success modal here)
            alert('Activity added successfully!');
        }

        // Close add activity modal when clicking outside
        document.getElementById('addActivityModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeAddActivityModal();
            }
        });
    </script>
    <style>
        .selected-activity {
            background-color: #e0f2fe !important;
            border-left: 4px solid #059669 !important;
        }
    </style>
}