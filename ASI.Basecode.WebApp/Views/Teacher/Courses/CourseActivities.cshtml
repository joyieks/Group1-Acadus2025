@model ASI.Basecode.WebApp.Models.TeacherCourseViewModel
@{
    Layout = "~/Views/Shared/_AuthenticatedLayout.cshtml";
    ViewData["Title"] = "Course Activities";
}

<!-- Hero Section -->
<section class="hero-section" style="background:#E8F9E8; display:flex; align-items:center; justify-content:center; text-align:center; position:relative; padding: 40px 0;">
    <a href="/Teacher/FullCourseView/@Model.Id" style="position:absolute; top:20px; left:20px; background:#ffffff; color:#059669; border:1px solid #d1d5db; border-radius:8px; padding:8px 16px; font-weight:600; text-decoration:none; transition:background 0.3s; display:flex; align-items:center; gap:8px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5"></path>
            <path d="M12 19l-7-7 7-7"></path>
        </svg>
        Back to Course
    </a>
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 16px;">
        <p style="margin:0 0 4px 0; color:#4b5563; font-size:20px;">@Model.CourseCode</p>
        <h1 style="font-size:48px; font-weight:800; margin:0 0 4px 0; color:#111827;">Course Activities</h1>
        <p style="margin:0 0 16px 0; color:#4b5563; font-size:18px;">@Model.SemesterInfo</p>
        <p style="margin:0 0 0 0; color:#6b7280; font-size:14px;">Manage and organize course activities and assignments.</p>
    </div>
</section>

<!-- White Section with Activities Management -->
<section style="background:#ffffff; padding: 40px 0;">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 16px;">
        <h2 style="margin:0 0 24px 0; font-weight:800; font-size:24px; color:#111827;">Activities Management</h2>

        <div style="display:grid; grid-template-columns: 3fr 5fr; gap:24px;">
            <!-- Left Column: Activities List -->
            <div>
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                    <h3 style="margin:0; font-weight:700; font-size:18px; color:#111827;">Activities</h3>
                    <button onclick="openAddActivityModal()" style="background:#059669; color:#ffffff; border:none; border-radius:8px; padding:8px 16px; font-weight:600; cursor:pointer; display:flex; align-items:center; gap:8px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 5v14"></path>
                            <path d="M5 12h14"></path>
                        </svg>
                        Activity
                    </button>
                </div>
                <div style="border-radius:8px; overflow:hidden; border:1px solid #e5e7eb;">
                    <table id="activitiesTable" style="width:100%; border-collapse:collapse;">
                        <thead style="background:#059669;">
                            <tr>
                                <th style="padding:12px 16px; text-align:left; font-weight:700; color:#fff;">Activity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="border-bottom:1px solid #e5e7eb; cursor:pointer;" onclick="selectActivity('Quiz 1: Introduction to Programming')">
                                <td style="padding:16px; color:#111827; font-weight:500;">Quiz 1: Introduction to Programming</td>
                            </tr>
                            <tr style="background:#f9fafb; border-bottom:1px solid #e5e7eb; cursor:pointer;" onclick="selectActivity('Assignment 1: Hello World Program')">
                                <td style="padding:16px; color:#111827; font-weight:500;">Assignment 1: Hello World Program</td>
                            </tr>
                            <tr style="border-bottom:1px solid #e5e7eb; cursor:pointer;" onclick="selectActivity('Midterm Exam')">
                                <td style="padding:16px; color:#111827; font-weight:500;">Midterm Exam</td>
                            </tr>
                            <tr style="background:#f9fafb; border-bottom:1px solid #e5e7eb; cursor:pointer;" onclick="selectActivity('Lab Exercise 1: Variables & Data Types')">
                                <td style="padding:16px; color:#111827; font-weight:500;">Lab Exercise 1: Variables & Data Types</td>
                            </tr>
                            <tr style="border-bottom:1px solid #e5e7eb; cursor:pointer;" onclick="selectActivity('Project 1: Calculator Application')">
                                <td style="padding:16px; color:#111827; font-weight:500;">Project 1: Calculator Application</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Right Column: Activity Details -->
            <div>
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                    <h3 style="margin:0; font-weight:700; font-size:18px; color:#111827;">Activity Details</h3>
                    <button id="editButton" onclick="toggleEditMode()" style="background:#059669; color:#ffffff; border:none; border-radius:8px; padding:8px 16px; font-weight:600; cursor:pointer;">Edit</button>
                </div>

                <div style="background:#f9fafb; border:1px solid #e5e7eb; border-radius:8px; padding:24px;">
                    <div style="margin-bottom:20px;">
                        <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px;">Name</label>
                        <div id="nameDisplay" style="color:#111827; font-size:16px;">Quiz 1: Introduction to Programming</div>
                        <input id="nameInput" type="text" value="Quiz 1: Introduction to Programming" style="width:100%; padding:8px 12px; border:1px solid #d1d5db; border-radius:6px; font-size:16px; display:none;">
                    </div>

                    <div style="margin-bottom:20px;">
                        <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px;">Description</label>
                        <div id="descriptionDisplay" style="color:#111827; font-size:14px; line-height:1.5;">This quiz covers the fundamental concepts of programming including variables, data types, and basic control structures. Students should be familiar with the course materials from the first two weeks.</div>
                        <textarea id="descriptionInput" rows="4" style="width:100%; padding:8px 12px; border:1px solid #d1d5db; border-radius:6px; font-size:14px; line-height:1.5; display:none;">This quiz covers the fundamental concepts of programming including variables, data types, and basic control structures. Students should be familiar with the course materials from the first two weeks.</textarea>
                    </div>

                    <div style="margin-bottom:20px;">
                        <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px;">Due Date</label>
                        <div id="dueDateDisplay" style="color:#111827; font-size:16px;">November 20, 2025 - 11:59 PM</div>
                        <input id="dueDateInput" type="datetime-local" value="2025-11-20T23:59" style="width:100%; padding:8px 12px; border:1px solid #d1d5db; border-radius:6px; font-size:16px; display:none;">
                    </div>

                    <div style="margin-bottom:20px;">
                        <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px;">Maximum Score</label>
                        <div id="maxScoreDisplay" style="color:#111827; font-size:16px;">50 points</div>
                        <input id="maxScoreInput" type="number" value="50" min="0" style="width:100%; padding:8px 12px; border:1px solid #d1d5db; border-radius:6px; font-size:16px; display:none;">
                    </div>

                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px;">Visibility</label>
                            <div id="visibilityDisplay" style="display:flex; align-items:center; gap:12px;">
                                <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                                    <input type="radio" name="visibility" value="visible" checked style="margin:0;">
                                    <span style="color:#111827; font-size:14px;">Visible to students</span>
                                </label>
                                <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                                    <input type="radio" name="visibility" value="hidden" style="margin:0;">
                                    <span style="color:#111827; font-size:14px;">Hidden from students</span>
                                </label>
                            </div>
                            <div id="visibilityEdit" style="display:flex; align-items:center; gap:12px; display:none;">
                                <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                                    <input type="radio" name="visibilityEdit" value="visible" checked style="margin:0;">
                                    <span style="color:#111827; font-size:14px;">Visible to students</span>
                                </label>
                                <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                                    <input type="radio" name="visibilityEdit" value="hidden" style="margin:0;">
                                    <span style="color:#111827; font-size:14px;">Hidden from students</span>
                                </label>
                            </div>
                        </div>
                        <div id="editActions" style="display:none;">
                            <button onclick="saveChanges()" style="background:#059669; color:#ffffff; border:none; border-radius:6px; padding:8px 16px; font-weight:600; cursor:pointer; margin-right:8px;">Save</button>
                            <button onclick="cancelEdit()" style="background:#6b7280; color:#ffffff; border:none; border-radius:6px; padding:8px 16px; font-weight:600; cursor:pointer;">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

