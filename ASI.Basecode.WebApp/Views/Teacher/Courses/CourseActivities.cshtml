    <script>
        $(document).ready(function() {
            // Initialize DataTable only if table has correct structure
            var activitiesTable = $('#activitiesTable');
            if (activitiesTable.length > 0) {
                var tbodyRows = activitiesTable.find('tbody tr');
                var headerCols = activitiesTable.find('thead th').length;
                
                // Check if all rows have the correct number of columns
                var hasValidStructure = true;
                tbodyRows.each(function() {
                    var rowCols = $(this).find('td').length;
                    if (rowCols !== headerCols && rowCols !== 0) {
                        hasValidStructure = false;
                        return false; // break loop
                    }
                });
                
                if (hasValidStructure && headerCols > 0) {
                    activitiesTable.DataTable({
                        "pageLength": 10,
                        "lengthChange": false,
                        "searching": false,
                        "ordering": true,
                        "info": true,
                        "paging": true,
                        "language": {
                            "paginate": {
                                "previous": "Prev",
                                "next": "Next"
                            }
                        }
                    });
                }
            }

            // Initialize DataTables for performance table
            // Check if table has actual data rows (not just the empty message)
            var performanceTable = $('#performanceTable');
            var tbodyRows = performanceTable.find('tbody tr');
            var hasDataRows = tbodyRows.length > 0 && 
                             tbodyRows.first().find('td').length === 5 &&
                             !tbodyRows.first().text().trim().includes('No students enrolled');
            
            if (hasDataRows) {
                performanceTable.DataTable({
                    "pageLength": 10,
                    "lengthChange": false,
                    "searching": true,
                    "ordering": true,
                    "info": true,
                    "paging": true,
                    "language": {
                        "paginate": {
                            "previous": "Prev",
                            "next": "Next"
                        }
                    }
                });
            } else {
                // If no data, just ensure the table displays properly without DataTables
                performanceTable.css('display', 'table');
            }
        });

        function selectActivity(activityId, activityName) {
            // Redirect to the same page with activityId parameter
            window.location.href = '@Url.Action("CourseActivities", "Teacher", new { id = Model.CourseId })?activityId=' + activityId;
        }

        let isEditMode = false;

        function toggleEditMode() {
            isEditMode = !isEditMode;
            const editButton = document.getElementById('editButton');
            const editActions = document.getElementById('editActions');

            if (isEditMode) {
                // Switch to edit mode
                editButton.textContent = 'Cancel';
                editButton.style.background = '#6b7280';
                editActions.style.display = 'block';

                // Show input fields, hide display fields
                document.getElementById('nameDisplay').style.display = 'none';
                document.getElementById('nameInput').style.display = 'block';

                document.getElementById('descriptionDisplay').style.display = 'none';
                document.getElementById('descriptionInput').style.display = 'block';

                document.getElementById('dueDateDisplay').style.display = 'none';
                document.getElementById('dueDateInputContainer').style.display = 'block';
                
                // Update min attribute to current date when editing
                const now = new Date();
                const nowYear = now.getFullYear();
                const nowMonth = String(now.getMonth() + 1).padStart(2, '0');
                const nowDay = String(now.getDate()).padStart(2, '0');
                const minDate = `${nowYear}-${nowMonth}-${nowDay}`;
                document.getElementById('dueDateInput').setAttribute('min', minDate);

                document.getElementById('maxScoreDisplay').style.display = 'none';
                document.getElementById('maxScoreInput').style.display = 'block';

                document.getElementById('visibilityDisplay').style.display = 'none';
                document.getElementById('visibilityEdit').style.display = 'flex';
                
                // Preserve current visibility state when entering edit mode
                const currentVisibility = document.querySelector('input[name="visibility"]:checked');
                if (currentVisibility) {
                    const visibilityEditRadio = document.querySelector(`input[name="visibilityEdit"][value="${currentVisibility.value}"]`);
                    if (visibilityEditRadio) {
                        visibilityEditRadio.checked = true;
                    }
                }
            } else {
                // Switch back to view mode
                cancelEdit();
            }
        }

        function saveChanges() {
            const activityId = document.getElementById('activityId').value;
            const courseId = @Model.CourseId;
            const name = document.getElementById('nameInput').value;
            const description = document.getElementById('descriptionInput').value;
            const dueDate = document.getElementById('dueDateInput').value;
            const dueTime = document.getElementById('dueTimeInput').value;
            const maxScore = document.getElementById('maxScoreInput').value;
            const visibility = document.querySelector('input[name="visibilityEdit"]:checked').value;

            // Combine date and time
            const combinedDateTime = dueDate && dueTime ? `${dueDate}T${dueTime}` : dueDate;

            // Validate that due date is not in the past
            if (combinedDateTime) {
                const selectedDate = new Date(combinedDateTime);
                const now = new Date();
                if (selectedDate < now) {
                    alert('Due date cannot be in the past. Please select a future date and time.');
                    document.getElementById('dueDateInput').focus();
                    return;
                }
            }

            // Submit form to server
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("UpdateActivity", "Teacher")';
            
            form.innerHTML = `
                <input type="hidden" name="id" value="${courseId}" />
                <input type="hidden" name="activityId" value="${activityId}" />
                <input type="hidden" name="Title" value="${name}" />
                <input type="hidden" name="Description" value="${description}" />
                <input type="hidden" name="DueDate" value="${combinedDateTime}" />
                <input type="hidden" name="MaxScore" value="${maxScore}" />
                <input type="hidden" name="IsVisible" value="${visibility === 'visible' ? 'true' : 'false'}" />
            `;
            
            document.body.appendChild(form);
            form.submit();
        }

        function cancelEdit() {
            isEditMode = false;
            const editButton = document.getElementById('editButton');
            const editActions = document.getElementById('editActions');

            // Reset button
            editButton.textContent = 'Edit';
            editButton.style.background = '#059669';
            editActions.style.display = 'none';

            // Show display fields, hide input fields
            document.getElementById('nameDisplay').style.display = 'block';
            document.getElementById('nameInput').style.display = 'none';

            document.getElementById('descriptionDisplay').style.display = 'block';
            document.getElementById('descriptionInput').style.display = 'none';

            document.getElementById('dueDateDisplay').style.display = 'block';
            document.getElementById('dueDateInputContainer').style.display = 'none';

            document.getElementById('maxScoreDisplay').style.display = 'block';
            document.getElementById('maxScoreInput').style.display = 'none';

            document.getElementById('visibilityDisplay').style.display = 'flex';
            document.getElementById('visibilityEdit').style.display = 'none';
            
            // Re-enable display mode radio buttons (they should be disabled/read-only)
            const displayRadios = document.querySelectorAll('input[name="visibility"]');
            displayRadios.forEach(radio => {
                radio.disabled = true;
            });
        }

        let currentStudentId = '';
        let currentActivityId = 0;

        // Grade Activity Modal Functions
        function openGradeModal(studentName, activityName, studentId, activityId, buttonElement) {
            currentStudentId = studentId;
            currentActivityId = activityId;
            document.getElementById('studentNameDisplay').textContent = studentName;
            document.getElementById('activityNameDisplay').textContent = activityName;
            document.getElementById('modalActivityTitle').textContent = 'Grade: ' + activityName;
            
            // Get data from button attributes
            const submissionContent = buttonElement ? buttonElement.getAttribute('data-submission-content') || '' : '';
            const feedback = buttonElement ? buttonElement.getAttribute('data-feedback') || '' : '';
            const hasFeedback = buttonElement ? buttonElement.getAttribute('data-has-feedback') === 'true' : false;
            const currentGrade = buttonElement ? buttonElement.getAttribute('data-current-grade') || '0' : '0';
            const maxScore = buttonElement ? buttonElement.getAttribute('data-max-score') || '100' : '100';
            
            // Set grade input and max score
            document.getElementById('modalGradeInput').value = currentGrade;
            document.getElementById('modalGradeInput').max = maxScore;
            document.getElementById('modalMaxScore').textContent = maxScore;
            
            // Display student's submission content
            const submissionDisplay = document.getElementById('submissionContentDisplay');
            if (submissionContent && submissionContent.trim() !== '') {
                // Decode HTML entities and preserve line breaks
                const formattedContent = submissionContent
                    .replace(/&amp;/g, '&')
                    .replace(/&lt;/g, '<')
                    .replace(/&gt;/g, '>')
                    .replace(/&quot;/g, '"')
                    .replace(/&#39;/g, "'")
                    .replace(/\n/g, '<br>');
                submissionDisplay.innerHTML = formattedContent;
                submissionDisplay.style.color = '#111827';
            } else {
                submissionDisplay.innerHTML = '<em style="color:#9ca3af;">No submission content available.</em>';
            }
            
            // Handle feedback display
            const existingFeedbackContainer = document.getElementById('existingFeedbackContainer');
            const newFeedbackContainer = document.getElementById('newFeedbackContainer');
            const confirmBtn = document.getElementById('confirmGradeBtn');
            
            if (hasFeedback && feedback && feedback.trim() !== '') {
                // Show existing feedback (like a post)
                const feedbackText = feedback
                    .replace(/&amp;/g, '&')
                    .replace(/&lt;/g, '<')
                    .replace(/&gt;/g, '>')
                    .replace(/&quot;/g, '"')
                    .replace(/&#39;/g, "'")
                    .replace(/\n/g, '<br>');
                
                document.getElementById('existingFeedbackText').innerHTML = feedbackText;
                const feedbackDate = buttonElement ? buttonElement.getAttribute('data-feedback-date') || '' : '';
                document.getElementById('feedbackDateDisplay').textContent = feedbackDate || new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
                
                existingFeedbackContainer.style.display = 'block';
                newFeedbackContainer.style.display = 'none';
                confirmBtn.style.display = 'inline-block'; // Show confirm button to allow grade editing
                confirmBtn.textContent = 'Save Grade'; // Change button text since feedback exists
            } else {
                // Show new feedback input
                document.getElementById('feedbackInput').value = '';
                existingFeedbackContainer.style.display = 'none';
                newFeedbackContainer.style.display = 'block';
                confirmBtn.style.display = 'inline-block';
                confirmBtn.textContent = 'Confirm'; // Reset button text
            }
            
            document.getElementById('gradeActivityModal').classList.add('show');
        }

        function closeGradeModal() {
            document.getElementById('gradeActivityModal').classList.remove('show');
        }

        function confirmGrade() {
            const feedbackInput = document.getElementById('feedbackInput');
            const feedback = feedbackInput ? feedbackInput.value.trim() : '';
            const gradeInput = document.getElementById('modalGradeInput');
            const score = gradeInput ? gradeInput.value : 0;
            
            // Check if feedback already exists (shouldn't happen, but double-check)
            const existingFeedbackContainer = document.getElementById('existingFeedbackContainer');
            const hasFeedbackAlready = existingFeedbackContainer && existingFeedbackContainer.style.display !== 'none';
            
            // Validate grade
            if (!score || score < 0) {
                alert('Please enter a valid grade.');
                if (gradeInput) gradeInput.focus();
                return;
            }
            
            const maxScore = gradeInput ? gradeInput.max : 100;
            if (parseInt(score) > parseInt(maxScore)) {
                alert(`Grade cannot exceed ${maxScore} points.`);
                if (gradeInput) gradeInput.focus();
                return;
            }
            
            // If feedback is being provided for the first time, show it as a post
            if (!hasFeedbackAlready && feedback) {
                // Hide the textarea and show feedback as a post immediately
                const newFeedbackContainer = document.getElementById('newFeedbackContainer');
                const confirmBtn = document.getElementById('confirmGradeBtn');
                
                // Hide textarea and confirm button
                newFeedbackContainer.style.display = 'none';
                confirmBtn.style.display = 'none';
                
                // Show existing feedback container with the new feedback
                const feedbackText = feedback
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;')
                    .replace(/\n/g, '<br>');
                
                document.getElementById('existingFeedbackText').innerHTML = '<strong>Feedback:</strong> ' + feedbackText;
                const now = new Date();
                document.getElementById('feedbackDateDisplay').textContent = now.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) + ' at ' + now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
                existingFeedbackContainer.style.display = 'block';
            }
            
            const courseId = @Model.CourseId;

            // Submit form to server
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("GradeActivity", "Teacher")';
            
            form.innerHTML = `
                <input type="hidden" name="id" value="${courseId}" />
                <input type="hidden" name="ActivityId" value="${currentActivityId}" />
                <input type="hidden" name="StudentId" value="${currentStudentId}" />
                <input type="hidden" name="Score" value="${score}" />
                <input type="hidden" name="Feedback" value="${feedback}" />
                <input type="hidden" name="SubmissionStatus" value="Graded" />
            `;
            
            document.body.appendChild(form);
            form.submit();
        }

        function closeSuccessModal() {
            document.getElementById('successModal').classList.remove('show');
        }

        function editGrade(studentId, maxScore) {
            const gradeCell = document.querySelector(`#grade-${studentId}`);
            const gradeDisplay = gradeCell.querySelector('.grade-display');
            const gradeInput = gradeCell.querySelector('.grade-input');
            const saveBtn = gradeCell.querySelector('.save-grade-btn');
            const cancelBtn = gradeCell.querySelector('.cancel-grade-btn');

            // Hide display, show input and action buttons
            gradeDisplay.style.display = 'none';
            gradeInput.style.setProperty('display', 'inline-block', 'important');
            saveBtn.style.setProperty('display', 'flex', 'important');
            cancelBtn.style.setProperty('display', 'flex', 'important');

            // Set input value to current grade (extract number from "45/50 (90%)" format)
            const currentGradeText = gradeDisplay.textContent.trim();
            const gradeMatch = currentGradeText.match(/^(\d+)/);
            const currentGrade = gradeMatch ? gradeMatch[1] : '';
            gradeInput.value = currentGrade;
            gradeInput.max = maxScore;

            // Focus on input
            gradeInput.focus();

            // Handle Enter key to save, Escape to cancel
            gradeInput.onkeydown = function(e) {
                if (e.key === 'Enter') {
                    const studentIdAttr = gradeInput.getAttribute('data-student-id');
                    const activityIdAttr = gradeInput.getAttribute('data-activity-id');
                    saveGrade(studentId, studentIdAttr, parseInt(activityIdAttr), maxScore);
                } else if (e.key === 'Escape') {
                    cancelGrade(studentId);
                }
            };
        }

        function saveGrade(studentId, studentIdAttr, activityId, maxScore) {
            const gradeCell = document.querySelector(`#grade-${studentId}`);
            const gradeDisplay = gradeCell.querySelector('.grade-display');
            const gradeInput = gradeCell.querySelector('.grade-input');
            const saveBtn = gradeCell.querySelector('.save-grade-btn');
            const cancelBtn = gradeCell.querySelector('.cancel-grade-btn');

            // Get the new grade value
            const newGrade = gradeInput.value.trim();
            const courseId = @Model.CourseId;

            // Validate grade
            if (!newGrade || isNaN(newGrade) || parseInt(newGrade) < 0 || parseInt(newGrade) > maxScore) {
                alert(`Please enter a valid grade between 0 and ${maxScore}`);
                gradeInput.focus();
                return;
            }

            // Calculate percentage
            const percentage = newGrade ? Math.round((parseInt(newGrade) / maxScore) * 100) : 0;
            const displayText = newGrade ? `${newGrade}/${maxScore} (${percentage}%)` : 'Not graded';

            // Update display with new grade IMMEDIATELY (optimistic update)
            gradeDisplay.textContent = displayText;
            gradeDisplay.style.display = 'inline';
            gradeInput.style.setProperty('display', 'none', 'important');
            saveBtn.style.setProperty('display', 'none', 'important');
            cancelBtn.style.setProperty('display', 'none', 'important');

            // Submit to server using AJAX to avoid page reload
            const formData = new FormData();
            formData.append('id', courseId);
            formData.append('ActivityId', activityId);
            formData.append('StudentId', studentIdAttr);
            formData.append('Score', newGrade);
            formData.append('SubmissionStatus', 'Graded');
            formData.append('Feedback', ''); // Empty feedback - backend will preserve existing
            
            // Get CSRF token
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || 
                         document.querySelector('input[name="RequestVerificationToken"]')?.value ||
                         '';
            
            if (token) {
                formData.append('__RequestVerificationToken', token);
            }

            fetch('@Url.Action("GradeActivity", "Teacher")', {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                credentials: 'same-origin'
            })
            .then(async response => {
                console.log('Response status:', response.status);
                console.log('Response headers:', response.headers);
                
                // Check content type
                const contentType = response.headers.get('content-type');
                console.log('Content-Type:', contentType);
                
                if (response.ok) {
                    if (contentType && contentType.includes('application/json')) {
                        return await response.json();
                    } else {
                        // Response might be HTML or redirect - this means it worked but returned HTML
                        console.log('Got non-JSON response, assuming success');
                        return { success: true, message: 'Grade updated successfully' };
                    }
                } else {
                    // Try to get error message from response
                    let errorMessage = `Server error: ${response.status} ${response.statusText}`;
                    try {
                        if (contentType && contentType.includes('application/json')) {
                            const errorData = await response.json();
                            errorMessage = errorData.message || errorMessage;
                        } else {
                            const text = await response.text();
                            console.error('Error response text:', text);
                            errorMessage = 'Failed to save grade. Please check the console for details.';
                        }
                    } catch (e) {
                        console.error('Error parsing error response:', e);
                    }
                    throw new Error(errorMessage);
                }
            })
            .then(data => {
                if (data && data.success) {
                    // Success - grade is already updated in UI
                    console.log('Grade updated successfully:', data.message || 'Grade saved');
                    // Update status cell
                    const statusCell = gradeCell.closest('tr').querySelector('td:nth-child(4)');
                    if (statusCell) {
                        const statusSpan = statusCell.querySelector('span');
                        if (statusSpan) {
                            statusSpan.textContent = 'Graded';
                            statusSpan.style.background = '#d1fae5';
                            statusSpan.style.color = '#065f46';
                        }
                    }
                } else {
                    throw new Error(data?.message || 'Failed to save grade');
                }
            })
            .catch(error => {
                console.error('Error saving grade:', error);
                console.error('Error details:', {
                    message: error.message,
                    stack: error.stack
                });
                alert('Error: ' + (error.message || 'An error occurred while saving the grade. Please try again.'));
                cancelGrade(studentId);
            });
        }

        function cancelGrade(studentId) {
            const gradeCell = document.querySelector(`#grade-${studentId}`);
            const gradeDisplay = gradeCell.querySelector('.grade-display');
            const gradeInput = gradeCell.querySelector('.grade-input');
            const editBtn = gradeCell.querySelector('.edit-grade-btn');
            const saveBtn = gradeCell.querySelector('.save-grade-btn');
            const cancelBtn = gradeCell.querySelector('.cancel-grade-btn');

            // Hide input and action buttons, show display
            gradeDisplay.style.display = 'inline';
            gradeInput.style.setProperty('display', 'none', 'important');
            saveBtn.style.setProperty('display', 'none', 'important');
            cancelBtn.style.setProperty('display', 'none', 'important');
        }

        // Close modals when clicking outside
        document.getElementById('gradeActivityModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeGradeModal();
            }
        });

        document.getElementById('successModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeSuccessModal();
            }
        });

        // Close modals on ESC key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeGradeModal();
                closeSuccessModal();
                closeAddActivityModal();
            }
        });

        // Add Activity Modal Functions
        function openAddActivityModal() {
            // Reset form fields
            document.getElementById('addActivityName').value = '';
            document.getElementById('addActivityDescription').value = '';
            document.getElementById('addActivityMaxScore').value = '';
            document.querySelector('input[name="addActivityVisibility"][value="visible"]').checked = true;

            // Set default due date to tomorrow at 11:59 PM
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            tomorrow.setHours(23, 59, 0, 0);
            
            // Format date and time separately
            const year = tomorrow.getFullYear();
            const month = String(tomorrow.getMonth() + 1).padStart(2, '0');
            const day = String(tomorrow.getDate()).padStart(2, '0');
            const hours = String(tomorrow.getHours()).padStart(2, '0');
            const minutes = String(tomorrow.getMinutes()).padStart(2, '0');
            const defaultDate = `${year}-${month}-${day}`;
            const defaultTime = `${hours}:${minutes}`;
            
            document.getElementById('addActivityDueDate').value = defaultDate;
            document.getElementById('addActivityDueTime').value = defaultTime;
            
            // Update min attribute to current date
            const now = new Date();
            const nowYear = now.getFullYear();
            const nowMonth = String(now.getMonth() + 1).padStart(2, '0');
            const nowDay = String(now.getDate()).padStart(2, '0');
            const minDate = `${nowYear}-${nowMonth}-${nowDay}`;
            document.getElementById('addActivityDueDate').setAttribute('min', minDate);

            // Show modal
            document.getElementById('addActivityModal').classList.add('show');
        }

        function closeAddActivityModal() {
            document.getElementById('addActivityModal').classList.remove('show');
        }

        // Delete Activity Modal Functions
        function openDeleteModal() {
            const activityId = document.getElementById('activityId')?.value;
            const activityName = document.getElementById('nameDisplay')?.textContent || 'this activity';
            
            if (!activityId) {
                alert('Please select an activity to delete.');
                return;
            }
            
            document.getElementById('deleteActivityName').textContent = activityName;
            document.getElementById('deleteActivityModal').classList.add('show');
        }

        function closeDeleteModal() {
            document.getElementById('deleteActivityModal').classList.remove('show');
        }

        function confirmDelete() {
            const activityId = document.getElementById('activityId')?.value;
            const courseId = @Model.CourseId;
            
            if (!activityId) {
                alert('Activity ID not found.');
                closeDeleteModal();
                return;
            }
            
            // Submit delete request
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("DeleteActivity", "Teacher")';
            
            form.innerHTML = `
                <input type="hidden" name="id" value="${courseId}" />
                <input type="hidden" name="activityId" value="${activityId}" />
            `;
            
            document.body.appendChild(form);
            form.submit();
        }

        function addActivity() {
            // Get form values
            const name = document.getElementById('addActivityName').value.trim();
            const description = document.getElementById('addActivityDescription').value.trim();
            const dueDate = document.getElementById('addActivityDueDate').value;
            const dueTime = document.getElementById('addActivityDueTime').value;
            const maxScore = document.getElementById('addActivityMaxScore').value;
            const visibility = document.querySelector('input[name="addActivityVisibility"]:checked').value;
            const courseId = @Model.CourseId;

            // Basic validation
            if (!name) {
                alert('Please enter an activity name.');
                return;
            }

            if (!dueDate) {
                alert('Please enter a due date.');
                return;
            }

            if (!dueTime) {
                alert('Please enter a due time.');
                return;
            }

            // Combine date and time
            const combinedDateTime = `${dueDate}T${dueTime}`;

            // Validate that due date is not in the past
            const selectedDate = new Date(combinedDateTime);
            const now = new Date();
            if (selectedDate < now) {
                alert('Due date cannot be in the past. Please select a future date and time.');
                document.getElementById('addActivityDueDate').focus();
                return;
            }

            if (!maxScore || parseInt(maxScore) <= 0) {
                alert('Please enter a valid maximum score.');
                return;
            }

            // Submit form to server
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("CreateActivity", "Teacher")';
            
            form.innerHTML = `
                <input type="hidden" name="id" value="${courseId}" />
                <input type="hidden" name="Title" value="${name}" />
                <input type="hidden" name="Description" value="${description}" />
                <input type="hidden" name="DueDate" value="${combinedDateTime}" />
                <input type="hidden" name="MaxScore" value="${maxScore}" />
                <input type="hidden" name="IsVisible" value="${visibility === 'visible' ? 'true' : 'false'}" />
            `;
            
            document.body.appendChild(form);
            form.submit();
        }

        // Close add activity modal when clicking outside
        document.getElementById('addActivityModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeAddActivityModal();
            }
        });
    </script>
    <style>
        .selected-activity {
            background-color: #e0f2fe !important;
            border-left: 4px solid #059669 !important;
        }
    </style>
}