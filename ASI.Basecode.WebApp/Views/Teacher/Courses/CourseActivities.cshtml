@model ASI.Basecode.Services.ServiceModels.TeacherCourseModel
@{
    Layout = "~/Views/Shared/_AuthenticatedLayout.cshtml";
    ViewData["Title"] = "Course Activities";
}

<!-- Hero Section -->
<section class="hero-section" style="background:#E8F9E8; display:flex; align-items:center; justify-content:center; text-align:center; position:relative; padding: 40px 0;">
    <a href="/Teacher/FullCourseView/@Model.Id" style="position:absolute; top:20px; left:20px; background:#ffffff; color:#059669; border:1px solid #d1d5db; border-radius:8px; padding:8px 16px; font-weight:600; text-decoration:none; transition:background 0.3s; display:flex; align-items:center; gap:8px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5"></path>
            <path d="M12 19l-7-7 7-7"></path>
        </svg>
        Back to Course
    </a>
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 16px;">
        <p style="margin:0 0 4px 0; color:#4b5563; font-size:20px;">@Model.CourseCode</p>
        <h1 style="font-size:48px; font-weight:800; margin:0 0 4px 0; color:#111827;">Course Activities</h1>
        <p style="margin:0 0 16px 0; color:#4b5563; font-size:18px;">@Model.SemesterInfo</p>
        <p style="margin:0 0 0 0; color:#6b7280; font-size:14px;">Manage and organize course activities and assignments.</p>
    </div>
</section>

<!-- White Section with Activities Management -->
<section style="background:#ffffff; padding: 40px 0;">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 16px;">
        <h2 style="margin:0 0 24px 0; font-weight:800; font-size:24px; color:#111827;">Activities Management</h2>

        <div style="display:grid; grid-template-columns: 3fr 5fr; gap:24px;">
            <!-- Left Column: Activities List -->
            <div>
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                    <h3 style="margin:0; font-weight:700; font-size:18px; color:#111827;">Activities</h3>
                    <button onclick="openAddActivityModal()" style="background:#059669; color:#ffffff; border:none; border-radius:8px; padding:8px 16px; font-weight:600; cursor:pointer; display:flex; align-items:center; gap:8px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 5v14"></path>
                            <path d="M5 12h14"></path>
                        </svg>
                        Activity
                    </button>
                </div>
                <div style="border-radius:8px; overflow:hidden; border:1px solid #e5e7eb;">
                    <table id="activitiesTable" style="width:100%; border-collapse:collapse;">
                        <thead style="background:#059669;">
                            <tr>
                                <th style="padding:12px 16px; text-align:left; font-weight:700; color:#fff;">Activity</th>
                                <th style="padding:12px 16px; text-align:left; font-weight:700; color:#fff;">Due Date & Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Activities != null && Model.Activities.Any())
                            {
                                @foreach (var activity in Model.Activities)
                                {
                                    var rowClass = Model.Activities.IndexOf(activity) % 2 == 0 ? "" : "background:#f9fafb;";
                                    var isSelected = ViewBag.SelectedActivity?.Id == activity.Id;
                                    var selectedStyle = isSelected ? "background-color:#e0f2fe !important; border-left:4px solid #059669 !important;" : "";
                                    <tr style="border-bottom:1px solid #e5e7eb; cursor:pointer; @rowClass @selectedStyle" onclick="selectActivity(@activity.Id, '@activity.Title')">
                                        <td style="padding:16px; color:#111827; font-weight:500;">@activity.Title</td>
                                        <td style="padding:16px; color:#6b7280; font-size:14px;">@activity.DueDate.ToString("MMM dd, yyyy hh:mm tt")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td style="padding:16px; color:#6b7280; text-align:center;">No activities yet. Click "Activity" to add one.</td>
                                    <td style="padding:16px; color:#6b7280; text-align:center;"></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Right Column: Activity Details -->
            <div>
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                    <h3 style="margin:0; font-weight:700; font-size:18px; color:#111827;">Activity Details</h3>
                    @if (ViewBag.SelectedActivity != null)
                    {
                        <div style="display:flex; gap:8px;">
                            <button id="editButton" onclick="toggleEditMode()" style="background:#059669; color:#ffffff; border:none; border-radius:8px; padding:8px 16px; font-weight:600; cursor:pointer;">Edit</button>
                            <button id="deleteButton" onclick="openDeleteModal()" style="background:#dc2626; color:#ffffff; border:none; border-radius:8px; padding:8px 16px; font-weight:600; cursor:pointer;">Delete</button>
                        </div>
                    }
                </div>

                <div style="background:#f9fafb; border:1px solid #e5e7eb; border-radius:8px; padding:24px;">
                    @if (ViewBag.SelectedActivity != null)
                    {
                        var activity = ViewBag.SelectedActivity as ASI.Basecode.Services.ServiceModels.TeacherActivityModel;
                        <div style="margin-bottom:20px;">
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px;">Name</label>
                            <div id="nameDisplay" style="color:#111827; font-size:16px;">@activity.Title</div>
                            <input id="nameInput" type="text" value="@activity.Title" style="width:100%; padding:8px 12px; border:1px solid #d1d5db; border-radius:6px; font-size:16px; display:none;">
                            <input type="hidden" id="activityId" value="@activity.Id" />
                        </div>

                        <div style="margin-bottom:20px;">
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px;">Description</label>
                            <div id="descriptionDisplay" style="color:#111827; font-size:14px; line-height:1.5;">@(string.IsNullOrEmpty(activity.Description) ? "No description provided." : activity.Description)</div>
                            <textarea id="descriptionInput" rows="4" style="width:100%; padding:8px 12px; border:1px solid #d1d5db; border-radius:6px; font-size:14px; line-height:1.5; display:none;">@activity.Description</textarea>
                        </div>

                        <div style="margin-bottom:20px;">
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px;">Due Date & Time</label>
                            <div id="dueDateDisplay" style="color:#111827; font-size:16px;">@activity.DueDate.ToString("MMMM dd, yyyy - hh:mm tt")</div>
                            <div id="dueDateInputContainer" style="display:none;">
                                <div style="display:flex; gap:12px; align-items:end;">
                                    <div style="flex:1;">
                                        <label style="display:block; font-weight:500; color:#6b7280; margin-bottom:4px; font-size:14px;">Date</label>
                                        <input id="dueDateInput" type="date" value="@activity.DueDate.ToString("yyyy-MM-dd")" min="@DateTime.Now.ToString("yyyy-MM-dd")" style="width:100%; padding:8px 12px; border:1px solid #d1d5db; border-radius:6px; font-size:16px;">
                                    </div>
                                    <div style="flex:1;">
                                        <label style="display:block; font-weight:500; color:#6b7280; margin-bottom:4px; font-size:14px;">Time</label>
                                        <input id="dueTimeInput" type="time" value="@activity.DueDate.ToString("HH:mm")" style="width:100%; padding:8px 12px; border:1px solid #d1d5db; border-radius:6px; font-size:16px;">
                                    </div>
                                </div>
                                <small style="color:#6b7280; font-size:12px; margin-top:4px; display:block;">Cannot set due date in the past.</small>
                            </div>
                        </div>

                        <div style="margin-bottom:20px;">
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px;">Maximum Score</label>
                            <div id="maxScoreDisplay" style="color:#111827; font-size:16px;">@activity.MaxScore points</div>
                            <input id="maxScoreInput" type="number" value="@activity.MaxScore" min="0" style="width:100%; padding:8px 12px; border:1px solid #d1d5db; border-radius:6px; font-size:16px; display:none;">
                        </div>
                    }
                    else
                    {
                        <div style="text-align:center; padding:40px; color:#6b7280;">
                            <p>Select an activity from the list to view details.</p>
                        </div>
                    }

                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px;">Visibility</label>
                            <div id="visibilityDisplay" style="display:flex; align-items:center; gap:12px;">
                                <label style="display:flex; align-items:center; gap:8px; cursor:default;">
                                    <input type="radio" name="visibility" value="visible" @(ViewBag.SelectedActivity != null && ((ASI.Basecode.Services.ServiceModels.TeacherActivityModel)ViewBag.SelectedActivity).IsVisible == true ? "checked" : "") disabled style="margin:0; cursor:not-allowed;">
                                    <span style="color:#111827; font-size:14px;">Visible to students</span>
                                </label>
                                <label style="display:flex; align-items:center; gap:8px; cursor:default;">
                                    <input type="radio" name="visibility" value="hidden" @(ViewBag.SelectedActivity != null && ((ASI.Basecode.Services.ServiceModels.TeacherActivityModel)ViewBag.SelectedActivity).IsVisible == false ? "checked" : "") disabled style="margin:0; cursor:not-allowed;">
                                    <span style="color:#111827; font-size:14px;">Hidden from students</span>
                                </label>
                            </div>
                            <div id="visibilityEdit" style="display:flex; align-items:center; gap:12px; display:none;">
                                <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                                    <input type="radio" name="visibilityEdit" value="visible" @(ViewBag.SelectedActivity != null && ((ASI.Basecode.Services.ServiceModels.TeacherActivityModel)ViewBag.SelectedActivity).IsVisible == true ? "checked" : "") style="margin:0; cursor:pointer;">
                                    <span style="color:#111827; font-size:14px;">Visible to students</span>
                                </label>
                                <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                                    <input type="radio" name="visibilityEdit" value="hidden" @(ViewBag.SelectedActivity != null && ((ASI.Basecode.Services.ServiceModels.TeacherActivityModel)ViewBag.SelectedActivity).IsVisible == false ? "checked" : "") style="margin:0; cursor:pointer;">
                                    <span style="color:#111827; font-size:14px;">Hidden from students</span>
                                </label>
                            </div>
                        </div>
                        <div id="editActions" style="display:none;">
                            <button onclick="saveChanges()" style="background:#059669; color:#ffffff; border:none; border-radius:6px; padding:8px 16px; font-weight:600; cursor:pointer; margin-right:8px;">Save</button>
                            <button onclick="cancelEdit()" style="background:#6b7280; color:#ffffff; border:none; border-radius:6px; padding:8px 16px; font-weight:600; cursor:pointer;">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Student Activity Performance Section -->
<section style="background:#ffffff; padding: 40px 0;">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 16px;">
        <h2 style="margin:0 0 24px 0; font-weight:800; font-size:24px; color:#111827;">Student Activity Performance</h2>

        <div style="border-radius:8px; overflow:hidden; border:1px solid #e5e7eb;">
            <table id="performanceTable" style="width:100%; border-collapse:collapse;">
                <thead style="background:#059669;">
                    <tr>
                        <th style="padding:12px 16px; text-align:left; font-weight:700; color:#fff;">First Name</th>
                        <th style="padding:12px 16px; text-align:left; font-weight:700; color:#fff;">Last Name</th>
                        <th style="padding:12px 16px; text-align:left; font-weight:700; color:#fff;">Grade</th>
                        <th style="padding:12px 16px; text-align:left; font-weight:700; color:#fff;">Status</th>
                        <th style="padding:12px 16px; text-align:left; font-weight:700; color:#fff;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var students = ViewBag.Students as System.Collections.Generic.List<object>;
                        var selectedActivity = ViewBag.SelectedActivity as ASI.Basecode.Services.ServiceModels.TeacherActivityModel;
                        var maxScore = selectedActivity?.MaxScore ?? 100;
                    }
                    @if (students != null && students.Any())
                    {
                        @foreach (var studentObj in students)
                        {
                            var student = studentObj as System.Collections.Generic.Dictionary<string, object>;
                            if (student == null) continue;
                            
                            var rowIndex = students.IndexOf(studentObj);
                            var rowClass = rowIndex % 2 == 0 ? "" : "background:#f9fafb;";
                            var studentId = student["Id"]?.ToString()?.Replace("-", "") ?? "";
                            var firstName = student["FirstName"]?.ToString() ?? "";
                            var lastName = student["LastName"]?.ToString() ?? "";
                            var fullName = $"{firstName} {lastName}";
                            // Get grade - handle both int and float, and check if submission exists
                            var gradeValue = student["Grade"];
                            int? grade = null;
                            if (gradeValue != null)
                            {
                                if (gradeValue is int intGrade)
                                {
                                    grade = intGrade;
                                }
                                else if (gradeValue is float floatGrade)
                                {
                                    grade = (int)floatGrade;
                                }
                                else if (int.TryParse(gradeValue.ToString(), out int parsedGrade))
                                {
                                    grade = parsedGrade;
                                }
                            }
                            
                            var status = student["Status"]?.ToString() ?? "Not submitted";
                            var statusClass = status == "Graded" ? "background:#d1fae5; color:#065f46;" : 
                                            status == "Submitted" ? "background:#e5e7eb; color:#374151;" : 
                                            status == "Late" ? "background:#fed7aa; color:#9a3412;" : 
                                            "background:#e5e7eb; color:#374151;";
                            
                            // Show grade if it exists (even if 0), or "Not graded" if no submission
                            var gradeDisplay = grade.HasValue ? $"{grade.Value}/{maxScore} ({Math.Round((double)grade.Value / maxScore * 100)}%)" : "Not graded";
                            
                            <tr style="border-bottom:1px solid #e5e7eb; @rowClass">
                                <td style="padding:16px; color:#111827; font-weight:500;">@firstName</td>
                                <td style="padding:16px; color:#111827; font-weight:500;">@lastName</td>
                                <td style="padding:16px;" id="grade-@studentId">
                                    <div style="display:flex; align-items:center; gap:4px;">
                                        <span class="grade-display">@gradeDisplay</span>
                                        <input type="number" class="grade-input" min="0" max="@maxScore" value="@(grade ?? 0)" data-student-id="@student["Id"]" data-activity-id="@(selectedActivity?.Id ?? 0)" style="display:none !important; width:80px; padding:4px; border:1px solid #d1d5db; border-radius:4px; text-align:center;">
                                        <button onclick="saveGrade('@studentId', '@student["Id"]', @(selectedActivity?.Id ?? 0))" class="save-grade-btn" style="display:none !important; background:#059669; color:#ffffff; border:none; border-radius:50%; width:24px; height:24px; padding:0; cursor:pointer; margin-left:4px; align-items:center; justify-content:center; font-size:14px; font-weight:bold;" title="Save">✓</button>
                                        <button onclick="cancelGrade('@studentId')" class="cancel-grade-btn" style="display:none !important; background:#dc2626; color:#ffffff; border:none; border-radius:50%; width:24px; height:24px; padding:0; cursor:pointer; margin-left:4px; align-items:center; justify-content:center; font-size:14px; font-weight:bold;" title="Cancel">×</button>
                                    </div>
                                </td>
                                <td style="padding:16px;">
                                    <span style="@statusClass padding:4px 8px; border-radius:4px; font-size:12px; font-weight:600;">@status</span>
                                </td>
                                <td style="padding:16px;">
                                    @{
                                        var submissionContent = student.ContainsKey("SubmissionContent") ? student["SubmissionContent"]?.ToString() ?? "" : "";
                                        var feedback = student.ContainsKey("Feedback") ? student["Feedback"]?.ToString() ?? "" : "";
                                        var hasFeedback = !string.IsNullOrEmpty(feedback);
                                        var feedbackDate = student.ContainsKey("FeedbackDate") ? student["FeedbackDate"]?.ToString() ?? "" : "";
                                    }
                                    <button onclick="openGradeModal('@fullName', '@(selectedActivity?.Title ?? "Activity")', '@student["Id"]', @(selectedActivity?.Id ?? 0), this)" 
                                            data-submission-content="@Html.Raw(System.Web.HttpUtility.HtmlAttributeEncode(submissionContent))"
                                            data-feedback="@Html.Raw(System.Web.HttpUtility.HtmlAttributeEncode(feedback))"
                                            data-has-feedback="@(hasFeedback ? "true" : "false")"
                                            data-feedback-date="@feedbackDate"
                                            data-current-grade="@(grade ?? 0)"
                                            data-max-score="@maxScore"
                                            style="background:#059669; color:#ffffff; border:none; border-radius:6px; padding:6px 12px; font-weight:600; cursor:pointer;">Grade Activity</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td style="padding:16px; color:#6b7280; text-align:center;"></td>
                            <td style="padding:16px; color:#6b7280; text-align:center;"></td>
                            <td style="padding:16px; color:#6b7280; text-align:center;">No students enrolled in this course.</td>
                            <td style="padding:16px; color:#6b7280; text-align:center;"></td>
                            <td style="padding:16px; color:#6b7280; text-align:center;"></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- Grade Activity Modal -->
<div id="gradeActivityModal" class="grade-modal">
    <div class="grade-modal-box">
        <div class="grade-modal-header">
            <h3 id="modalActivityTitle" class="grade-modal-title">Grade Activity</h3>
            <button onclick="closeGradeModal()" class="grade-modal-close">&times;</button>
        </div>
        <div class="grade-modal-body">
            <div class="grade-modal-content">
                <div style="margin-bottom:20px;">
                    <strong id="studentNameDisplay">Student Name</strong> answered <strong id="activityNameDisplay">Activity Name</strong>
                </div>
                
                <!-- Grade Input Field -->
                <div style="margin-bottom:20px;">
                    <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px;">Grade / Score</label>
                    <div style="display:flex; align-items:center; gap:12px;">
                        <input type="number" id="modalGradeInput" min="0" max="100" placeholder="0" style="width:100px; padding:10px 12px; border:1px solid #d1d5db; border-radius:8px; font-size:16px; font-weight:600; color:#059669; text-align:center;">
                        <span style="color:#6b7280; font-size:14px;">/ <span id="modalMaxScore">100</span> points</span>
                    </div>
                </div>
                
                <div style="margin-bottom:20px;">
                    <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px;">Student's Answer</label>
                    <div id="submissionContentDisplay" style="background:#f9fafb; border:1px solid #e5e7eb; border-radius:8px; padding:16px; min-height:100px; max-height:300px; overflow-y:auto; white-space:pre-wrap; word-wrap:break-word; font-size:14px; line-height:1.6; color:#111827;">
                        <em style="color:#9ca3af;">No submission content available.</em>
                    </div>
                </div>
                <!-- Existing Feedback Display (like a post) -->
                <div id="existingFeedbackContainer" style="margin-bottom:20px; display:none;">
                    <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px;">Feedback</label>
                    <div id="existingFeedbackDisplay" style="background:#f9fafb; border:1px solid #e5e7eb; border-radius:8px; padding:16px; margin-bottom:12px;">
                        <div style="display:flex; align-items:center; margin-bottom:8px;">
                            <div style="width:32px; height:32px; background:#059669; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#ffffff; font-weight:bold; margin-right:12px; font-size:14px;">T</div>
                            <div>
                                <div style="font-weight:600; color:#111827; font-size:14px;">Teacher</div>
                                <div style="font-size:12px; color:#6b7280;" id="feedbackDateDisplay"></div>
                            </div>
                        </div>
                        <div id="existingFeedbackText" style="color:#111827; font-size:14px; line-height:1.6; white-space:pre-wrap; word-wrap:break-word;"></div>
                    </div>
                    <div style="padding:12px; background:#dbeafe; border:1px solid #60a5fa; border-radius:6px; color:#1e40af; font-size:13px;">
                        <strong>Note:</strong> Feedback has already been provided. You can still edit the grade above.
                    </div>
                </div>
                
                <!-- New Feedback Input (only shown if no feedback exists) -->
                <div id="newFeedbackContainer" style="margin-bottom:20px;">
                    <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px;">Feedback</label>
                    <textarea id="feedbackInput" rows="4" placeholder="Provide feedback for the student's work..." style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px; line-height:1.5; resize:vertical;"></textarea>
                </div>
                <div class="grade-modal-actions">
                    <button onclick="closeGradeModal()" style="padding:10px 24px; border-radius:8px; font-size:14px; font-weight:600; cursor:pointer; background:#ffffff; color:#6b7280; border:1px solid #d1d5db;">Close</button>
                    <button id="confirmGradeBtn" onclick="confirmGrade()" style="padding:10px 24px; border-radius:8px; font-size:14px; font-weight:600; cursor:pointer; background:#059669; color:#ffffff; border:none;">Confirm</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div id="successModal" class="success-modal">
    <div class="success-modal-box">
        <div class="success-modal-content">
            <div class="success-icon">✓</div>
            <h3 class="success-title">Activity Graded Successfully!</h3>
            <p class="success-message">The student's activity has been graded and feedback has been provided.</p>
            <button onclick="closeSuccessModal()" class="success-close-btn">Close</button>
        </div>
    </div>
</div>

<!-- Add Activity Modal -->
<div id="addActivityModal" class="add-activity-modal">
    <div class="add-activity-modal-box">
        <div class="add-activity-modal-header">
            <h3 class="add-activity-modal-title">Add New Activity</h3>
            <button onclick="closeAddActivityModal()" class="add-activity-modal-close">&times;</button>
        </div>
        <div class="add-activity-modal-body">
            <div style="margin-bottom:20px;">
                <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px;">Name *</label>
                <input id="addActivityName" type="text" placeholder="Enter activity name" style="width:100%; padding:8px 12px; border:1px solid #d1d5db; border-radius:6px; font-size:16px;">
            </div>

            <div style="margin-bottom:20px;">
                <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px;">Description</label>
                <textarea id="addActivityDescription" rows="4" placeholder="Enter activity description" style="width:100%; padding:8px 12px; border:1px solid #d1d5db; border-radius:6px; font-size:14px; line-height:1.5;"></textarea>
            </div>

            <div style="margin-bottom:20px;">
                <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px;">Due Date & Time *</label>
                <div style="display:flex; gap:12px; align-items:end;">
                    <div style="flex:1;">
                        <label style="display:block; font-weight:500; color:#6b7280; margin-bottom:4px; font-size:14px;">Date</label>
                        <input id="addActivityDueDate" type="date" min="@DateTime.Now.ToString("yyyy-MM-dd")" style="width:100%; padding:8px 12px; border:1px solid #d1d5db; border-radius:6px; font-size:16px;">
                    </div>
                    <div style="flex:1;">
                        <label style="display:block; font-weight:500; color:#6b7280; margin-bottom:4px; font-size:14px;">Time</label>
                        <input id="addActivityDueTime" type="time" style="width:100%; padding:8px 12px; border:1px solid #d1d5db; border-radius:6px; font-size:16px;">
                    </div>
                </div>
                <small style="color:#6b7280; font-size:12px; margin-top:4px; display:block;">Cannot set due date in the past. Default is set to tomorrow at 11:59 PM.</small>
            </div>

            <div style="margin-bottom:20px;">
                <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px;">Maximum Score</label>
                <input id="addActivityMaxScore" type="number" min="0" placeholder="Enter maximum score" style="width:100%; padding:8px 12px; border:1px solid #d1d5db; border-radius:6px; font-size:16px;">
            </div>

            <div style="margin-bottom:24px;">
                <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px;">Visibility</label>
                <div style="display:flex; align-items:center; gap:12px;">
                    <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                        <input type="radio" name="addActivityVisibility" value="visible" checked style="margin:0;">
                        <span style="color:#111827; font-size:14px;">Visible to students</span>
                    </label>
                    <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                        <input type="radio" name="addActivityVisibility" value="hidden" style="margin:0;">
                        <span style="color:#111827; font-size:14px;">Hidden from students</span>
                    </label>
                </div>
            </div>

            <div style="display:flex; justify-content:flex-end; gap:12px; padding-top:16px; border-top:1px solid #e5e7eb;">
                <button onclick="closeAddActivityModal()" style="background:#6b7280; color:#ffffff; border:none; border-radius:6px; padding:10px 20px; font-weight:600; cursor:pointer;">Cancel</button>
                <button onclick="addActivity()" style="background:#059669; color:#ffffff; border:none; border-radius:6px; padding:10px 20px; font-weight:600; cursor:pointer;">Add Activity</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Activity Confirmation Modal -->
<div id="deleteActivityModal" class="delete-modal">
    <div class="delete-modal-box">
        <div class="delete-modal-header">
            <h3 class="delete-modal-title">Delete Activity</h3>
            <button onclick="closeDeleteModal()" class="delete-modal-close">&times;</button>
        </div>
        <div class="delete-modal-body">
            <div style="text-align:center; padding:20px 0;">
                <div style="width:64px; height:64px; background:#fee2e2; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 20px;">
                    <svg style="width:32px; height:32px; color:#dc2626;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                </div>
                <h4 style="margin:0 0 12px 0; font-size:20px; font-weight:700; color:#111827;">Are you sure?</h4>
                <p style="margin:0 0 24px 0; color:#6b7280; font-size:14px; line-height:1.6;">
                    This will permanently delete the activity "<span id="deleteActivityName" style="font-weight:600; color:#111827;"></span>" and all associated student submissions and grades. This action cannot be undone.
                </p>
            </div>
            <div style="display:flex; gap:12px; justify-content:center;">
                <button onclick="closeDeleteModal()" style="background:#ffffff; color:#374151; border:1px solid #d1d5db; border-radius:8px; padding:10px 24px; font-weight:600; cursor:pointer;">Cancel</button>
                <button onclick="confirmDelete()" style="background:#dc2626; color:#ffffff; border:none; border-radius:8px; padding:10px 24px; font-weight:600; cursor:pointer;">Yes, Delete Activity</button>
            </div>
        </div>
    </div>
</div>

