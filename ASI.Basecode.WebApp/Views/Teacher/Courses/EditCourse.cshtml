@model ASI.Basecode.WebApp.Models.TeacherCourseViewModel
@{
    Layout = "~/Views/Shared/_AuthenticatedLayout.cshtml";
    ViewData["Title"] = "Edit Course";
}

<script src="https://cdn.tailwindcss.com"></script>

<!-- Header Section -->
<section class="bg-[#E8F9E8] py-8 text-center">
    <div class="container max-w-[1200px] mx-auto px-4">
        <h1 class="text-3xl font-extrabold m-0 mb-2 text-gray-900">EDIT COURSE</h1>
        <p class="m-0 text-gray-600 text-sm">@Model.CourseTitle (@Model.CourseCode)</p>
        <a href="@Url.Action("Courses", "Teacher")" class="text-emerald-600 no-underline font-semibold">Back to Courses</a>
    </div>
</section>

<!-- Main Content Section -->
<section class="bg-gray-50 py-10">
    <div class="container max-w-[1200px] mx-auto px-4">
        <p>Content for editing course will be added here.</p>
    </div>
</section>
