@model ASI.Basecode.Services.ServiceModels.TeacherViewModel

@{
    ViewData["Title"] = "Add Teacher - Acadus";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="https://cdn.tailwindcss.com"></script>

<!-- Header Section -->
<section class="bg-[#E8F9E8] py-8 text-center">
	<div class="container max-w-[1200px] mx-auto px-4">
		<h1 class="text-3xl font-extrabold m-0 mb-2 text-gray-900">ADD A TEACHER</h1>
		<p class="m-0 text-gray-600 text-sm">Complete the form below to register a new teacher</p>
	</div>
</section>

<!-- Action Buttons Section (Full Width White) -->
<section class="bg-white py-8 pb-10">
	<div class="container max-w-[900px] mx-auto px-4">
		@if (TempData["SuccessMessage"] != null)
		{
			<div class="bg-emerald-100 text-emerald-800 py-3 px-4 rounded-md mb-5 border border-emerald-200">
				@TempData["SuccessMessage"]
			</div>
		}
		
		@if (!ViewData.ModelState.IsValid)
		{
			<div class="bg-red-50 text-red-600 py-3 px-4 rounded-md mb-5 border border-red-200">
				@Html.ValidationSummary(true, "", new { @class = "m-0" })
			</div>
		}
		
		<form method="post" asp-action="AddTeacher" asp-controller="Teacher">
			@Html.AntiForgeryToken()

			<!-- Personal Information Section -->
			<div class="bg-white py-8 mb-5 border border-gray-200 rounded-lg">
				<div class="max-w-[900px] mx-auto px-4">
					<h2 class="text-lg font-extrabold m-0 mb-6 text-gray-900">Section 1: Personal Information</h2>
					
					<div class="grid grid-cols-2 gap-5">
						<!-- First name -->
						<div>
							<label asp-for="FirstName" class="block mb-1.5 text-sm font-semibold text-gray-900">
								@Html.DisplayNameFor(m => m.FirstName) <span class="text-red-600">*</span>
							</label>
							<input asp-for="FirstName" type="text" required 
								   class="w-full py-2.5 px-3 border border-gray-300 rounded-md text-sm box-border">
							<span asp-validation-for="FirstName" class="text-red-600 text-xs"></span>
						</div>
						
						<!-- Last name -->
						<div>
							<label asp-for="LastName" class="block mb-1.5 text-sm font-semibold text-gray-900">
								@Html.DisplayNameFor(m => m.LastName) <span class="text-red-600">*</span>
							</label>
							<input asp-for="LastName" type="text" required 
								   class="w-full py-2.5 px-3 border border-gray-300 rounded-md text-sm box-border">
							<span asp-validation-for="LastName" class="text-red-600 text-xs"></span>
						</div>
						
						<!-- Middle name -->
						<div>
							<label asp-for="MiddleName" class="block mb-1.5 text-sm font-semibold text-gray-900">
								@Html.DisplayNameFor(m => m.MiddleName)
							</label>
							<input asp-for="MiddleName" type="text" 
								   class="w-full py-2.5 px-3 border border-gray-300 rounded-md text-sm box-border">
							<span asp-validation-for="MiddleName" class="text-red-600 text-xs"></span>
						</div>
						
						<!-- Suffix -->
						<div>
							<label asp-for="Suffix" class="block mb-1.5 text-sm font-semibold text-gray-900">
								@Html.DisplayNameFor(m => m.Suffix)
							</label>
							<input asp-for="Suffix" type="text" 
								   class="w-full py-2.5 px-3 border border-gray-300 rounded-md text-sm box-border">
							<span asp-validation-for="Suffix" class="text-red-600 text-xs"></span>
						</div>
						
						<!-- Contact Number -->
						<div>
							<label asp-for="ContactNumber" class="block mb-1.5 text-sm font-semibold text-gray-900">
								@Html.DisplayNameFor(m => m.ContactNumber) <span class="text-red-600">*</span>
							</label>
							<input asp-for="ContactNumber" type="tel" required 
								   class="w-full py-2.5 px-3 border border-gray-300 rounded-md text-sm box-border">
							<span asp-validation-for="ContactNumber" class="text-red-600 text-xs"></span>
						</div>
						
						<!-- Email -->
						<div>
							<label asp-for="Email" class="block mb-1.5 text-sm font-semibold text-gray-900">
								@Html.DisplayNameFor(m => m.Email) <span class="text-red-600">*</span>
							</label>
							<input asp-for="Email" type="email" required 
								   class="w-full py-2.5 px-3 border border-gray-300 rounded-md text-sm box-border">
							<span asp-validation-for="Email" class="text-red-600 text-xs"></span>
						</div>
					</div>
				</div>
			</div>

			<!-- Teacher Specific Information Section -->
			<div class="bg-white py-8 mb-5 border border-gray-200 rounded-lg">
				<div class="max-w-[900px] mx-auto px-4">
					<h2 class="text-lg font-extrabold m-0 mb-6 text-gray-900">Section 2: Teacher Specific Information</h2>
					
					<div class="grid grid-cols-2 gap-5">
						<!-- ID Number -->
						<div>
							<label asp-for="IdNumber" class="block mb-1.5 text-sm font-semibold text-gray-900">
								@Html.DisplayNameFor(m => m.IdNumber)
							</label>
							<input asp-for="IdNumber" type="text" value="TCH-2025-001" readonly 
								   class="w-full py-2.5 px-3 border border-gray-300 rounded-md text-sm box-border bg-gray-50">
							<small class="text-gray-500 text-xs">Auto-generated teacher ID</small>
							<span asp-validation-for="IdNumber" class="text-red-600 text-xs"></span>
						</div>
						
						<!-- Department -->
						<div>
							<label asp-for="Department" class="block mb-1.5 text-sm font-semibold text-gray-900">
								@Html.DisplayNameFor(m => m.Department) <span class="text-red-600">*</span>
							</label>
							<select asp-for="Department" required 
									class="w-full py-2.5 px-3 border border-gray-300 rounded-md text-sm box-border bg-white">
								<option value="">Select Department</option>
								<option value="Computer Science">Computer Science</option>
								<option value="Information Technology">Information Technology</option>
								<option value="Engineering">Engineering</option>
								<option value="Business Administration">Business Administration</option>
								<option value="Education">Education</option>
								<option value="Liberal Arts">Liberal Arts</option>
							</select>
							<span asp-validation-for="Department" class="text-red-600 text-xs"></span>
						</div>
					</div>
				</div>
			</div>

			<!-- Address Information Section -->
			<div class="bg-white py-8 mb-5 border border-gray-200 rounded-lg">
				<div class="max-w-[900px] mx-auto px-4">
					<h2 class="text-lg font-extrabold m-0 mb-6 text-gray-900">Section 3: Address Information</h2>
					
					<div class="grid grid-cols-2 gap-5">
						<!-- House/Apt Number -->
						<div>
							<label asp-for="HouseNumber" class="block mb-1.5 text-sm font-semibold text-gray-900">
								@Html.DisplayNameFor(m => m.HouseNumber)
							</label>
							<input asp-for="HouseNumber" type="text" 
								   class="w-full py-2.5 px-3 border border-gray-300 rounded-md text-sm box-border">
							<span asp-validation-for="HouseNumber" class="text-red-600 text-xs"></span>
						</div>
						
						<!-- Street Name -->
						<div>
							<label asp-for="StreetName" class="block mb-1.5 text-sm font-semibold text-gray-900">
								@Html.DisplayNameFor(m => m.StreetName) <span class="text-red-600">*</span>
							</label>
							<input asp-for="StreetName" type="text" required 
								   class="w-full py-2.5 px-3 border border-gray-300 rounded-md text-sm box-border">
							<span asp-validation-for="StreetName" class="text-red-600 text-xs"></span>
						</div>
						
						<!-- Subdivision -->
						<div>
							<label asp-for="Subdivision" class="block mb-1.5 text-sm font-semibold text-gray-900">
								@Html.DisplayNameFor(m => m.Subdivision)
							</label>
							<input asp-for="Subdivision" type="text" 
								   class="w-full py-2.5 px-3 border border-gray-300 rounded-md text-sm box-border">
							<span asp-validation-for="Subdivision" class="text-red-600 text-xs"></span>
						</div>
						
						<!-- Barangay -->
						<div>
							<label asp-for="Barangay" class="block mb-1.5 text-sm font-semibold text-gray-900">
								@Html.DisplayNameFor(m => m.Barangay) <span class="text-red-600">*</span>
							</label>
							<input asp-for="Barangay" type="text" required 
								   class="w-full py-2.5 px-3 border border-gray-300 rounded-md text-sm box-border">
							<span asp-validation-for="Barangay" class="text-red-600 text-xs"></span>
						</div>
						
						<!-- City -->
						<div>
							<label asp-for="City" class="block mb-1.5 text-sm font-semibold text-gray-900">
								@Html.DisplayNameFor(m => m.City) <span class="text-red-600">*</span>
							</label>
							<input asp-for="City" type="text" required 
								   class="w-full py-2.5 px-3 border border-gray-300 rounded-md text-sm box-border">
							<span asp-validation-for="City" class="text-red-600 text-xs"></span>
						</div>
						
						<!-- Province -->
						<div>
							<label asp-for="Province" class="block mb-1.5 text-sm font-semibold text-gray-900">
								@Html.DisplayNameFor(m => m.Province) <span class="text-red-600">*</span>
							</label>
							<input asp-for="Province" type="text" required 
								   class="w-full py-2.5 px-3 border border-gray-300 rounded-md text-sm box-border">
							<span asp-validation-for="Province" class="text-red-600 text-xs"></span>
						</div>
						
						<!-- Zip Code -->
						<div>
							<label asp-for="ZipCode" class="block mb-1.5 text-sm font-semibold text-gray-900">
								@Html.DisplayNameFor(m => m.ZipCode) <span class="text-red-600">*</span>
							</label>
							<input asp-for="ZipCode" type="text" required 
								   class="w-full py-2.5 px-3 border border-gray-300 rounded-md text-sm box-border">
							<span asp-validation-for="ZipCode" class="text-red-600 text-xs"></span>
						</div>
					</div>
				</div>
			</div>

			<!-- Emergency Contact Information Section -->
			<div class="bg-white py-8 mb-5 border border-gray-200 rounded-lg">
				<div class="max-w-[900px] mx-auto px-4">
					<h2 class="text-lg font-extrabold m-0 mb-6 text-gray-900">Section 4: Emergency Contact Information</h2>
					
					<div class="grid grid-cols-2 gap-5">
						<!-- Emergency First Name -->
						<div>
							<label asp-for="EmergencyFirstName" class="block mb-1.5 text-sm font-semibold text-gray-900">
								@Html.DisplayNameFor(m => m.EmergencyFirstName) <span class="text-red-600">*</span>
							</label>
							<input asp-for="EmergencyFirstName" type="text" required 
								   class="w-full py-2.5 px-3 border border-gray-300 rounded-md text-sm box-border">
							<span asp-validation-for="EmergencyFirstName" class="text-red-600 text-xs"></span>
						</div>
						
						<!-- Emergency Last Name -->
						<div>
							<label asp-for="EmergencyLastName" class="block mb-1.5 text-sm font-semibold text-gray-900">
								@Html.DisplayNameFor(m => m.EmergencyLastName) <span class="text-red-600">*</span>
							</label>
							<input asp-for="EmergencyLastName" type="text" required 
								   class="w-full py-2.5 px-3 border border-gray-300 rounded-md text-sm box-border">
							<span asp-validation-for="EmergencyLastName" class="text-red-600 text-xs"></span>
						</div>
						
						<!-- Emergency Middle Name -->
						<div>
							<label asp-for="EmergencyMiddleName" class="block mb-1.5 text-sm font-semibold text-gray-900">
								@Html.DisplayNameFor(m => m.EmergencyMiddleName)
							</label>
							<input asp-for="EmergencyMiddleName" type="text" 
								   class="w-full py-2.5 px-3 border border-gray-300 rounded-md text-sm box-border">
							<span asp-validation-for="EmergencyMiddleName" class="text-red-600 text-xs"></span>
						</div>
						
						<!-- Emergency Suffix -->
						<div>
							<label asp-for="EmergencySuffix" class="block mb-1.5 text-sm font-semibold text-gray-900">
								@Html.DisplayNameFor(m => m.EmergencySuffix)
							</label>
							<input asp-for="EmergencySuffix" type="text" 
								   class="w-full py-2.5 px-3 border border-gray-300 rounded-md text-sm box-border">
							<span asp-validation-for="EmergencySuffix" class="text-red-600 text-xs"></span>
						</div>
						
						<!-- Emergency Contact Number -->
						<div>
							<label asp-for="EmergencyContactNumber" class="block mb-1.5 text-sm font-semibold text-gray-900">
								@Html.DisplayNameFor(m => m.EmergencyContactNumber) <span class="text-red-600">*</span>
							</label>
							<input asp-for="EmergencyContactNumber" type="tel" required 
								   class="w-full py-2.5 px-3 border border-gray-300 rounded-md text-sm box-border">
							<span asp-validation-for="EmergencyContactNumber" class="text-red-600 text-xs"></span>
						</div>
						
						<!-- Relationship -->
						<div>
							<label asp-for="Relationship" class="block mb-1.5 text-sm font-semibold text-gray-900">
								@Html.DisplayNameFor(m => m.Relationship) <span class="text-red-600">*</span>
							</label>
							<select asp-for="Relationship" required 
									class="w-full py-2.5 px-3 border border-gray-300 rounded-md text-sm box-border bg-white">
								<option value="">Select Relationship</option>
								<option value="Spouse">Spouse</option>
								<option value="Parent">Parent</option>
								<option value="Sibling">Sibling</option>
								<option value="Child">Child</option>
								<option value="Guardian">Guardian</option>
								<option value="Friend">Friend</option>
								<option value="Other">Other</option>
							</select>
							<span asp-validation-for="Relationship" class="text-red-600 text-xs"></span>
						</div>
					</div>
				</div>
			</div>

			<!-- Action Buttons -->
			<div class="text-center mt-10">
				<button type="button" onclick="window.history.back()" 
						class="bg-gray-500 text-white py-3 px-6 border-none rounded-md text-sm font-semibold mr-3 cursor-pointer">
					Cancel
				</button>
				<button type="submit" 
						class="bg-[#337D58] text-white py-3 px-6 border-none rounded-md text-sm font-semibold cursor-pointer">
					Register Teacher
				</button>
			</div>
		</form>
	</div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
