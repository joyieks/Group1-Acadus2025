@model int

<div style="display:flex; flex-direction:column; gap:16px;">
    <a href="/Teacher/CourseGradebook/@Model" style="text-decoration:none;">
        <div style="background: linear-gradient(135deg, #73BAB1 0%, #DBAFF5 100%); border-radius:12px; padding:20px; text-align:center; color:#fff; cursor:pointer; transition:transform 0.3s;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
            <h4 style="margin:0; font-size:18px; font-weight:700;">Course Gradebook</h4>
            <p style="margin:8px 0 0 0; font-size:14px;">Manage student grades</p>
        </div>
    </a>
    <a href="/Teacher/CourseActivities/@Model" style="text-decoration:none;">
        <div style="background: linear-gradient(135deg, #73BAB1 0%, #DBAFF5 100%); border-radius:12px; padding:20px; text-align:center; color:#fff; cursor:pointer; transition:transform 0.3s;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
            <h4 style="margin:0; font-size:18px; font-weight:700;">Course Activities</h4>
            <p style="margin:8px 0 0 0; font-size:14px;">View and assign activities</p>
        </div>
    </a>
</div>
