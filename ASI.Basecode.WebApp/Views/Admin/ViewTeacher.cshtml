@{
    Layout = "~/Views/Shared/_AuthenticatedLayout.cshtml";
    ViewData["Title"] = "View Teacher";
}

<script src="https://cdn.tailwindcss.com"></script>

<!-- Hero Section -->
<section class="bg-[#E8F9E8] flex items-center justify-center text-center relative py-10">
    <a href="/Admin/Users" class="absolute top-5 left-5 bg-white text-emerald-600 border border-gray-300 rounded-lg py-2 px-4 font-semibold no-underline transition-colors hover:bg-gray-50 flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5"></path>
            <path d="M12 19l-7-7 7-7"></path>
        </svg>
        Back to Users
    </a>
    <div class="max-w-[1200px] mx-auto px-4">
        <p class="m-0 mb-1 text-gray-600 text-xl">User Management</p>
        <h1 class="text-5xl font-extrabold m-0 mb-1 text-gray-900">View Teacher</h1>
        <p class="m-0 mb-4 text-gray-600 text-lg">View detailed teacher information and course assignments.</p>
        <p class="m-0 text-gray-500 text-sm">Access comprehensive instructor profiles, contact details, and handled courses.</p>
    </div>
</section>

<!-- Main Content Section -->
<section class="bg-white py-10">
    <div class="max-w-[1200px] mx-auto px-4">
        <!-- Action Buttons -->
        <div class="flex justify-end gap-3 mb-6">
            <a href="@Url.Action("EditUser", "Admin", new { id = "456789" })" class="bg-emerald-600 text-white border-none rounded-md py-3 px-5 font-semibold no-underline">Edit Teacher</a>
            <button onclick="showReactivateModal()" id="reactivateBtn" class="hidden bg-emerald-600 text-white border-none rounded-md py-3 px-5 font-semibold cursor-pointer">Reactivate</button>
            <button onclick="showDeactivateModal()" id="deactivateBtn" class="bg-red-600 text-white border-none rounded-md py-3 px-5 font-semibold cursor-pointer">Deactivate</button>
        </div>

        <div class="grid gap-6" style="grid-template-columns: 3fr 5fr;">

            <!-- Left Column: Teacher Information -->
            <div>
                <div class="bg-gray-50 border border-gray-200 rounded-lg p-6">
                    <h3 class="m-0 mb-5 font-bold text-lg text-gray-900">Teacher Information</h3>

                    <!-- Teacher Name (Full Width) -->
                    <div class="mb-5">
                        <div class="text-2xl font-extrabold text-gray-900 mb-1">Dr. Sarah Johnson</div>
                        <div class="teacher-status text-gray-500 text-sm">Teacher • Active</div>
                    </div>

                    <!-- Profile Picture -->
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-16 h-16 rounded-full overflow-hidden border-2 border-emerald-100 bg-gray-200 grid place-items-center text-emerald-800 font-extrabold text-xl">
                            <img src="/img/acaduslogo.png" alt="Profile picture" class="w-full h-full object-cover" />
                        </div>
                        <div>
                            <div class="font-semibold text-gray-900">ID: 456789</div>
                            <div class="text-gray-500 text-sm">CCS Department</div>
                        </div>
                    </div>

                    <!-- Personal Information -->
                    <div class="mb-5">
                        <h4 class="text-base font-bold text-gray-900 m-0 mb-3 pb-2 border-b border-gray-200">Personal Information</h4>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">First Name</span>
                                <div class="text-sm text-gray-900 py-1.5">Sarah</div>
                            </div>
                            <div>
                                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Last Name</span>
                                <div class="text-sm text-gray-900 py-1.5">Johnson</div>
                            </div>
                            <div>
                                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Middle Name</span>
                                <div class="text-sm text-gray-900 py-1.5">Marie</div>
                            </div>
                            <div>
                                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Contact</span>
                                <div class="text-sm text-gray-900 py-1.5">+63 912 345 6787</div>
                            </div>
                            <div class="col-span-2">
                                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Email</span>
                                <div class="text-sm text-gray-900 py-1.5">sarah.johnson@example.com</div>
                            </div>
                        </div>
                    </div>

                    <!-- Professional Information -->
                    <div class="mb-5">
                        <h4 class="text-base font-bold text-gray-900 m-0 mb-3 pb-2 border-b border-gray-200">Professional Information</h4>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Department</span>
                                <div class="text-sm text-gray-900 py-1.5">Computer Science</div>
                            </div>
                        </div>
                    </div>

                    <!-- Address Information -->
                    <div>
                        <h4 class="text-base font-bold text-gray-900 m-0 mb-3 pb-2 border-b border-gray-200">Address Information</h4>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">House/Apt</span>
                                <div class="text-sm text-gray-900 py-1.5">456</div>
                            </div>
                            <div>
                                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Street</span>
                                <div class="text-sm text-gray-900 py-1.5">Oak Avenue</div>
                            </div>
                            <div>
                                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Barangay</span>
                                <div class="text-sm text-gray-900 py-1.5">Barangay 2</div>
                            </div>
                            <div>
                                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">City</span>
                                <div class="text-sm text-gray-900 py-1.5">Quezon City</div>
                            </div>
                            <div class="col-span-2">
                                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Province & Zip</span>
                                <div class="text-sm text-gray-900 py-1.5">Metro Manila, 1100</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Handled Courses -->
            <div>
                <div class="bg-gray-50 border border-gray-200 rounded-lg p-6">
                    <h3 class="m-0 mb-5 font-bold text-lg text-gray-900">Handled Courses</h3>

                    <!-- Teaching Statistics -->
                    <div class="bg-white border border-gray-200 rounded-lg p-5 mb-6 text-center">
                        <div class="text-sm text-gray-500 mb-2">Total Courses This Semester</div>
                        <div class="text-5xl font-extrabold text-emerald-600 mb-1">5</div>
                        <div class="text-sm text-gray-500">Active Teaching Load</div>
                    </div>

                    <!-- Handled Courses Table -->
                    <div class="mb-6">
                        <h4 class="text-base font-bold text-gray-900 m-0 mb-4">Current Semester Courses</h4>
                        <div class="rounded-lg overflow-hidden border border-gray-200">
                            <table class="w-full border-collapse">
                                <thead class="bg-emerald-600">
                                    <tr>
                                        <th class="py-3 px-4 text-left font-bold text-white">Course Code</th>
                                        <th class="py-3 px-4 text-left font-bold text-white">Course Name</th>
                                        <th class="py-3 px-4 text-left font-bold text-white">Schedule</th>
                                        <th class="py-3 px-4 text-left font-bold text-white">Enrolled</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="border-b border-gray-200">
                                        <td class="py-4 px-4 text-gray-900 font-medium">CS101</td>
                                        <td class="py-4 px-4 text-gray-900 font-medium">Introduction to Programming</td>
                                        <td class="py-4 px-4 text-gray-900">MWF 9:00-10:30 AM</td>
                                        <td class="py-4 px-4">
                                            <span class="bg-emerald-100 text-emerald-800 py-1 px-2 rounded text-sm font-semibold">35/40</span>
                                        </td>
                                    </tr>
                                    <tr class="bg-gray-50 border-b border-gray-200">
                                        <td class="py-4 px-4 text-gray-900 font-medium">CS102</td>
                                        <td class="py-4 px-4 text-gray-900 font-medium">Data Structures</td>
                                        <td class="py-4 px-4 text-gray-900">TTH 1:00-2:30 PM</td>
                                        <td class="py-4 px-4">
                                            <span class="bg-emerald-100 text-emerald-800 py-1 px-2 rounded text-sm font-semibold">28/35</span>
                                        </td>
                                    </tr>
                                    <tr class="border-b border-gray-200">
                                        <td class="py-4 px-4 text-gray-900 font-medium">CS201</td>
                                        <td class="py-4 px-4 text-gray-900 font-medium">Algorithms</td>
                                        <td class="py-4 px-4 text-gray-900">MWF 2:00-3:30 PM</td>
                                        <td class="py-4 px-4">
                                            <span class="bg-amber-100 text-amber-800 py-1 px-2 rounded text-sm font-semibold">22/30</span>
                                        </td>
                                    </tr>
                                    <tr class="bg-gray-50 border-b border-gray-200">
                                        <td class="py-4 px-4 text-gray-900 font-medium">CS301</td>
                                        <td class="py-4 px-4 text-gray-900 font-medium">Software Engineering</td>
                                        <td class="py-4 px-4 text-gray-900">TTH 9:00-10:30 AM</td>
                                        <td class="py-4 px-4">
                                            <span class="bg-emerald-100 text-emerald-800 py-1 px-2 rounded text-sm font-semibold">25/30</span>
                                        </td>
                                    </tr>
                                    <tr class="bg-gray-50">
                                        <td class="py-4 px-4 text-gray-900 font-medium">CS401</td>
                                        <td class="py-4 px-4 text-gray-900 font-medium">Advanced Programming</td>
                                        <td class="py-4 px-4 text-gray-900">MWF 10:00-11:30 AM</td>
                                        <td class="py-4 px-4">
                                            <span class="bg-amber-400 text-amber-900 py-1 px-2 rounded text-sm font-semibold">18/25</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Deactivate Modal -->
<div id="deactivateModal" class="hidden fixed top-0 left-0 w-full h-full bg-black/50 z-[1000] items-center justify-center">
    <div class="bg-white rounded-xl p-8 max-w-[400px] w-[90%] my-5 shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1),0_10px_10px_-5px_rgba(0,0,0,0.04)]">
        <div class="text-center mb-6">
            <div class="w-16 h-16 rounded-full bg-red-50 flex items-center justify-center mx-auto mb-4">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 m-0 mb-2">Deactivate Teacher</h3>
            <p class="text-gray-500 text-sm m-0">Are you sure you want to deactivate Dr. Sarah Johnson? This action will prevent them from accessing the system.</p>
        </div>
        <div class="flex gap-3">
            <button onclick="hideDeactivateModal()" class="flex-1 bg-gray-100 text-gray-700 border border-gray-300 rounded-md py-3 px-4 font-semibold cursor-pointer">Cancel</button>
            <button onclick="confirmDeactivate()" class="flex-1 bg-red-600 text-white border-none rounded-md py-3 px-4 font-semibold cursor-pointer">Deactivate</button>
        </div>
    </div>
</div>

<!-- Reactivate Modal -->
<div id="reactivateModal" class="hidden fixed top-0 left-0 w-full h-full bg-black/50 z-[1000] items-center justify-center">
    <div class="bg-white rounded-xl p-8 max-w-[400px] w-[90%] my-5 shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1),0_10px_10px_-5px_rgba(0,0,0,0.04)]">
        <div class="text-center mb-6">
            <div class="w-16 h-16 rounded-full bg-emerald-100 flex items-center justify-center mx-auto mb-4">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20,6 9,17 4,12"></polyline>
                </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 m-0 mb-2">Reactivate Teacher</h3>
            <p class="text-gray-500 text-sm m-0">Are you sure you want to reactivate Dr. Sarah Johnson? This will restore their access to the system.</p>
        </div>
        <div class="flex gap-3">
            <button onclick="hideReactivateModal()" class="flex-1 bg-gray-100 text-gray-700 border border-gray-300 rounded-md py-3 px-4 font-semibold cursor-pointer">Cancel</button>
            <button onclick="confirmReactivate()" class="flex-1 bg-emerald-600 text-white border-none rounded-md py-3 px-4 font-semibold cursor-pointer">Reactivate</button>
        </div>
    </div>
</div>

<script>
    function showDeactivateModal() {
        document.getElementById('deactivateModal').style.display = 'flex';
    }

    function hideDeactivateModal() {
        document.getElementById('deactivateModal').style.display = 'none';
    }

    function confirmDeactivate() {
        // TODO: Implement deactivate logic
        alert('Teacher deactivated successfully');
        hideDeactivateModal();
        // Update UI to show inactive status
        document.querySelector('.teacher-status').textContent = 'Teacher • Inactive';
        document.querySelector('.teacher-status').style.color = '#4b5563';
        document.getElementById('deactivateBtn').style.display = 'none';
        document.getElementById('reactivateBtn').style.display = 'inline-block';
    }

    function showReactivateModal() {
        document.getElementById('reactivateModal').style.display = 'flex';
    }

    function hideReactivateModal() {
        document.getElementById('reactivateModal').style.display = 'none';
    }

    function confirmReactivate() {
        // TODO: Implement reactivate logic
        alert('Teacher reactivated successfully');
        hideReactivateModal();
        // Update UI to show active status
        document.querySelector('.teacher-status').textContent = 'Teacher • Active';
        document.querySelector('.teacher-status').style.color = '#065f46';
        document.getElementById('reactivateBtn').style.display = 'none';
        document.getElementById('deactivateBtn').style.display = 'inline-block';
    }

    // Close modals when clicking outside
    window.onclick = function(event) {
        const deactivateModal = document.getElementById('deactivateModal');
        const reactivateModal = document.getElementById('reactivateModal');
        
        if (event.target === deactivateModal) {
            hideDeactivateModal();
        }
        if (event.target === reactivateModal) {
            hideReactivateModal();
        }
    }
</script>