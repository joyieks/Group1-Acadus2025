@model ASI.Basecode.Data.Models.SupabaseUserNew
@{
    Layout = null;
}
<!-- Edit User Form - Uses SupabaseUserNew model -->

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit User</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        }

        @@keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @@keyframes slideUp {
            from { transform: translateY(30px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
    </style>
</head>
<body>
    <div class="fixed top-0 left-0 w-full h-full bg-black/50 backdrop-blur-lg flex items-center justify-center z-[1000] animate-[fadeIn_0.3s_ease] overflow-y-auto p-5" onclick="if(event.target === this) window.history.back()">
        <div class="bg-white rounded-2xl w-full max-w-[900px] max-h-[90vh] overflow-y-auto shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1)] animate-[slideUp_0.3s_ease] my-auto" onclick="event.stopPropagation()">
            <!-- Header -->
            <div class="bg-[#E8F9E8] py-6 px-8 rounded-t-2xl flex justify-between items-center border-b-2 border-emerald-200">
                <h2 class="text-2xl font-extrabold text-gray-900 m-0">Edit User</h2>
                <button type="button" onclick="window.history.back()" class="bg-transparent border-none text-[28px] text-gray-500 cursor-pointer w-8 h-8 rounded-md transition-all duration-200">&times;</button>
            </div>

            <!-- ✅ FORM TAG WITH PROPER BINDINGS -->
            <form asp-action="EditUser" asp-controller="Admin" method="post" id="editUserForm">
                @Html.AntiForgeryToken()
                
                <!-- ✅ CRITICAL: HIDDEN FIELD FOR USER ID -->
                <input type="hidden" asp-for="Id" />

                <!-- Body -->
                <div class="p-8 bg-gray-50">
                    
                    <!-- Section 1: Personal Information -->
                    <div class="bg-white rounded-xl p-8 shadow-[0_1px_3px_rgba(0,0,0,0.1)] mb-6">
                        <h3 class="text-lg font-extrabold text-gray-900 m-0 mb-6">Section 1: Personal Information</h3>
                        <div class="grid grid-cols-2 gap-5">
                            <div>
                                <label class="block mb-1.5 text-sm font-semibold text-gray-900">ID Number</label>
                                <input asp-for="UserDisplayId" readonly class="w-full py-[10px] px-3 border border-gray-300 rounded-md text-sm bg-gray-100 text-gray-500">
                            </div>
                            <div>
                                <label class="block mb-1.5 text-sm font-semibold text-gray-900">Status <span class="text-red-600">*</span></label>
                                <select asp-for="IsActive" required class="w-full py-[10px] px-3 border border-gray-300 rounded-md text-sm">
                                    <option value="true">Active</option>
                                    <option value="false">Inactive</option>
                                </select>
                            </div>
                            <div>
                                <label class="block mb-1.5 text-sm font-semibold text-gray-900">First name <span class="text-red-600">*</span></label>
                                <input asp-for="FirstName" required class="w-full py-[10px] px-3 border border-gray-300 rounded-md text-sm">
                            </div>
                            <div>
                                <label class="block mb-1.5 text-sm font-semibold text-gray-900">Last name <span class="text-red-600">*</span></label>
                                <input asp-for="LastName" required class="w-full py-[10px] px-3 border border-gray-300 rounded-md text-sm">
                            </div>
                            <div>
                                <label class="block mb-1.5 text-sm font-semibold text-gray-900">Middle name</label>
                                <input asp-for="MiddleName" class="w-full py-[10px] px-3 border border-gray-300 rounded-md text-sm">
                            </div>
                            <div>
                                <label class="block mb-1.5 text-sm font-semibold text-gray-900">Suffix</label>
                                <input asp-for="Suffix" class="w-full py-[10px] px-3 border border-gray-300 rounded-md text-sm">
                            </div>
                            <div>
                                <label class="block mb-1.5 text-sm font-semibold text-gray-900">Role <span class="text-red-600">*</span></label>
                                <input type="text" value="@ViewBag.Role" readonly class="w-full py-[10px] px-3 border border-gray-300 rounded-md text-sm bg-gray-100 text-gray-500">
                            </div>
                            <div>
                                <label class="block mb-1.5 text-sm font-semibold text-gray-900">Department/Office</label>
                                <input type="text" name="Department" value="@ViewBag.Department" class="w-full py-[10px] px-3 border border-gray-300 rounded-md text-sm">
                            </div>
                            <div>
                                <label class="block mb-1.5 text-sm font-semibold text-gray-900">Contact Number <span class="text-red-600">*</span></label>
                                <input asp-for="ContactNumber" required class="w-full py-[10px] px-3 border border-gray-300 rounded-md text-sm">
                            </div>
                            <div>
                                <label class="block mb-1.5 text-sm font-semibold text-gray-900">Email <span class="text-red-600">*</span></label>
                                <input asp-for="Email" required class="w-full py-[10px] px-3 border border-gray-300 rounded-md text-sm">
                            </div>
                        </div>
                    </div>

                    <!-- Section 2: Address Information (Optional - not saved yet) -->
                    <div class="bg-[#E8F9E8] rounded-xl p-8 mb-6">
                        <h3 class="text-lg font-extrabold text-gray-900 m-0 mb-6">Section 2: Address Information</h3>
                        <div class="grid grid-cols-1 gap-5">
                            <div>
                                <label class="block mb-1.5 text-sm font-semibold text-gray-900">House/Apt number</label>
                                <input type="text" name="HouseNumber" class="w-full py-[10px] px-3 border border-gray-300 rounded-md text-sm bg-white">
                            </div>
                            <div>
                                <label class="block mb-1.5 text-sm font-semibold text-gray-900">Street name</label>
                                <input type="text" name="StreetName" class="w-full py-[10px] px-3 border border-gray-300 rounded-md text-sm bg-white">
                            </div>
                            <div>
                                <label class="block mb-1.5 text-sm font-semibold text-gray-900">Subdivision/Bldg.</label>
                                <input type="text" name="Subdivision" class="w-full py-[10px] px-3 border border-gray-300 rounded-md text-sm bg-white">
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-5 mt-5">
                            <div>
                                <label class="block mb-1.5 text-sm font-semibold text-gray-900">Barangay</label>
                                <input type="text" name="Barangay" class="w-full py-[10px] px-3 border border-gray-300 rounded-md text-sm bg-white">
                            </div>
                            <div>
                                <label class="block mb-1.5 text-sm font-semibold text-gray-900">City</label>
                                <input type="text" name="City" class="w-full py-[10px] px-3 border border-gray-300 rounded-md text-sm bg-white">
                            </div>
                            <div>
                                <label class="block mb-1.5 text-sm font-semibold text-gray-900">Province</label>
                                <input type="text" name="Province" class="w-full py-[10px] px-3 border border-gray-300 rounded-md text-sm bg-white">
                            </div>
                            <div>
                                <label class="block mb-1.5 text-sm font-semibold text-gray-900">Zip Code</label>
                                <input type="text" name="ZipCode" class="w-full py-[10px] px-3 border border-gray-300 rounded-md text-sm bg-white">
                            </div>
                        </div>
                    </div>

                    <!-- Section 3: Emergency Contact (Optional - not saved yet) -->
                    <div class="bg-white rounded-xl p-8 shadow-[0_1px_3px_rgba(0,0,0,0.1)] mb-6">
                        <h3 class="text-lg font-extrabold text-gray-900 m-0 mb-6">Section 3: Emergency Contact Information</h3>
                        <div class="grid grid-cols-2 gap-5">
                            <div>
                                <label class="block mb-1.5 text-sm font-semibold text-gray-900">First name</label>
                                <input type="text" name="EmergencyFirstName" class="w-full py-[10px] px-3 border border-gray-300 rounded-md text-sm">
                            </div>
                            <div>
                                <label class="block mb-1.5 text-sm font-semibold text-gray-900">Last name</label>
                                <input type="text" name="EmergencyLastName" class="w-full py-[10px] px-3 border border-gray-300 rounded-md text-sm">
                            </div>
                            <div>
                                <label class="block mb-1.5 text-sm font-semibold text-gray-900">Middle name</label>
                                <input type="text" name="EmergencyMiddleName" class="w-full py-[10px] px-3 border border-gray-300 rounded-md text-sm">
                            </div>
                            <div>
                                <label class="block mb-1.5 text-sm font-semibold text-gray-900">Suffix</label>
                                <input type="text" name="EmergencySuffix" class="w-full py-[10px] px-3 border border-gray-300 rounded-md text-sm">
                            </div>
                            <div>
                                <label class="block mb-1.5 text-sm font-semibold text-gray-900">Contact Number</label>
                                <input type="text" name="EmergencyContactNumber" class="w-full py-[10px] px-3 border border-gray-300 rounded-md text-sm">
                            </div>
                            <div>
                                <label class="block mb-1.5 text-sm font-semibold text-gray-900">Relationship</label>
                                <input type="text" name="Relationship" class="w-full py-[10px] px-3 border border-gray-300 rounded-md text-sm">
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Footer -->
                <div class="py-5 px-8 bg-gray-50 border-t border-gray-200 rounded-b-2xl flex justify-center gap-4">
                    <button type="button" onclick="window.history.back()" class="py-3 px-8 rounded-md text-sm font-semibold cursor-pointer bg-white text-gray-600 border border-gray-300">Cancel</button>
                    <button type="button" onclick="showConfirmation()" class="py-3 px-8 rounded-md text-sm font-semibold cursor-pointer bg-emerald-600 text-white border-none">Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Confirmation Modal -->
    <div id="confirmationModal" class="hidden fixed top-0 left-0 w-full h-full bg-black/60 backdrop-blur-sm items-center justify-center z-[2000] animate-[fadeIn_0.2s_ease]">
        <div class="bg-white rounded-xl p-8 max-w-[400px] w-[90%] shadow-[0_20px_25px_-5px_rgba(0,0,0,0.2)] animate-[slideUp_0.3s_ease] text-center">
            <div class="w-16 h-16 bg-[#E8F9E8] rounded-full flex items-center justify-center mx-auto mb-5 text-[32px]">✓</div>
            <h3 class="text-xl font-extrabold text-gray-900 mb-3">Save Changes?</h3>
            <p class="text-sm text-gray-500 mb-6">Are you sure you want to save the changes to this user's information?</p>
            <div class="flex gap-3 justify-center">
                <button onclick="closeConfirmation()" class="py-[10px] px-6 rounded-md text-sm font-semibold cursor-pointer bg-white text-gray-600 border border-gray-300">Cancel</button>
                <button onclick="confirmSave()" class="py-[10px] px-6 rounded-md text-sm font-semibold cursor-pointer bg-emerald-600 text-white border-none">Yes, Save</button>
            </div>
        </div>
    </div>

    <script>
        function showConfirmation() {
            const modal = document.getElementById('confirmationModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeConfirmation() {
            const modal = document.getElementById('confirmationModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function confirmSave() {
            // ✅ CRITICAL: Submit the form
            document.getElementById('editUserForm').submit();
        }

        // Close on ESC key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                const confirmModal = document.getElementById('confirmationModal');
                if (!confirmModal.classList.contains('hidden')) {
                    closeConfirmation();
                } else {
                    window.history.back();
                }
            }
        });

        // Close confirmation modal when clicking outside
        document.getElementById('confirmationModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeConfirmation();
            }
        });
    </script>
</body>
</html>

