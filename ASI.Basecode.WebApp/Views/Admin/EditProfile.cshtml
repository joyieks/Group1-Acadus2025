@{
    Layout = "~/Views/Shared/_AuthenticatedLayout.cshtml";
    ViewData["Title"] = "Edit Profile";
}

<script src="https://cdn.tailwindcss.com"></script>

<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-[800px] mx-auto px-4">
        
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-[32px] font-extrabold text-gray-900 m-0 mb-2">Edit Profile</h1>
            <p class="text-gray-500 text-base m-0">Update your personal information and settings</p>
        </div>

        <form asp-controller="Admin" asp-action="EditProfile" method="post">
            
            <!-- Profile Picture Section -->
            <section class="bg-[#E8F9E8] p-8 rounded-xl mb-6">
                <h2 class="text-xl font-bold text-gray-900 m-0 mb-6">Profile Picture</h2>
                
                <div class="flex items-center gap-6">
                    <!-- Current Profile Picture -->
                    <div class="relative">
                        <div id="profilePicPreview" class="w-[120px] h-[120px] rounded-full bg-gray-300 flex items-center justify-center overflow-hidden border-4 border-white shadow-md">
                            <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </div>
                    </div>
                    
                    <div class="flex-1">
                        <div class="mb-3">
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">Upload New Picture</label>
                            <input type="file" id="profilePicInput" accept="image/*" class="block py-[10px] px-3 border-2 border-dashed border-gray-300 rounded-lg bg-white w-full cursor-pointer text-sm"/>
                        </div>
                        <p class="text-gray-500 text-[13px] m-0">JPG, PNG or GIF. Max size 2MB. Recommended 400x400px.</p>
                    </div>
                </div>
            </section>

            <!-- Personal Information Section -->
            <section class="bg-white p-8 rounded-xl mb-6 shadow-[0_1px_3px_rgba(0,0,0,0.1)]">
                <h2 class="text-xl font-bold text-gray-900 m-0 mb-6">Personal Information</h2>
                
                <div class="grid grid-cols-2 gap-5 mb-5">
                    <div>
                        <label class="block font-semibold text-gray-700 mb-2 text-sm">First Name *</label>
                        <input type="text" name="FirstName" value="Admin" required class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                    </div>
                    <div>
                        <label class="block font-semibold text-gray-700 mb-2 text-sm">Last Name *</label>
                        <input type="text" name="LastName" value="User" required class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-5 mb-5">
                    <div>
                        <label class="block font-semibold text-gray-700 mb-2 text-sm">Email Address *</label>
                        <input type="email" name="Email" value="admin@gmail.com" required class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                    </div>
                    <div>
                        <label class="block font-semibold text-gray-700 mb-2 text-sm">Phone Number *</label>
                        <input type="tel" name="Phone" value="+63 912 345 6789" required class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                    </div>
                </div>

                <div class="mb-5">
                    <label class="block font-semibold text-gray-700 mb-2 text-sm">Date of Birth *</label>
                    <input type="date" name="DateOfBirth" value="1990-01-15" required class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                </div>

                <div>
                    <label class="block font-semibold text-gray-700 mb-2 text-sm">Bio</label>
                    <textarea name="Bio" rows="4" placeholder="Tell us about yourself..." class="w-full p-3 border border-gray-300 rounded-lg text-sm resize-y">System Administrator with extensive experience in educational technology.</textarea>
                </div>
            </section>

            <!-- Address Information Section -->
            <section class="bg-[#E8F9E8] p-8 rounded-xl mb-6">
                <h2 class="text-xl font-bold text-gray-900 m-0 mb-6">Address Information</h2>
                
                <div class="mb-5">
                    <label class="block font-semibold text-gray-700 mb-2 text-sm">Street Address *</label>
                    <input type="text" name="Street" value="123 Main Street" required class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                </div>

                <div class="grid grid-cols-2 gap-5 mb-5">
                    <div>
                        <label class="block font-semibold text-gray-700 mb-2 text-sm">City *</label>
                        <input type="text" name="City" value="Manila" required class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                    </div>
                    <div>
                        <label class="block font-semibold text-gray-700 mb-2 text-sm">Province/State *</label>
                        <input type="text" name="Province" value="Metro Manila" required class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-5">
                    <div>
                        <label class="block font-semibold text-gray-700 mb-2 text-sm">Postal Code *</label>
                        <input type="text" name="PostalCode" value="1000" required class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                    </div>
                    <div>
                        <label class="block font-semibold text-gray-700 mb-2 text-sm">Country *</label>
                        <input type="text" name="Country" value="Philippines" required class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                    </div>
                </div>
            </section>

            <!-- Security Settings Section -->
            <section class="bg-white p-8 rounded-xl mb-8 shadow-[0_1px_3px_rgba(0,0,0,0.1)]">
                <h2 class="text-xl font-bold text-gray-900 m-0 mb-2">Security Settings</h2>
                <p class="text-gray-500 text-sm m-0 mb-6">Leave password fields empty if you don't want to change your password</p>
                
                <div class="mb-5">
                    <label class="block font-semibold text-gray-700 mb-2 text-sm">Current Password</label>
                    <input type="password" name="CurrentPassword" placeholder="Enter current password" class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                </div>

                <div class="grid grid-cols-2 gap-5">
                    <div>
                        <label class="block font-semibold text-gray-700 mb-2 text-sm">New Password</label>
                        <input type="password" name="NewPassword" placeholder="Enter new password" class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                    </div>
                    <div>
                        <label class="block font-semibold text-gray-700 mb-2 text-sm">Confirm New Password</label>
                        <input type="password" name="ConfirmPassword" placeholder="Confirm new password" class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                    </div>
                </div>
            </section>

            <!-- Action Buttons -->
            <div class="flex gap-4 justify-end">
                <button type="button" onclick="window.history.back()" class="py-[14px] px-8 rounded-lg text-sm font-semibold cursor-pointer bg-white text-gray-700 border-2 border-gray-300">
                    Cancel
                </button>
                <button type="button" onclick="showSaveConfirmation()" class="py-[14px] px-8 rounded-lg text-sm font-semibold cursor-pointer bg-emerald-600 text-white border-none shadow-[0_2px_4px_rgba(5,150,105,0.2)]">
                    Save Changes
                </button>
            </div>

        </form>

    </div>
</div>

<!-- Confirmation Modal -->
<div id="confirmationModal" class="confirmation-modal">
    <div class="confirmation-box" id="confirmationBox">
        <!-- Content will be dynamically inserted -->
    </div>
</div>

<style>
    .confirmation-modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(4px);
        z-index: 10000;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.2s ease;
    }

    .confirmation-modal.show {
        display: flex;
        opacity: 1;
    }

    .confirmation-box {
        background: white;
        border-radius: 16px;
        padding: 32px;
        max-width: 400px;
        width: 90%;
        text-align: center;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        transform: scale(0.9);
        transition: transform 0.2s ease;
    }

    .confirmation-modal.show .confirmation-box {
        transform: scale(1);
    }

    .confirmation-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        font-size: 32px;
        font-weight: bold;
        background: #d1fae5;
        color: #059669;
    }

    .confirmation-title {
        font-size: 20px;
        font-weight: 700;
        color: #111827;
        margin: 0 0 12px 0;
    }

    .confirmation-message {
        font-size: 14px;
        color: #6b7280;
        margin: 0 0 24px 0;
        line-height: 1.5;
    }

    .confirmation-buttons {
        display: flex;
        gap: 12px;
        justify-content: center;
    }
</style>

<script>
    // Profile picture preview
    document.getElementById('profilePicInput').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(event) {
                document.getElementById('profilePicPreview').innerHTML = `
                    <img src="${event.target.result}" style="width:100%; height:100%; object-fit:cover;"/>
                `;
            };
            reader.readAsDataURL(file);
        }
    });

    function showSaveConfirmation() {
        const modal = document.getElementById('confirmationModal');
        const box = document.getElementById('confirmationBox');
        
        box.innerHTML = `
            <div class="confirmation-icon">✓</div>
            <h3 class="confirmation-title">Save Changes?</h3>
            <p class="confirmation-message">Are you sure you want to update your profile information?</p>
            <div class="confirmation-buttons">
                <button onclick="closeConfirmation()" style="padding:10px 24px; border-radius:6px; font-size:14px; font-weight:600; cursor:pointer; background:#ffffff; color:#4b5563; border:1px solid #d1d5db;">Cancel</button>
                <button onclick="confirmSave()" style="padding:10px 24px; border-radius:6px; font-size:14px; font-weight:600; cursor:pointer; background:#059669; color:#ffffff; border:none;">Yes, Save</button>
            </div>
        `;
        
        modal.classList.add('show');
    }

    function closeConfirmation() {
        document.getElementById('confirmationModal').classList.remove('show');
    }

    function confirmSave() {
        // TODO: Implement actual save functionality
        const modal = document.getElementById('confirmationModal');
        const box = document.getElementById('confirmationBox');
        
        box.innerHTML = `
            <div class="confirmation-icon">✓</div>
            <h3 class="confirmation-title">Profile Updated!</h3>
            <p class="confirmation-message">Your profile has been updated successfully.</p>
            <button onclick="closeConfirmation()" style="padding:10px 24px; border-radius:6px; font-size:14px; font-weight:600; cursor:pointer; background:#059669; color:#ffffff; border:none; margin-top:8px;">Close</button>
        `;
    }

    // Close on ESC key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeConfirmation();
        }
    });

    // Close modal when clicking outside
    document.getElementById('confirmationModal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeConfirmation();
        }
    });
</script>

