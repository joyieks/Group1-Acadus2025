@model ASI.Basecode.Data.Models.SupabaseUserNew
@{
    Layout = "~/Views/Shared/_AuthenticatedLayout.cshtml";
    ViewData["Title"] = "View User";
    var role = ViewBag.Role ?? "Unknown";
    var department = ViewBag.Department ?? "Not Assigned";
    var isStudent = role.Equals("Student", StringComparison.OrdinalIgnoreCase);
    var isTeacher = role.Equals("Teacher", StringComparison.OrdinalIgnoreCase) || role.Equals("Instructor", StringComparison.OrdinalIgnoreCase);
    var gridColumns = (isStudent || isTeacher) ? "3fr 5fr" : "1fr";
    var isActive = Model?.IsActive ?? true;
    var buttonColor = isActive ? "#dc2626" : "#059669";
    var buttonText = isActive ? "Deactivate" : "Reactivate";
    var statusBadge = isActive ? "Active" : "Inactive";
    var userTypeLabel = isStudent ? "Student" : isTeacher ? "Teacher" : "User";
    var infoSectionTitle = isStudent ? "Student Information" : isTeacher ? "Teacher Information" : "User Information";
}

<script src="https://cdn.tailwindcss.com"></script>

<!-- Hero Section -->
<section class="bg-[#E8F9E8] flex items-center justify-center text-center relative py-10">
    <a href="/Admin/Users" class="absolute top-5 left-5 bg-white text-emerald-600 border border-gray-300 rounded-lg py-2 px-4 font-semibold no-underline transition-colors hover:bg-gray-50 flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5"></path>
            <path d="M12 19l-7-7 7-7"></path>
        </svg>
        Back to Users
    </a>
    <div class="max-w-[1200px] mx-auto px-4">
        <p class="m-0 mb-1 text-gray-600 text-xl">User Management</p>
        <h1 class="text-5xl font-extrabold m-0 mb-1 text-gray-900">View User</h1>
        <p class="m-0 mb-4 text-gray-600 text-lg">View detailed user information.</p>
        <p class="m-0 text-gray-500 text-sm">Access comprehensive user profiles and contact details.</p>
    </div>
</section>

<!-- Main Content Section -->
<section class="bg-white py-10">
    <div class="max-w-[1200px] mx-auto px-4">
        <!-- Action Buttons -->
        <div class="flex justify-end gap-3 mb-6">
            <a href="@Url.Action("EditUser", "Admin", new { id = Model.Id })" class="bg-emerald-600 text-white border-none rounded-md py-3 px-5 font-semibold no-underline">Edit @userTypeLabel</a>
            <button id="actionButton" onclick="openConfirmationModal()" style="background:@buttonColor;" class="text-white border-none rounded-md py-3 px-5 font-semibold cursor-pointer">@buttonText</button>
        </div>

        <div class="grid gap-6" style="grid-template-columns: @gridColumns;">

            <!-- Left Column: User Information -->
            <div>
                <div class="bg-gray-50 border border-gray-200 rounded-lg p-6">
                    <h3 class="m-0 mb-5 font-bold text-lg text-gray-900">@infoSectionTitle</h3>

                    <!-- User Name -->
                    <div class="mb-5">
                        <div class="text-2xl font-extrabold text-gray-900 mb-1">@Model.FirstName @Model.LastName</div>
                        <div class="text-gray-500 text-sm">@role • <span id="statusBadge">@statusBadge</span></div>
                    </div>

                    <!-- Profile Picture -->
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-16 h-16 rounded-full overflow-hidden border-2 border-emerald-100 bg-gray-200 grid place-items-center">
                            <img src="/img/acaduslogo.png" alt="Profile" class="w-full h-full object-cover" />
                        </div>
                        <div>
                            <div class="font-semibold text-gray-900">ID: @(Model.UserDisplayId ?? Model.Id.ToString())</div>
                            <div class="text-gray-500 text-sm">@department</div>
                        </div>
                    </div>

                    <!-- Personal Information -->
                    <div class="mb-5">
                        <h4 class="text-base font-bold text-gray-900 m-0 mb-3 pb-2 border-b border-gray-200">Personal Information</h4>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <span class="text-xs font-semibold text-gray-500 uppercase">First Name</span>
                                <div class="text-sm text-gray-900 py-1.5">@(Model.FirstName ?? "Not provided")</div>
                            </div>
                            <div>
                                <span class="text-xs font-semibold text-gray-500 uppercase">Last Name</span>
                                <div class="text-sm text-gray-900 py-1.5">@(Model.LastName ?? "Not provided")</div>
                            </div>
                            <div>
                                <span class="text-xs font-semibold text-gray-500 uppercase">Middle Name</span>
                                <div class="text-sm text-gray-900 py-1.5">@(Model.MiddleName ?? "N/A")</div>
                            </div>
                            <div>
                                <span class="text-xs font-semibold text-gray-500 uppercase">Contact</span>
                                <div class="text-sm text-gray-900 py-1.5">@(Model.ContactNumber ?? "Not provided")</div>
                            </div>
                            <div class="col-span-2">
                                <span class="text-xs font-semibold text-gray-500 uppercase">Email</span>
                                <div class="text-sm text-gray-900 py-1.5">@(Model.Email ?? "Not provided")</div>
                            </div>
                        </div>
                    </div>

                    <!-- Address Information -->
                    <div class="mb-5">
                        <h4 class="text-base font-bold text-gray-900 m-0 mb-3 pb-2 border-b border-gray-200">Address Information</h4>
                        @if (!string.IsNullOrEmpty(Model.Address))
                        {
                            <div class="text-sm text-gray-900">@Model.Address</div>
                        }
                        else
                        {
                            <div class="text-sm text-gray-500 italic">Address not provided</div>
                        }
                    </div>

                    <!-- Emergency Contact -->
                    <div>
                        <h4 class="text-base font-bold text-gray-900 m-0 mb-3 pb-2 border-b border-gray-200">Emergency Contact</h4>
                        @if (!string.IsNullOrEmpty(Model.EmergencyContact))
                        {
                            <div class="text-sm text-gray-900">@Model.EmergencyContact</div>
                        }
                        else
                        {
                            <div class="text-sm text-gray-500 italic">Emergency contact not provided</div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column: Role-specific content -->
            @if (isStudent)
            {
                <!-- Student: Academic Performance -->
                <div>
                    <div class="bg-gray-50 border border-gray-200 rounded-lg p-6">
                        <h3 class="m-0 mb-5 font-bold text-lg text-gray-900">Academic Performance</h3>
                        @{
                            var academicPerformance = ViewBag.AcademicPerformance as List<ASI.Basecode.WebApp.Controllers.AdminController.AcademicPerformanceItem>;
                        }
                        @if (academicPerformance != null && academicPerformance.Any())
                        {
                            <div class="rounded-lg overflow-hidden border border-gray-200">
                                <table class="w-full border-collapse">
                                    <thead class="bg-emerald-600">
                                        <tr>
                                            <th class="py-3 px-4 text-left font-bold text-white text-sm">Course Code</th>
                                            <th class="py-3 px-4 text-left font-bold text-white text-sm">Course Title</th>
                                            <th class="py-3 px-4 text-center font-bold text-white text-sm">Overall Grade</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in academicPerformance)
                                        {
                                            <tr class="bg-white border-b border-gray-200">
                                                <td class="py-3 px-4 text-gray-900 font-semibold text-sm">@item.CourseCode</td>
                                                <td class="py-3 px-4 text-gray-500 text-sm">@item.CourseTitle</td>
                                                <td class="py-3 px-4 text-center text-emerald-600 font-bold text-sm">
                                                    @if (item.OverallPercentage > 0)
                                                    {
                                                        <span>@item.OverallPercentage.ToString("0.0")%</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-gray-500">No grades yet</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="py-8 px-4 text-center text-gray-500">
                                No courses enrolled yet
                            </div>
                        }
                    </div>
                </div>
            }
            else if (isTeacher)
            {
                <!-- Teacher: Handled Courses -->
                <div>
                    <div class="bg-gray-50 border border-gray-200 rounded-lg p-6">
                        <h3 class="m-0 mb-5 font-bold text-lg text-gray-900">Handled Courses</h3>
                        @{
                            var handledCourses = ViewBag.HandledCourses as IEnumerable<dynamic>;
                            var totalCourses = handledCourses?.Count() ?? 0;
                        }

                        <!-- Total Courses Card -->
                        <div class="bg-white border border-gray-200 rounded-lg p-6 mb-6 text-center">
                            <div class="text-sm text-gray-500 mb-3">Total Courses This Semester</div>
                            <div class="text-6xl font-extrabold text-emerald-600 mb-2 leading-none">@totalCourses</div>
                            <div class="text-sm text-gray-500">Active Teaching Load</div>
                        </div>

                        <!-- Current Semester Courses -->
                        <div>
                            <h4 class="text-base font-bold text-gray-900 m-0 mb-4">Current Semester Courses</h4>
                            <div class="rounded-lg overflow-hidden border border-gray-200">
                                <table class="w-full border-collapse">
                                    <thead class="bg-emerald-600">
                                        <tr>
                                            <th class="py-3 px-4 text-left font-bold text-white text-sm">Course Code</th>
                                            <th class="py-3 px-4 text-left font-bold text-white text-sm">Course Name</th>
                                            <th class="py-3 px-4 text-center font-bold text-white text-sm">Enrolled</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (handledCourses != null && handledCourses.Any())
                                        {
                                            @foreach (var course in handledCourses)
                                            {
                                                <tr class="bg-white border-b border-gray-200">
                                                    <td class="py-3 px-4 text-gray-900 font-semibold text-sm">@course.CourseCode</td>
                                                    <td class="py-3 px-4 text-gray-500 text-sm">@course.CourseName</td>
                                                    <td class="py-3 px-4 text-center text-emerald-600 font-bold text-sm">@course.EnrolledCount</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="3" class="py-8 px-4 text-center text-gray-500 bg-white">
                                                    No courses assigned yet
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Deactivate Modal -->
<div id="deactivateModal" class="hidden fixed top-0 left-0 w-full h-full bg-black/50 z-[1000] items-center justify-center">
    <div class="bg-white rounded-xl p-8 max-w-[400px] w-[90%] my-5 shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1),0_10px_10px_-5px_rgba(0,0,0,0.04)]">
        <div class="text-center mb-6">
            <div class="w-16 h-16 rounded-full bg-red-50 flex items-center justify-center mx-auto mb-4">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 m-0 mb-2">Deactivate User</h3>
            <p class="text-gray-500 text-sm m-0" id="deactivateModalText">Are you sure you want to deactivate this user? This action will prevent them from accessing the system.</p>
        </div>
        <div class="flex gap-3">
            <button onclick="hideModals()" class="flex-1 bg-gray-100 text-gray-700 border border-gray-300 rounded-md py-3 px-4 font-semibold cursor-pointer">Cancel</button>
            <button onclick="performUserStatusUpdate(false)" class="flex-1 bg-red-600 text-white border-none rounded-md py-3 px-4 font-semibold cursor-pointer">Deactivate</button>
        </div>
    </div>
</div>

<!-- Reactivate Modal -->
<div id="reactivateModal" class="hidden fixed top-0 left-0 w-full h-full bg-black/50 z-[1000] items-center justify-center">
    <div class="bg-white rounded-xl p-8 max-w-[400px] w-[90%] my-5 shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1),0_10px_10px_-5px_rgba(0,0,0,0.04)]">
        <div class="text-center mb-6">
            <div class="w-16 h-16 rounded-full bg-emerald-100 flex items-center justify-center mx-auto mb-4">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20,6 9,17 4,12"></polyline>
                </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 m-0 mb-2">Reactivate User</h3>
            <p class="text-gray-500 text-sm m-0" id="reactivateModalText">Are you sure you want to reactivate this user? This will restore their access to the system.</p>
        </div>
        <div class="flex gap-3">
            <button onclick="hideModals()" class="flex-1 bg-gray-100 text-gray-700 border border-gray-300 rounded-md py-3 px-4 font-semibold cursor-pointer">Cancel</button>
            <button onclick="performUserStatusUpdate(true)" class="flex-1 bg-emerald-600 text-white border-none rounded-md py-3 px-4 font-semibold cursor-pointer">Reactivate</button>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div id="successModal" class="hidden fixed top-0 left-0 w-full h-full bg-black/50 z-[1000] items-center justify-center">
    <div class="bg-white rounded-xl p-8 max-w-[400px] w-[90%] my-5 shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1),0_10px_10px_-5px_rgba(0,0,0,0.04)]">
        <div class="text-center mb-6">
            <div class="w-16 h-16 rounded-full bg-emerald-100 flex items-center justify-center mx-auto mb-4">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20,6 9,17 4,12"></polyline>
                </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 m-0 mb-2">Success</h3>
            <p class="text-gray-500 text-sm m-0" id="successModalText">Operation completed successfully.</p>
        </div>
        <div class="flex justify-center">
            <button onclick="closeSuccessModal()" class="flex-1 bg-emerald-600 text-white border-none rounded-md py-3 px-4 font-semibold cursor-pointer">Close</button>
        </div>
    </div>
</div>

<script>
    const userId = '@Model.UserTypeId';
    const userName = '@Html.Raw(Model.FirstName) @Html.Raw(Model.LastName)';
    // We'll rely on the button text/color to know current state for toggling
    // But for robustness, let's track the current state in a variable that updates
    let isCurrentlyActive = @Json.Serialize(Model.IsActive == true);

    function openConfirmationModal() {
        if (isCurrentlyActive) {
            // Show Deactivate Modal
            document.getElementById('deactivateModalText').textContent = `Are you sure you want to deactivate ${userName}? This action will prevent them from accessing the system.`;
            document.getElementById('deactivateModal').style.display = 'flex';
        } else {
            // Show Reactivate Modal
            document.getElementById('reactivateModalText').textContent = `Are you sure you want to reactivate ${userName}? This will restore their access to the system.`;
            document.getElementById('reactivateModal').style.display = 'flex';
        }
    }

    function hideModals() {
        document.getElementById('deactivateModal').style.display = 'none';
        document.getElementById('reactivateModal').style.display = 'none';
    }

    function performUserStatusUpdate(newStatus) {
        hideModals();

        const actionButton = document.getElementById('actionButton');
        const statusBadge = document.getElementById('statusBadge');
        const originalButtonText = actionButton.innerText;
        const originalButtonColor = actionButton.style.background;
        const originalStatusText = statusBadge.innerText;

        // ⚡ OPTIMISTIC UPDATE
        if (newStatus) { // Reactivating
            actionButton.innerText = 'Deactivate';
            actionButton.style.background = '#dc2626'; // Red
            statusBadge.innerText = 'Active';
        } else { // Deactivating
            actionButton.innerText = 'Reactivate';
            actionButton.style.background = '#059669'; // Green
            statusBadge.innerText = 'Inactive';
        }

        fetch('/Admin/SetUserStatus', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: userId, isActive: newStatus })
        })
        .then(response => {
            if (!response.ok) {
                throw new Error('Network response was not ok');
            }
            return response.json();
        })
        .then(data => {
            if (data.success) {
                showSuccessModal(data.message);
                // Update our local state tracker
                isCurrentlyActive = newStatus;
                
                // Reload after a short delay to let user see the modal and ensure full sync
                setTimeout(() => {
                    window.location.reload();
                }, 1500);
            } else {
                // Revert UI
                actionButton.innerText = originalButtonText;
                actionButton.style.background = originalButtonColor;
                statusBadge.innerText = originalStatusText;
                alert(data.message || 'Failed to update user status.');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            // Revert UI
            actionButton.innerText = originalButtonText;
            actionButton.style.background = originalButtonColor;
            statusBadge.innerText = originalStatusText;
            alert('An error occurred: ' + error.message + '. Please try again.');
        });
    }

    function showSuccessModal(message) {
        document.getElementById('successModalText').textContent = message;
        document.getElementById('successModal').style.display = 'flex';
    }

    function closeSuccessModal() {
        document.getElementById('successModal').style.display = 'none';
    }
</script>

