@model ASI.Basecode.Data.Models.SupabaseUserNew
@{
    Layout = "~/Views/Shared/_AuthenticatedLayout.cshtml";
    ViewData["Title"] = "View User";
    var role = ViewBag.Role ?? "Unknown";
    var department = ViewBag.Department ?? "Not Assigned";
    var isStudent = role.Equals("Student", StringComparison.OrdinalIgnoreCase);
    var isTeacher = role.Equals("Teacher", StringComparison.OrdinalIgnoreCase) || role.Equals("Instructor", StringComparison.OrdinalIgnoreCase);
    var gridColumns = (isStudent || isTeacher) ? "3fr 5fr" : "1fr";
    var isActive = Model?.IsActive ?? true;
    var buttonColor = isActive ? "#dc2626" : "#059669";
    var buttonText = isActive ? "Deactivate" : "Reactivate";
    var statusBadge = isActive ? "Active" : "Inactive";
    var userTypeLabel = isStudent ? "Student" : isTeacher ? "Teacher" : "User";
    var infoSectionTitle = isStudent ? "Student Information" : isTeacher ? "Teacher Information" : "User Information";
}

<!-- Hero Section -->
<section class="hero-section" style="background:#E8F9E8; display:flex; align-items:center; justify-content:center; text-align:center; position:relative; padding: 40px 0;">
    <a href="/Admin/Users" style="position:absolute; top:20px; left:20px; background:#ffffff; color:#059669; border:1px solid #d1d5db; border-radius:8px; padding:8px 16px; font-weight:600; text-decoration:none; transition:background 0.3s; display:flex; align-items:center; gap:8px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5"></path>
            <path d="M12 19l-7-7 7-7"></path>
        </svg>
        Back to Users
    </a>
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 16px;">
        <p style="margin:0 0 4px 0; color:#4b5563; font-size:20px;">User Management</p>
        <h1 style="font-size:48px; font-weight:800; margin:0 0 4px 0; color:#111827;">View User</h1>
        <p style="margin:0 0 16px 0; color:#4b5563; font-size:18px;">View detailed user information.</p>
        <p style="margin:0 0 0 0; color:#6b7280; font-size:14px;">Access comprehensive user profiles and contact details.</p>
    </div>
</section>

<!-- Main Content Section -->
<section style="background:#ffffff; padding: 40px 0;">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 16px;">
        <!-- Action Buttons -->
        <div style="display:flex; justify-content:flex-end; gap:12px; margin-bottom:24px;">
            <a href="@Url.Action("EditUser", "Admin", new { id = Model.Id })" style="background:#059669; color:#ffffff; border:none; border-radius:6px; padding:12px 20px; font-weight:600; text-decoration:none;">Edit @userTypeLabel</a>
            <button onclick="toggleUserStatus()" style="background:@buttonColor; color:#ffffff; border:none; border-radius:6px; padding:12px 20px; font-weight:600; cursor:pointer;">@buttonText</button>
        </div>

        <div style="display:grid; grid-template-columns: @gridColumns; gap:24px;">

            <!-- Left Column: User Information -->
            <div>
                <div style="background:#f9fafb; border:1px solid #e5e7eb; border-radius:8px; padding:24px;">
                    <h3 style="margin:0 0 20px 0; font-weight:700; font-size:18px; color:#111827;">@infoSectionTitle</h3>

                    <!-- User Name -->
                    <div style="margin-bottom:20px;">
                        <div style="font-size:24px; font-weight:800; color:#111827; margin-bottom:4px;">@Model.FirstName @Model.LastName</div>
                        <div style="color:#6b7280; font-size:14px;">@role • @statusBadge</div>
                    </div>

                    <!-- Profile Picture -->
                    <div style="display:flex; align-items:center; gap:16px; margin-bottom:24px;">
                        <div style="width:64px; height:64px; border-radius:9999px; overflow:hidden; border:2px solid #d1fae5; background:#e5e7eb; display:grid; place-items:center;">
                            <img src="/img/acaduslogo.png" alt="Profile" style="width:100%; height:100%; object-fit:cover;" />
                        </div>
                        <div>
                            <div style="font-weight:600; color:#111827;">ID: @(Model.UserDisplayId ?? Model.Id.ToString())</div>
                            <div style="color:#6b7280; font-size:14px;">@department</div>
                        </div>
                    </div>

                    <!-- Personal Information -->
                    <div style="margin-bottom:20px;">
                        <h4 style="font-size:16px; font-weight:700; color:#111827; margin:0 0 12px 0; padding-bottom:8px; border-bottom:1px solid #e5e7eb;">Personal Information</h4>
                        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
                            <div>
                                <span style="font-size:12px; font-weight:600; color:#6b7280; text-transform:uppercase;">First Name</span>
                                <div style="font-size:14px; color:#111827; padding:6px 0;">@(Model.FirstName ?? "Not provided")</div>
                            </div>
                            <div>
                                <span style="font-size:12px; font-weight:600; color:#6b7280; text-transform:uppercase;">Last Name</span>
                                <div style="font-size:14px; color:#111827; padding:6px 0;">@(Model.LastName ?? "Not provided")</div>
                            </div>
                            <div>
                                <span style="font-size:12px; font-weight:600; color:#6b7280; text-transform:uppercase;">Middle Name</span>
                                <div style="font-size:14px; color:#111827; padding:6px 0;">@(Model.MiddleName ?? "N/A")</div>
                            </div>
                            <div>
                                <span style="font-size:12px; font-weight:600; color:#6b7280; text-transform:uppercase;">Contact</span>
                                <div style="font-size:14px; color:#111827; padding:6px 0;">@(Model.ContactNumber ?? "Not provided")</div>
                            </div>
                            <div style="grid-column:1/-1;">
                                <span style="font-size:12px; font-weight:600; color:#6b7280; text-transform:uppercase;">Email</span>
                                <div style="font-size:14px; color:#111827; padding:6px 0;">@(Model.Email ?? "Not provided")</div>
                            </div>
                        </div>
                    </div>

                    <!-- Address Information -->
                    <div style="margin-bottom:20px;">
                        <h4 style="font-size:16px; font-weight:700; color:#111827; margin:0 0 12px 0; padding-bottom:8px; border-bottom:1px solid #e5e7eb;">Address Information</h4>
                        @if (!string.IsNullOrEmpty(Model.Address))
                        {
                            <div style="font-size:14px; color:#111827;">@Model.Address</div>
                        }
                        else
                        {
                            <div style="font-size:14px; color:#6b7280; font-style:italic;">Address not provided</div>
                        }
                    </div>

                    <!-- Emergency Contact -->
                    <div>
                        <h4 style="font-size:16px; font-weight:700; color:#111827; margin:0 0 12px 0; padding-bottom:8px; border-bottom:1px solid #e5e7eb;">Emergency Contact</h4>
                        @if (!string.IsNullOrEmpty(Model.EmergencyContact))
                        {
                            <div style="font-size:14px; color:#111827;">@Model.EmergencyContact</div>
                        }
                        else
                        {
                            <div style="font-size:14px; color:#6b7280; font-style:italic;">Emergency contact not provided</div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column: Role-specific content -->
            @if (isStudent)
            {
                <!-- Student: Academic Performance -->
                <div>
                    <div style="background:#f9fafb; border:1px solid #e5e7eb; border-radius:8px; padding:24px;">
                        <h3 style="margin:0 0 20px 0; font-weight:700; font-size:18px; color:#111827;">Academic Performance</h3>
                        <div style="padding:32px; text-align:center; color:#6b7280;">
                            No data available yet
                        </div>
                    </div>
                </div>
            }
            else if (isTeacher)
            {
                <!-- Teacher: Handled Courses -->
                <div>
                    <div style="background:#f9fafb; border:1px solid #e5e7eb; border-radius:8px; padding:24px;">
                        <h3 style="margin:0 0 20px 0; font-weight:700; font-size:18px; color:#111827;">Handled Courses</h3>

                        <!-- Total Courses Card -->
                        <div style="background:#ffffff; border:1px solid #e5e7eb; border-radius:8px; padding:24px; margin-bottom:24px; text-align:center;">
                            <div style="font-size:14px; color:#6b7280; margin-bottom:12px;">Total Courses This Semester</div>
                            <div style="font-size:64px; font-weight:800; color:#059669; margin-bottom:8px; line-height:1;">0</div>
                            <div style="font-size:14px; color:#6b7280;">Active Teaching Load</div>
                        </div>

                        <!-- Current Semester Courses -->
                        <div>
                            <h4 style="font-size:16px; font-weight:700; color:#111827; margin:0 0 16px 0;">Current Semester Courses</h4>
                            <div style="border-radius:8px; overflow:hidden; border:1px solid #e5e7eb;">
                                <table style="width:100%; border-collapse:collapse;">
                                    <thead style="background:#059669;">
                                        <tr>
                                            <th style="padding:12px 16px; text-align:left; font-weight:700; color:#fff; font-size:14px;">Course Code</th>
                                            <th style="padding:12px 16px; text-align:left; font-weight:700; color:#fff; font-size:14px;">Course Name</th>
                                            <th style="padding:12px 16px; text-align:left; font-weight:700; color:#fff; font-size:14px;">Schedule</th>
                                            <th style="padding:12px 16px; text-align:center; font-weight:700; color:#fff; font-size:14px;">Enrolled</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td colspan="4" style="padding:32px; text-align:center; color:#6b7280; background:#ffffff;">
                                                No courses assigned yet
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<script>
    function toggleUserStatus() {
        const userId = @Model.Id;
        const isActive = @Json.Serialize(Model.IsActive == true);
        const userName = '@Html.Raw(Model.FirstName) @Html.Raw(Model.LastName)';
        const newStatus = isActive === true ? false : true;
        
        if (confirm(`Are you sure you want to ${newStatus ? 'reactivate' : 'deactivate'} ${userName}?`)) {
            fetch('/Admin/SetUserStatus', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: userId, isActive: newStatus })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    window.location.reload();
                } else {
                    alert(data.message || 'Failed to update user status.');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred.');
            });
        }
    }
</script>

