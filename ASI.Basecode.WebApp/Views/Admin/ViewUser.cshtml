                        </div>
                        <div>
                            <div style="font-weight:600; color:#111827;">ID: 123213</div>
                            <div style="color:#6b7280; font-size:14px;">CCS Department</div>
                        </div>
                    </div>

                    <!-- Personal Information -->
                    <div style="margin-bottom:20px;">
                        <h4 style="font-size:16px; font-weight:700; color:#111827; margin:0 0 12px 0; padding-bottom:8px; border-bottom:1px solid #e5e7eb;">Personal Information</h4>
