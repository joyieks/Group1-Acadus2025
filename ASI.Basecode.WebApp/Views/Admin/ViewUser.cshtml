                                <div style="font-size:14px; color:#111827; padding:6px 0;">Johnny</div>
                            </div>
                            <div>
                                <span style="font-size:12px; font-weight:600; color:#6b7280; text-transform:uppercase; letter-spacing:0.5px;">Last Name</span>
                                <div style="font-size:14px; color:#111827; padding:6px 0;">Appleseed</div>
                            </div>
                            <div>
                                <span style="font-size:12px; font-weight:600; color:#6b7280; text-transform:uppercase; letter-spacing:0.5px;">Middle Name</span>
                                <div style="font-size:14px; color:#111827; padding:6px 0;">Michael</div>
                            </div>
                            <div>
                                <span style="font-size:12px; font-weight:600; color:#6b7280; text-transform:uppercase; letter-spacing:0.5px;">Contact</span>
                                <div style="font-size:14px; color:#111827; padding:6px 0;">+63 912 345 6789</div>
                            </div>
                            <div style="grid-column:1/-1;">
                                <span style="font-size:12px; font-weight:600; color:#6b7280; text-transform:uppercase; letter-spacing:0.5px;">Email</span>
                                <div style="font-size:14px; color:#111827; padding:6px 0;">johnny.appleseed@example.com</div>
                            </div>
                        </div>
                    </div>

                    <!-- Address Information -->
                    <div style="margin-bottom:20px;">
                        <h4 style="font-size:16px; font-weight:700; color:#111827; margin:0 0 12px 0; padding-bottom:8px; border-bottom:1px solid #e5e7eb;">Address Information</h4>
                        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
                            <div>
                                <span style="font-size:12px; font-weight:600; color:#6b7280; text-transform:uppercase; letter-spacing:0.5px;">House/Apt</span>
                                <div style="font-size:14px; color:#111827; padding:6px 0;">123</div>
                            </div>
                            <div>
                                <span style="font-size:12px; font-weight:600; color:#6b7280; text-transform:uppercase; letter-spacing:0.5px;">Street</span>
                                <div style="font-size:14px; color:#111827; padding:6px 0;">Main Street</div>
                            </div>
                            <div>
                                <span style="font-size:12px; font-weight:600; color:#6b7280; text-transform:uppercase; letter-spacing:0.5px;">Barangay</span>
                                <div style="font-size:14px; color:#111827; padding:6px 0;">Barangay 1</div>
                            </div>
                            <div>
                                <span style="font-size:12px; font-weight:600; color:#6b7280; text-transform:uppercase; letter-spacing:0.5px;">City</span>
                                <div style="font-size:14px; color:#111827; padding:6px 0;">Manila</div>
                            </div>
                            <div style="grid-column:1/-1;">
                                <span style="font-size:12px; font-weight:600; color:#6b7280; text-transform:uppercase; letter-spacing:0.5px;">Province & Zip</span>
                                <div style="font-size:14px; color:#111827; padding:6px 0;">Metro Manila, 1000</div>
                            </div>
                        </div>
                    </div>

                    <!-- Emergency Contact -->
                    <div>
                        <h4 style="font-size:16px; font-weight:700; color:#111827; margin:0 0 12px 0; padding-bottom:8px; border-bottom:1px solid #e5e7eb;">Emergency Contact</h4>
                        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
                            <div>
                                <span style="font-size:12px; font-weight:600; color:#6b7280; text-transform:uppercase; letter-spacing:0.5px;">Name</span>
                                <div style="font-size:14px; color:#111827; padding:6px 0;">Jane Appleseed</div>
                            </div>
                            <div>
                                <span style="font-size:12px; font-weight:600; color:#6b7280; text-transform:uppercase; letter-spacing:0.5px;">Contact</span>
                                <div style="font-size:14px; color:#111827; padding:6px 0;">+63 912 345 6788</div>
                            </div>
                            <div style="grid-column:1/-1;">
                                <span style="font-size:12px; font-weight:600; color:#6b7280; text-transform:uppercase; letter-spacing:0.5px;">Relationship</span>
                                <div style="font-size:14px; color:#111827; padding:6px 0;">Mother</div>
                            </div>
