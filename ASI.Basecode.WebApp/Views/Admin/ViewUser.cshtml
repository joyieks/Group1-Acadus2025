            </div>

            <!-- Right Column: Grades and Performance -->
            <div>
                <div style="background:#f9fafb; border:1px solid #e5e7eb; border-radius:8px; padding:24px;">
                    <h3 style="margin:0 0 20px 0; font-weight:700; font-size:18px; color:#111827;">Academic Performance</h3>

                    <!-- Overall GPA/Average -->
                    <div style="background:#ffffff; border:1px solid #e5e7eb; border-radius:8px; padding:20px; margin-bottom:24px; text-align:center;">
                        <div style="font-size:14px; color:#6b7280; margin-bottom:8px;">Overall Grade Point Average</div>
                        <div style="font-size:48px; font-weight:800; color:#059669; margin-bottom:4px;">3.75</div>
                        <div style="font-size:14px; color:#6b7280;">Excellent Performance</div>
                    </div>

                    <!-- Course Grades Table -->
                    <div style="margin-bottom:24px;">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                            <h4 style="font-size:16px; font-weight:700; color:#111827; margin:0;">Course Grades</h4>
                            <button id="editGradesBtn" onclick="toggleEditGrades()" style="background:#059669; color:#ffffff; border:none; border-radius:6px; padding:8px 16px; font-weight:600; cursor:pointer;">Edit Grades</button>
                        </div>
                        <div style="border-radius:8px; overflow:hidden; border:1px solid #e5e7eb;">
                            <table id="gradesTable" style="width:100%; border-collapse:collapse;">
                                <thead style="background:#059669;">
                                    <tr>
                                        <th style="padding:12px 16px; text-align:left; font-weight:700; color:#fff;">Course</th>
                                        <th style="padding:12px 16px; text-align:left; font-weight:700; color:#fff;">Grade</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr style="border-bottom:1px solid #e5e7eb;">
                                        <td style="padding:16px; color:#111827; font-weight:500;">CS101 - Introduction to Programming</td>
                                        <td style="padding:16px;">
                                            <span class="grade-display">A (95%)</span>
                                            <input type="text" class="grade-input" value="95" style="display:none; width:80px; padding:4px; border:1px solid #d1d5db; border-radius:4px; text-align:center;">
                                        </td>
                                    </tr>
                                    <tr style="background:#f9fafb; border-bottom:1px solid #e5e7eb;">
                                        <td style="padding:16px; color:#111827; font-weight:500;">CS102 - Data Structures</td>
                                        <td style="padding:16px;">
                                            <span class="grade-display">A- (92%)</span>
                                            <input type="text" class="grade-input" value="92" style="display:none; width:80px; padding:4px; border:1px solid #d1d5db; border-radius:4px; text-align:center;">
                                        </td>
                                    </tr>
                                    <tr style="border-bottom:1px solid #e5e7eb;">
                                        <td style="padding:16px; color:#111827; font-weight:500;">MATH101 - Calculus I</td>
                                        <td style="padding:16px;">
                                            <span class="grade-display">B+ (88%)</span>
                                            <input type="text" class="grade-input" value="88" style="display:none; width:80px; padding:4px; border:1px solid #d1d5db; border-radius:4px; text-align:center;">
                                        </td>
                                    </tr>
                                    <tr style="background:#f9fafb; border-bottom:1px solid #e5e7eb;">
                                        <td style="padding:16px; color:#111827; font-weight:500;">CS201 - Algorithms</td>
                                        <td style="padding:16px;">
                                            <span class="grade-display">A (96%)</span>
                                            <input type="text" class="grade-input" value="96" style="display:none; width:80px; padding:4px; border:1px solid #d1d5db; border-radius:4px; text-align:center;">
                                        </td>
                                    </tr>
                                    <tr style="border-bottom:1px solid #e5e7eb;">
                                        <td style="padding:16px; color:#111827; font-weight:500;">CS301 - Software Engineering</td>
                                        <td style="padding:16px;">
                                            <span class="grade-display">B (85%)</span>
                                            <input type="text" class="grade-input" value="85" style="display:none; width:80px; padding:4px; border:1px solid #d1d5db; border-radius:4px; text-align:center;">
                                        </td>
                                    </tr>
                                    <tr style="background:#f9fafb;">
                                        <td style="padding:16px; color:#111827; font-weight:500;">CS401 - Advanced Programming</td>
                                        <td style="padding:16px;">
                                            <span class="grade-display">In Progress</span>
                                            <input type="text" class="grade-input" value="" placeholder="Enter grade %" style="display:none; width:80px; padding:4px; border:1px solid #d1d5db; border-radius:4px; text-align:center;">
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div id="gradeActions" style="display:none; margin-top:16px; text-align:right;">
                            <button onclick="saveGrades()" style="background:#059669; color:#ffffff; border:none; border-radius:6px; padding:8px 16px; font-weight:600; cursor:pointer; margin-right:8px;">Save Changes</button>
                            <button onclick="cancelEditGrades()" style="background:#6b7280; color:#ffffff; border:none; border-radius:6px; padding:8px 16px; font-weight:600; cursor:pointer;">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    let isEditingGrades = false;

    function toggleEditGrades() {
        isEditingGrades = !isEditingGrades;
        const editBtn = document.getElementById('editGradesBtn');
        const gradeActions = document.getElementById('gradeActions');
        const gradeDisplays = document.querySelectorAll('.grade-display');
        const gradeInputs = document.querySelectorAll('.grade-input');

        if (isEditingGrades) {
            // Switch to edit mode
            editBtn.textContent = 'Cancel Edit';
            editBtn.style.background = '#6b7280';
            gradeActions.style.display = 'block';

            // Show input fields, hide display spans
            gradeDisplays.forEach(display => display.style.display = 'none');
            gradeInputs.forEach(input => input.style.display = 'inline-block');

            // Focus on first input
            const firstInput = document.querySelector('.grade-input');
            if (firstInput) {
                firstInput.focus();
                firstInput.select();
            }
        } else {
            // Switch back to view mode
            cancelEditGrades();
        }
    }

    function saveGrades() {
        const gradeDisplays = document.querySelectorAll('.grade-display');
        const gradeInputs = document.querySelectorAll('.grade-input');

        // Update display values with input values
        gradeInputs.forEach((input, index) => {
            const percentage = input.value.trim();
            let displayText = 'Not Graded';

            if (percentage) {
                const percent = parseInt(percentage);
                let letterGrade = '';

                if (percent >= 97) letterGrade = 'A+';
                else if (percent >= 93) letterGrade = 'A';
                else if (percent >= 90) letterGrade = 'A-';
                else if (percent >= 87) letterGrade = 'B+';
                else if (percent >= 83) letterGrade = 'B';
                else if (percent >= 80) letterGrade = 'B-';
                else if (percent >= 77) letterGrade = 'C+';
                else if (percent >= 73) letterGrade = 'C';
                else if (percent >= 70) letterGrade = 'C-';
                else if (percent >= 67) letterGrade = 'D+';
                else if (percent >= 63) letterGrade = 'D';
                else letterGrade = 'F';

                displayText = `${letterGrade} (${percent}%)`;
            }

            gradeDisplays[index].textContent = displayText;
        });

        // Switch back to view mode
        toggleEditGrades();

        // Here you would typically send the updates to the server
        console.log('Grades saved successfully');
    }

    function cancelEditGrades() {
        const editBtn = document.getElementById('editGradesBtn');
        const gradeActions = document.getElementById('gradeActions');
        const gradeDisplays = document.querySelectorAll('.grade-display');
        const gradeInputs = document.querySelectorAll('.grade-input');

        // Switch back to view mode
        editBtn.textContent = 'Edit Grades';
        editBtn.style.background = '#059669';
        gradeActions.style.display = 'none';

        // Show display spans, hide input fields
        gradeDisplays.forEach(display => display.style.display = 'inline');
        gradeInputs.forEach(input => input.style.display = 'none');

        isEditingGrades = false;
    }

    function deactivateUser() {
        if (confirm('Are you sure you want to deactivate this user?')) {
            // TODO: Implement deactivate logic
            alert('Deactivate functionality to be implemented');
        }
    }

    // Handle Enter key in grade inputs
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && isEditingGrades) {
            const activeInput = document.activeElement;
            if (activeInput.classList.contains('grade-input')) {
                // Move to next input or save if it's the last one
                const inputs = Array.from(document.querySelectorAll('.grade-input'));
                const currentIndex = inputs.indexOf(activeInput);

                if (currentIndex < inputs.length - 1) {
                    inputs[currentIndex + 1].focus();
                    inputs[currentIndex + 1].select();
                } else {
                    saveGrades();
                }
            }
        } else if (e.key === 'Escape' && isEditingGrades) {
            cancelEditGrades();
        }
    });
</script>

