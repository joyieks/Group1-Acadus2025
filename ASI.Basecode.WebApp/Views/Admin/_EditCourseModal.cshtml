@using ASI.Basecode.WebApp.Models
@model CourseEditViewModel

<script src="https://cdn.tailwindcss.com"></script>

<div class="modal-backdrop" id="editCourseModalBackdrop" onclick="closeEditCourseModal()"></div>

<div class="modal-container">
    <div class="modal-content">
        <!-- Header -->
        <div class="flex justify-between items-center px-8 py-6 bg-green-100 rounded-t-2xl">
            <h1 class="text-2xl font-bold text-gray-900 m-0">Edit Course</h1>
            <button type="button" onclick="closeEditCourseModal()" class="bg-transparent border-none cursor-pointer text-gray-500 text-2xl p-0 w-8 h-8 flex items-center justify-center rounded-full transition-all duration-200 hover:bg-black/10">
                ×
            </button>
        </div>

        <!-- Form Content -->
        <div class="max-h-70vh overflow-y-auto p-8">
            @if (ViewData.ModelState.Values.SelectMany(v => v.Errors).Count() > 0)
            {
                <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-5 text-red-900">
                    <h4 class="m-0 mb-2 font-semibold">Error</h4>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p class="m-1 text-sm">@error.ErrorMessage</p>
                    }
                </div>
            }

            <form id="editCourseForm" asp-controller="Admin" asp-action="EditCourse" method="post">
                @Html.AntiForgeryToken()
                
                <input type="hidden" asp-for="CourseId" />

                <!-- Course Information Section -->
                <section class="mb-8">
                    <h2 class="text-lg font-bold text-gray-900 m-0 mb-5 pb-3 border-b-2 border-green-100">Course Information</h2>
                    
                    <div class="grid grid-cols-2 gap-5 mb-5">
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">
                                Course Code <span class="font-normal text-gray-500 text-xs">(Read-only)</span>
                            </label>
                            <input type="text" asp-for="Code" readonly placeholder="Auto-generated" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-gray-100 cursor-not-allowed" />
                            <small class="text-gray-500 text-xs block mt-1">Course code cannot be changed after creation</small>
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">
                                Course Name <span class="text-red-600">*</span>
                            </label>
                            <input type="text" asp-for="Name" placeholder="e.g., Introduction to Computer Science" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500"/>
                            <span asp-validation-for="Name" class="text-red-600 text-xs block mt-1"></span>
                        </div>
                    </div>

                    <div class="mb-5">
                        <label class="block font-semibold text-gray-700 mb-2 text-sm">
                            Course Description <span class="text-red-600">*</span>
                        </label>
                        <textarea asp-for="Description" placeholder="Provide a detailed description of the course..." rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500 resize-vertical"></textarea>
                        <span asp-validation-for="Description" class="text-red-600 text-xs block mt-1"></span>
                    </div>

                    <div class="grid grid-cols-3 gap-5 mb-5">
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">
                                Units <span class="text-red-600">*</span>
                            </label>
                            <input type="number" asp-for="Credits" placeholder="3" min="1" max="6" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500"/>
                            <span asp-validation-for="Credits" class="text-red-600 text-xs block mt-1"></span>
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">
                                Year Level <span class="text-red-600">*</span>
                            </label>
                            <select asp-for="Level" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500">
                                <option value="">-- Select a Year Level --</option>
                                @if (Model.Levels != null && Model.Levels.Count > 0)
                                {
                                    @foreach (var level in Model.Levels)
                                    {
                                        <option value="@level.Value">@level.Label</option>
                                    }
                                }
                                else
                                {
                                    <option value="1st Year">1st Year</option>
                                    <option value="2nd Year">2nd Year</option>
                                    <option value="3rd Year">3rd Year</option>
                                    <option value="4th Year">4th Year</option>
                                }
                            </select>
                            <span asp-validation-for="Level" class="text-red-600 text-xs block mt-1"></span>
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">
                                Semester <span class="text-red-600">*</span>
                            </label>
                            <select asp-for="SemesterId" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500">
                                <option value="">-- Select a Semester --</option>
                                @foreach (var semester in Model.Semesters)
                                {
                                    <option value="@semester.Id">@semester.SemesterName</option>
                                }
                            </select>
                            <span asp-validation-for="SemesterId" class="text-red-600 text-xs block mt-1"></span>
                        </div>
                    </div>

                    <div class="grid grid-cols-3 gap-5">
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">
                                Maximum Capacity <span class="text-red-600">*</span>
                            </label>
                            <input type="number" asp-for="MaxCapacity" placeholder="30" min="1" max="50" step="1" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500"/>
                            <span asp-validation-for="MaxCapacity" class="text-red-600 text-xs block mt-1"></span>
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">
                                Instructor <span class="text-red-600">*</span>
                            </label>
                            <select asp-for="InstructorId" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500">
                                <option value="">-- Select an Instructor --</option>
                                @foreach (var instructor in Model.Instructors)
                                {
                                    <option value="@instructor.UserTypeId">@instructor.FullName</option>
                                }
                            </select>
                            <span asp-validation-for="InstructorId" class="text-red-600 text-xs block mt-1"></span>
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">
                                Status <span class="text-red-600">*</span>
                            </label>
                            <select asp-for="Status" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                            <span asp-validation-for="Status" class="text-red-600 text-xs block mt-1"></span>
                        </div>
                    </div>
                </section>

                <!-- Form Actions -->
                <div class="flex justify-end gap-3">
                    <button type="button" onclick="closeEditCourseModal()" class="px-8 py-3 rounded-lg text-sm font-semibold cursor-pointer bg-white text-gray-700 border-2 border-gray-300 hover:bg-gray-50 transition-colors">
                        Cancel
                    </button>
                    <button type="submit" class="px-8 py-3 rounded-lg text-sm font-semibold cursor-pointer bg-green-600 text-white border-none hover:bg-green-700 transition-colors shadow-md">
                        Update Course
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(4px);
        z-index: 9998;
    }

    .modal-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 20px;
        pointer-events: none;
    }

    .modal-content {
        background: white;
        border-radius: 16px;
        max-width: 900px;
        width: 100%;
        max-height: 90vh;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        pointer-events: auto;
        animation: modalSlideIn 0.3s ease-out;
        display: flex;
        flex-direction: column;
    }

    @@keyframes modalSlideIn {
        from {
            opacity: 0;
            transform: translateY(-20px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    input[type="text"],
    input[type="number"],
    select,
    textarea {
        transition: border-color 0.2s ease;
    }

    input[type="text"]:focus,
    input[type="number"]:focus,
    select:focus,
    textarea:focus {
        outline: none;
        border-color: #059669;
        box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.1);
    }

    input[type="text"]:invalid:not(:placeholder-shown),
    input[type="number"]:invalid:not(:placeholder-shown) {
        border-color: #dc2626;
    }
</style>

<script>
    // Make closeEditCourseModal globally available
    window.closeEditCourseModal = function() {
        const backdrop = document.getElementById('editCourseModalBackdrop');
        const container = document.querySelector('.modal-container');
        if (backdrop) backdrop.remove();
        if (container) container.remove();
    };

    (function(){
        const form = document.getElementById('editCourseForm');
        if (!form) return;

        form.addEventListener('submit', function(e) {
            e.preventDefault();

            // Show confirmation modal
            const confirmBackdrop = document.createElement('div');
            confirmBackdrop.style.cssText = 'position:fixed; inset:0; background:rgba(0,0,0,0.6); backdrop-filter:blur(4px); z-index:11000;';
            
            const confirmBox = document.createElement('div');
            confirmBox.style.cssText = 'position:fixed; left:50%; top:50%; transform:translate(-50%,-50%); z-index:11001; max-width:400px; width:90%; background:#fff; border-radius:12px; box-shadow:0 8px 30px rgba(0,0,0,0.2);';
            confirmBox.innerHTML = `
                <div style="padding:20px; border-bottom:1px solid #eef2f7;">
                    <h3 style="margin:0; font-size:18px; font-weight:800; color:#111827;">Confirm Update</h3>
                    <p style="margin:8px 0 0 0; color:#4b5563; font-size:14px;">Are you sure you want to update this course?</p>
                </div>
                <div style="display:flex; justify-content:flex-end; gap:12px; padding:16px;">
                    <button onclick="this.closest('div').parentElement.remove(); this.closest('div').previousElementSibling.remove();" style="padding:10px 18px; border-radius:8px; border:1px solid #d1d5db; background:#fff; cursor:pointer;">Cancel</button>
                    <button id="proceedBtn" style="padding:10px 18px; border-radius:8px; border:none; background:#059669; color:#fff; font-weight:700; cursor:pointer;">Yes, Update</button>
                </div>
            `;
            
            document.body.appendChild(confirmBackdrop);
            document.body.appendChild(confirmBox);

            confirmBox.querySelector('#proceedBtn').addEventListener('click', function() {
                confirmBackdrop.remove();
                confirmBox.remove();

                // Show loading
                const loadingBackdrop = document.createElement('div');
                loadingBackdrop.id = 'loadingBackdrop';
                loadingBackdrop.style.cssText = 'position:fixed; inset:0; background:rgba(0,0,0,0.5); backdrop-filter:blur(3px); z-index:10000; display:flex; align-items:center; justify-content:center;';
                loadingBackdrop.innerHTML = `
                    <div style="text-align:center;">
                        <div style="width:50px; height:50px; border:4px solid #e5e7eb; border-top:4px solid #059669; border-radius:50%; animation:spin 1s linear infinite; margin:0 auto 16px;"></div>
                        <p style="color:#fff; font-weight:600; font-size:16px;">Updating course...</p>
                    </div>
                `;
                document.body.appendChild(loadingBackdrop);

                // Submit via AJAX
                const formData = new FormData(form);
                const courseName = form.querySelector('input[name="Name"]').value;
                
                fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    loadingBackdrop.remove();
                    
                    if (data.success) {
                        // Show success modal
                        const successBackdrop = document.createElement('div');
                        successBackdrop.style.cssText = 'position:fixed; inset:0; background:rgba(0,0,0,0.35); backdrop-filter:blur(3px); z-index:10000;';
                        
                        const successBox = document.createElement('div');
                        successBox.style.cssText = 'position:fixed; left:50%; top:20%; transform:translateX(-50%); z-index:10001; max-width:520px; width:90%; background:#fff; border-radius:12px; box-shadow:0 8px 30px rgba(0,0,0,0.2);';
                        successBox.innerHTML = `
                            <div style="padding:20px; border-bottom:1px solid #eef2f7;">
                                <h3 style="margin:0; font-size:18px; font-weight:800; color:#111827;">Success</h3>
                                <p style="margin:8px 0 0 0; color:#4b5563; font-size:14px;">Course "<strong>${courseName}</strong>" has been updated successfully.</p>
                            </div>
                            <div style="display:flex; justify-content:flex-end; gap:12px; padding:16px;">
                                <button onclick="location.reload();" style="padding:10px 18px; border-radius:8px; border:none; background:#059669; color:#fff; text-decoration:none; font-weight:600; cursor:pointer;">Done</button>
                            </div>
                        `;
                        
                        document.body.appendChild(successBackdrop);
                        document.body.appendChild(successBox);
                        closeEditCourseModal();
                    } else {
                        // Show error modal
                        const errorBackdrop = document.createElement('div');
                        errorBackdrop.style.cssText = 'position:fixed; inset:0; background:rgba(0,0,0,0.35); backdrop-filter:blur(3px); z-index:10000;';
                        
                        const errorBox = document.createElement('div');
                        errorBox.style.cssText = 'position:fixed; left:50%; top:20%; transform:translateX(-50%); z-index:10001; max-width:520px; width:90%; background:#fff; border-radius:12px; box-shadow:0 8px 30px rgba(0,0,0,0.2);';
                        errorBox.innerHTML = `
                            <div style="padding:20px; border-bottom:1px solid #eef2f7;">
                                <h3 style="margin:0; font-size:18px; font-weight:800; color:#991b1b;">Error</h3>
                                <p style="margin:8px 0 0 0; color:#4b5563; font-size:14px;">${data.message}</p>
                            </div>
                            <div style="display:flex; justify-content:flex-end; gap:12px; padding:16px;">
                                <button onclick="this.closest('div').parentElement.remove(); this.closest('div').previousElementSibling.remove();" style="padding:10px 18px; border-radius:8px; border:none; background:#dc2626; color:#fff; font-weight:600; cursor:pointer;">Try Again</button>
                            </div>
                        `;
                        
                        document.body.appendChild(errorBackdrop);
                        document.body.appendChild(errorBox);
                    }
                })
                .catch(error => {
                    loadingBackdrop.remove();
                    
                    const errorBackdrop = document.createElement('div');
                    errorBackdrop.style.cssText = 'position:fixed; inset:0; background:rgba(0,0,0,0.35); backdrop-filter:blur(3px); z-index:10000;';
                    
                    const errorBox = document.createElement('div');
                    errorBox.style.cssText = 'position:fixed; left:50%; top:20%; transform:translateX(-50%); z-index:10001; max-width:520px; width:90%; background:#fff; border-radius:12px; box-shadow:0 8px 30px rgba(0,0,0,0.2);';
                    errorBox.innerHTML = `
                        <div style="padding:20px; border-bottom:1px solid #eef2f7;">
                            <h3 style="margin:0; font-size:18px; font-weight:800; color:#991b1b;">Error</h3>
                            <p style="margin:8px 0 0 0; color:#4b5563; font-size:14px;">An error occurred. Please try again.</p>
                        </div>
                        <div style="display:flex; justify-content:flex-end; gap:12px; padding:16px;">
                            <button onclick="this.closest('div').parentElement.remove(); this.closest('div').previousElementSibling.remove();" style="padding:10px 18px; border-radius:8px; border:none; background:#dc2626; color:#fff; font-weight:600; cursor:pointer;">Try Again</button>
                        </div>
                    `;
                    
                    document.body.appendChild(errorBackdrop);
                    document.body.appendChild(errorBox);
                });
            });
        });
    })();
</script>

<style>
    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>
