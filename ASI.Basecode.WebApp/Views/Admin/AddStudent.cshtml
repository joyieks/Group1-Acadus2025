@using ASI.Basecode.WebApp.Models
@model StudentCreateViewModel

@{
    Layout = "~/Views/Shared/_AuthenticatedLayout.cshtml";
    ViewData["Title"] = "Add Student";
}

<!-- Backdrop Blur Overlay -->
<div class="modal-backdrop" onclick="window.history.back()"></div>

<!-- Modal Content -->
<div class="modal-container">
    <div class="modal-content">
        <!-- Header -->
        <div style="display:flex; justify-content:space-between; align-items:center; padding:24px 32px; background:#E0E7FF; border-radius:16px 16px 0 0;">
            <h1 style="font-size:24px; font-weight:800; color:#111827; margin:0;">Add New Student</h1>
            <button type="button" onclick="window.history.back()" style="background:none; border:none; cursor:pointer; color:#6b7280; font-size:24px; padding:0; width:32px; height:32px; display:flex; align-items:center; justify-content:center; border-radius:50%; transition:all 0.2s;" onmouseover="this.style.background='rgba(0,0,0,0.1)'" onmouseout="this.style.background='none'">
                ×
            </button>
        </div>

        <!-- Form Content -->
        <div style="max-height:70vh; overflow-y:auto; padding:32px;">
            @if (ViewData.ModelState.Values.SelectMany(v => v.Errors).Count() > 0)
            {
                <div style="background:#fee2e2; border:1px solid #fecaca; border-radius:8px; padding:16px; margin-bottom:20px; color:#991b1b;">
                    <h4 style="margin:0 0 8px 0; font-weight:600;">Error</h4>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p style="margin:4px 0; font-size:14px;">@error.ErrorMessage</p>
                    }
                </div>
            }

            <form asp-controller="Admin" asp-action="AddStudent" method="post">
                @Html.AntiForgeryToken()
                
                <!-- Personal Information Section -->
                <section style="margin-bottom:32px;">
                    <h2 style="font-size:18px; font-weight:700; color:#111827; margin:0 0 20px 0; padding-bottom:12px; border-bottom:2px solid #E0E7FF;">Personal Information</h2>
                    
                    <div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:20px; margin-bottom:20px;">
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">First Name <span style="color:#dc2626;">*</span></label>
                            <input type="text" asp-for="FirstName" placeholder="e.g., Juan" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;"/>
                            <span asp-validation-for="FirstName" style="color:#dc2626; font-size:12px; display:block; margin-top:4px;"></span>
                        </div>
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Last Name <span style="color:#dc2626;">*</span></label>
                            <input type="text" asp-for="LastName" placeholder="e.g., Cruz" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;"/>
                            <span asp-validation-for="LastName" style="color:#dc2626; font-size:12px; display:block; margin-top:4px;"></span>
                        </div>
                    </div>

                    <div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:20px; margin-bottom:20px;">
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Middle Name</label>
                            <input type="text" asp-for="MiddleName" placeholder="e.g., Santos" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;"/>
                        </div>
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Suffix</label>
                            <input type="text" asp-for="Suffix" placeholder="e.g., Jr., Sr." style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;"/>
                        </div>
                    </div>
                </section>

                <!-- Contact Information Section -->
                <section style="margin-bottom:32px;">
                    <h2 style="font-size:18px; font-weight:700; color:#111827; margin:0 0 20px 0; padding-bottom:12px; border-bottom:2px solid #E0E7FF;">Contact Information</h2>
                    
                    <div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:20px; margin-bottom:20px;">
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Email <span style="color:#dc2626;">*</span></label>
                            <input type="email" asp-for="Email" placeholder="e.g., juan.cruz@university.edu" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;"/>
                            <span asp-validation-for="Email" style="color:#dc2626; font-size:12px; display:block; margin-top:4px;"></span>
                        </div>
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Contact Number <span style="color:#dc2626;">*</span></label>
                            <input type="tel" asp-for="ContactNumber" placeholder="e.g., +63-9XX-XXX-XXXX" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;"/>
                            <span asp-validation-for="ContactNumber" style="color:#dc2626; font-size:12px; display:block; margin-top:4px;"></span>
                        </div>
                    </div>
                </section>

                <!-- Student Profile Section -->
                <section style="margin-bottom:32px;">
                    <h2 style="font-size:18px; font-weight:700; color:#111827; margin:0 0 20px 0; padding-bottom:12px; border-bottom:2px solid #E0E7FF;">Student Profile</h2>
                    
                    <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:20px; margin-bottom:20px;">
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Year Level <span style="color:#dc2626;">*</span></label>
                            <select asp-for="YearLevel" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;">
                                <option value="">-- Select Year Level --</option>
                                <option value="1">1st Year</option>
                                <option value="2">2nd Year</option>
                                <option value="3">3rd Year</option>
                                <option value="4">4th Year</option>
                            </select>
                            <span asp-validation-for="YearLevel" style="color:#dc2626; font-size:12px; display:block; margin-top:4px;"></span>
                        </div>
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Program <span style="color:#dc2626;">*</span></label>
                            <select asp-for="ProgramId" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;">
                                <option value="">-- Select Program --</option>
                                @if (ViewBag.Programs != null)
                                {
                                    foreach (var program in ViewBag.Programs)
                                    {
                                        <option value="@program.Id">@program.ProgramName (@program.ProgramCode)</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="ProgramId" style="color:#dc2626; font-size:12px; display:block; margin-top:4px;"></span>
                        </div>
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Department <span style="color:#dc2626;">*</span></label>
                            <select asp-for="DepartmentId" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;">
                                <option value="">-- Select Department --</option>
                                @if (ViewBag.Departments != null)
                                {
                                    foreach (var dept in ViewBag.Departments)
                                    {
                                        <option value="@dept.Id">@dept.DepartmentName (@dept.DepartmentCode)</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="DepartmentId" style="color:#dc2626; font-size:12px; display:block; margin-top:4px;"></span>
                        </div>
                    </div>
                </section>

                <!-- Address Information Section -->
                <section style="margin-bottom:32px;">
                    <h2 style="font-size:18px; font-weight:700; color:#111827; margin:0 0 20px 0; padding-bottom:12px; border-bottom:2px solid #E0E7FF;">Address</h2>
                    
                    <div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:20px; margin-bottom:20px;">
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">House Number</label>
                            <input type="text" asp-for="HouseNumber" placeholder="e.g., 123" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;"/>
                        </div>
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Street Name</label>
                            <input type="text" asp-for="StreetName" placeholder="e.g., Rizal Street" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;"/>
                        </div>
                    </div>

                    <div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:20px; margin-bottom:20px;">
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Subdivision</label>
                            <input type="text" asp-for="Subdivision" placeholder="e.g., Sampaloc Subdivision" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;"/>
                        </div>
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Barangay <span style="color:#dc2626;">*</span></label>
                            <input type="text" asp-for="Barangay" placeholder="e.g., San Jose" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;"/>
                            <span asp-validation-for="Barangay" style="color:#dc2626; font-size:12px; display:block; margin-top:4px;"></span>
                        </div>
                    </div>

                    <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:20px; margin-bottom:20px;">
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">City <span style="color:#dc2626;">*</span></label>
                            <input type="text" asp-for="City" placeholder="e.g., Manila" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;"/>
                            <span asp-validation-for="City" style="color:#dc2626; font-size:12px; display:block; margin-top:4px;"></span>
                        </div>
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Province <span style="color:#dc2626;">*</span></label>
                            <input type="text" asp-for="Province" placeholder="e.g., Metro Manila" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;"/>
                            <span asp-validation-for="Province" style="color:#dc2626; font-size:12px; display:block; margin-top:4px;"></span>
                        </div>
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Zip Code</label>
                            <input type="text" asp-for="ZipCode" placeholder="e.g., 1016" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;"/>
                        </div>
                    </div>
                </section>

                <!-- Emergency Contact Section -->
                <section style="margin-bottom:32px;">
                    <h2 style="font-size:18px; font-weight:700; color:#111827; margin:0 0 20px 0; padding-bottom:12px; border-bottom:2px solid #E0E7FF;">Emergency Contact <span style="font-size:14px; font-weight:400; color:#6b7280;">(Optional)</span></h2>
                    
                    <div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:20px; margin-bottom:20px;">
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">First Name</label>
                            <input type="text" asp-for="EmergencyContactFirstName" placeholder="e.g., Maria" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;"/>
                        </div>
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Last Name</label>
                            <input type="text" asp-for="EmergencyContactLastName" placeholder="e.g., Cruz" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;"/>
                        </div>
                    </div>

                    <div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:20px; margin-bottom:20px;">
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Middle Name</label>
                            <input type="text" asp-for="EmergencyContactMiddleName" placeholder="e.g., Santos" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;"/>
                        </div>
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Suffix</label>
                            <input type="text" asp-for="EmergencyContactSuffix" placeholder="e.g., Jr." style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;"/>
                        </div>
                    </div>

                    <div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:20px; margin-bottom:20px;">
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Contact Number</label>
                            <input type="tel" asp-for="EmergencyContactNumber" placeholder="e.g., +63-9XX-XXX-XXXX" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;"/>
                        </div>
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Relationship</label>
                            <select asp-for="EmergencyContactRelationship" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;">
                                <option value="">-- Select --</option>
                                <option value="Parent">Parent</option>
                                <option value="Sibling">Sibling</option>
                                <option value="Guardian">Guardian</option>
                                <option value="Relative">Relative</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>
                </section>

                <!-- Form Actions -->
                <div style="display:flex; justify-content:flex-end; gap:12px;">
                    <button type="button" onclick="window.history.back()" style="padding:12px 32px; border-radius:6px; font-size:14px; font-weight:600; cursor:pointer; background:#ffffff; color:#374151; border:2px solid #d1d5db;">
                        Cancel
                    </button>
                    <button type="submit" style="padding:12px 32px; border-radius:6px; font-size:14px; font-weight:600; cursor:pointer; background:#4f46e5; color:#ffffff; border:none; box-shadow:0 2px 4px rgba(0,70,229,0.2);">
                        Create Student
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Confirmation Modal (hidden by default) -->
<div id="confirmModalBackdrop" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.35); backdrop-filter:blur(3px); z-index:10000;" aria-hidden="true"></div>
<div id="confirmModal" style="display:none; position:fixed; left:50%; top:50%; transform:translate(-50%,-50%); z-index:10001; max-width:520px; width:90%; background:#fff; border-radius:12px; box-shadow:0 8px 30px rgba(0,0,0,0.2);">
    <div style="padding:20px; border-bottom:1px solid #eef2f7;">
        <h3 style="margin:0; font-size:18px; font-weight:800; color:#111827;">Confirm Add Student</h3>
        <p id="confirmSummary" style="margin:8px 0 0 0; color:#4b5563; font-size:14px;">Please confirm you want to add this student.</p>
    </div>
    <div style="display:flex; justify-content:flex-end; gap:12px; padding:16px;">
        <button id="confirmCancel" type="button" style="padding:10px 18px; border-radius:8px; border:1px solid #d1d5db; background:#fff; cursor:pointer;">Cancel</button>
        <button id="confirmProceed" type="button" style="padding:10px 18px; border-radius:8px; border:none; background:#4f46e5; color:#fff; font-weight:700; cursor:pointer;">Yes, Add Student</button>
    </div>
</div>

<script>
    (function(){
        const form = document.querySelector('form[asp-controller="Admin"][asp-action="AddStudent"]');
        if (!form) return;

        const submitButton = form.querySelector('button[type="submit"]');
        const confirmModal = document.getElementById('confirmModal');
        const confirmBackdrop = document.getElementById('confirmModalBackdrop');
        const confirmSummary = document.getElementById('confirmSummary');
        const confirmCancel = document.getElementById('confirmCancel');
        const confirmProceed = document.getElementById('confirmProceed');

        function showConfirm() {
            // Build a summary from student fields
            const firstName = form.querySelector('[asp-for="FirstName"]').value || '';
            const lastName = form.querySelector('[asp-for="LastName"]').value || '';
            const email = form.querySelector('[asp-for="Email"]').value || '';
            const yearLevel = form.querySelector('[asp-for="YearLevel"]').value || '';
            confirmSummary.textContent = `${firstName} ${lastName} (${email}) — Year: ${yearLevel}`;
            confirmModal.style.display = 'block';
            confirmBackdrop.style.display = 'block';
        }

        function hideConfirm() {
            confirmModal.style.display = 'none';
            confirmBackdrop.style.display = 'none';
        }

        // Intercept submit
        submitButton.addEventListener('click', function (e) {
            // If HTML5 form validation fails, don't show the modal
            if (!form.checkValidity()) return; 
            e.preventDefault();
            showConfirm();
        });

        confirmCancel.addEventListener('click', function(){ hideConfirm(); });
        confirmBackdrop.addEventListener('click', function(){ hideConfirm(); });

        // When user confirms, submit the form programmatically
        confirmProceed.addEventListener('click', function(){
            // remove listeners to avoid re-intercept on actual submit
            hideConfirm();
            form.submit();
        });
    })();
</script>

<style>
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(4px);
        z-index: 9998;
    }

    .modal-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 20px;
        pointer-events: none;
    }

    .modal-content {
        background: white;
        border-radius: 16px;
        max-width: 900px;
        width: 100%;
        max-height: 90vh;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        pointer-events: auto;
        animation: modalSlideIn 0.3s ease-out;
        display: flex;
        flex-direction: column;
    }

    @@keyframes modalSlideIn {
        from {
            opacity: 0;
            transform: translateY(-20px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    input[type="text"],
    input[type="email"],
    input[type="tel"],
    input[type="number"],
    select {
        transition: border-color 0.2s ease;
    }

    input[type="text"]:focus,
    input[type="email"]:focus,
    input[type="tel"]:focus,
    input[type="number"]:focus,
    select:focus {
        outline: none;
        border-color: #4f46e5;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
    }

    input[type="text"]:invalid:not(:placeholder-shown),
    input[type="email"]:invalid:not(:placeholder-shown) {
        border-color: #dc2626;
    }
</style>

