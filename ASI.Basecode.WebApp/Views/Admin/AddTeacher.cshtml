@using ASI.Basecode.WebApp.Models
@model TeacherCreateViewModel

@{
    Layout = "~/Views/Shared/_AuthenticatedLayout.cshtml";
    ViewData["Title"] = "Add Teacher";
}

<script src="https://cdn.tailwindcss.com"></script>

<!-- Backdrop Blur Overlay -->
<div class="modal-backdrop" onclick="window.history.back()"></div>

<!-- Modal Content -->
<div class="modal-container">
    <div class="modal-content">
        <!-- Header -->
        <div class="flex justify-between items-center px-8 py-6 bg-[#E8C7FF] rounded-t-2xl">
            <h1 class="text-2xl font-extrabold text-gray-900 m-0">Add New Teacher</h1>
            <button type="button" onclick="window.history.back()" class="bg-transparent border-none cursor-pointer text-gray-500 text-2xl p-0 w-8 h-8 flex items-center justify-center rounded-full transition-all duration-200 hover:bg-black/10">
                ×
            </button>
        </div>

        <!-- Form Content -->
        <div class="max-h-[70vh] overflow-y-auto p-8">
            @if (ViewData.ModelState.Values.SelectMany(v => v.Errors).Count() > 0)
            {
                <div class="bg-red-100 border border-red-200 rounded-lg p-4 mb-5 text-red-800">
                    <h4 class="m-0 mb-2 font-semibold">Error</h4>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p class="my-1 text-sm">@error.ErrorMessage</p>
                    }
                </div>
            }

            <form asp-controller="Admin" asp-action="AddTeacher" method="post">
                @Html.AntiForgeryToken()
                
                <!-- Personal Information Section -->
                <section class="mb-8">
                    <h2 class="text-lg font-bold text-gray-900 m-0 mb-5 pb-3 border-b-2 border-[#E8C7FF]">Personal Information</h2>
                    
                    <div class="grid grid-cols-2 gap-5 mb-5">
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">First Name <span class="text-red-600">*</span></label>
                            <input type="text" asp-for="FirstName" placeholder="e.g., Juan" class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                            <span asp-validation-for="FirstName" class="text-red-600 text-xs block mt-1"></span>
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">Last Name <span class="text-red-600">*</span></label>
                            <input type="text" asp-for="LastName" placeholder="e.g., Cruz" class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                            <span asp-validation-for="LastName" class="text-red-600 text-xs block mt-1"></span>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-5 mb-5">
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">Middle Name</label>
                            <input type="text" asp-for="MiddleName" placeholder="e.g., Santos" class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">Suffix</label>
                            <input type="text" asp-for="Suffix" placeholder="e.g., Jr., Sr." class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                        </div>
                    </div>
                </section>

                <!-- Contact Information Section -->
                <section class="mb-8">
                    <h2 class="text-lg font-bold text-gray-900 m-0 mb-5 pb-3 border-b-2 border-[#E8C7FF]">Contact Information</h2>
                    
                    <div class="grid grid-cols-2 gap-5 mb-5">
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">Email <span class="text-red-600">*</span></label>
                            <input type="email" asp-for="Email" placeholder="e.g., maria.santos@university.edu" class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                            <span asp-validation-for="Email" class="text-red-600 text-xs block mt-1"></span>
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">Contact Number <span class="text-red-600">*</span></label>
                            <input type="tel" asp-for="ContactNumber" placeholder="e.g., +63-9XX-XXX-XXXX" class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                            <span asp-validation-for="ContactNumber" class="text-red-600 text-xs block mt-1"></span>
                        </div>
                    </div>
                </section>

                <!-- Department Section -->
                <section class="mb-8">
                    <h2 class="text-lg font-bold text-gray-900 m-0 mb-5 pb-3 border-b-2 border-[#E8C7FF]">Department</h2>
                
                 <div class="grid grid-cols-1 gap-5 mb-5">
        <div>
            <label class="block font-semibold text-gray-700 mb-2 text-sm">Department <span class="text-red-600">*</span></label>
          <select asp-for="DepartmentId" class="w-full p-3 border border-gray-300 rounded-lg text-sm">
       <option value="">-- Select Department --</option>
                @if (ViewBag.Departments != null)
    {
           foreach (var dept in ViewBag.Departments)
           {
      <option value="@dept.Id">@dept.DepartmentName (@dept.DepartmentCode)</option>
        }
            }
             </select>
     <span asp-validation-for="DepartmentId" class="text-red-600 text-xs block mt-1"></span>
                 </div>
                   </div>
        </section>

                <!-- Address Information Section -->
                <section class="mb-8">
                    <h2 class="text-lg font-bold text-gray-900 m-0 mb-5 pb-3 border-b-2 border-[#E0E7FF]">Address</h2>
                    
                    <div class="grid grid-cols-2 gap-5 mb-5">
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">House Number</label>
                            <input type="text" asp-for="HouseNumber" placeholder="e.g., 123" class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">Street Name</label>
                            <input type="text" asp-for="StreetName" placeholder="e.g., Rizal Street" class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-5 mb-5">
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">Subdivision</label>
                            <input type="text" asp-for="Subdivision" placeholder="e.g., Sampaloc Subdivision" class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">Barangay <span class="text-red-600">*</span></label>
                            <input type="text" asp-for="Barangay" placeholder="e.g., San Jose" class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                            <span asp-validation-for="Barangay" class="text-red-600 text-xs block mt-1"></span>
                        </div>
                    </div>

                    <div class="grid grid-cols-3 gap-5 mb-5">
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">City <span class="text-red-600">*</span></label>
                            <input type="text" asp-for="City" placeholder="e.g., Manila" class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                            <span asp-validation-for="City" class="text-red-600 text-xs block mt-1"></span>
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">Province <span class="text-red-600">*</span></label>
                            <input type="text" asp-for="Province" placeholder="e.g., Metro Manila" class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                            <span asp-validation-for="Province" class="text-red-600 text-xs block mt-1"></span>
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">Zip Code</label>
                            <input type="text" asp-for="ZipCode" placeholder="e.g., 1016" class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                        </div>
                    </div>
                </section>

                <!-- Form Actions -->
                <div class="flex justify-end gap-3">
                    <button type="button" onclick="window.history.back()" class="px-8 py-3 rounded-md text-sm font-semibold cursor-pointer bg-white text-gray-700 border-2 border-gray-300">
                        Cancel
                    </button>
                    <button type="submit" class="px-8 py-3 rounded-md text-sm font-semibold cursor-pointer bg-purple-600 text-white border-none shadow-[0_2px_4px_rgba(124,58,237,0.2)]">
                        Create Teacher
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Confirmation Modal (hidden by default) -->
<div id="confirmModalBackdrop" class="hidden fixed inset-0 bg-black/35 backdrop-blur-sm z-[10000]" aria-hidden="true"></div>
<div id="confirmModal" class="hidden fixed left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-[10001] max-w-[520px] w-[90%] bg-white rounded-xl shadow-[0_8px_30px_rgba(0,0,0,0.2)]">
    <div class="p-5 border-b border-gray-100">
        <h3 class="m-0 text-lg font-extrabold text-gray-900">Confirm Add Teacher</h3>
        <p id="confirmSummary" class="mt-2 mb-0 text-gray-600 text-sm">Please confirm you want to add this teacher.</p>
    </div>
    <div class="flex justify-end gap-3 p-4">
        <button id="confirmCancel" type="button" class="px-[18px] py-[10px] rounded-lg border border-gray-300 bg-white cursor-pointer">Cancel</button>
        <button id="confirmProceed" type="button" class="px-[18px] py-[10px] rounded-lg border-none bg-purple-600 text-white font-bold cursor-pointer">Yes, Add Teacher</button>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<style>
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(4px);
        z-index: 9998;
    }

    .modal-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 20px;
        pointer-events: none;
    }

    .modal-content {
        background: white;
        border-radius: 16px;
        max-width: 900px;
        width: 100%;
        max-height: 90vh;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        pointer-events: auto;
        animation: modalSlideIn 0.3s ease-out;
        display: flex;
        flex-direction: column;
    }

    @@keyframes modalSlideIn {
        from {
            opacity: 0;
            transform: translateY(-20px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    input[type="text"],
    input[type="email"],
    input[type="tel"],
    input[type="number"],
    select {
        transition: border-color 0.2s ease;
    }

    input[type="text"]:focus,
    input[type="email"]:focus,
    input[type="tel"]:focus,
    input[type="number"]:focus,
    select:focus {
        outline: none;
        border-color: #7c3aed;
        box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.1);
    }

    input[type="text"]:invalid:not(:placeholder-shown),
    input[type="email"]:invalid:not(:placeholder-shown) {
        border-color: #dc2626;
    }
</style>

