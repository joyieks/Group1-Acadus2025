@using ASI.Basecode.WebApp.Models
@model CourseCreateViewModel

@{
    Layout = "~/Views/Shared/_AuthenticatedLayout.cshtml";
    ViewData["Title"] = "Add Course";
}

<!-- Backdrop Blur Overlay -->
<div class="modal-backdrop" onclick="window.history.back()"></div>

<!-- Modal Content -->
<div class="modal-container">
    <div class="modal-content">
        <!-- Header -->
        <div style="display:flex; justify-content:space-between; align-items:center; padding:24px 32px; background:#E8F9E8; border-radius:16px 16px 0 0;">
            <h1 style="font-size:24px; font-weight:800; color:#111827; margin:0;">Add New Course</h1>
            <button type="button" onclick="window.history.back()" style="background:none; border:none; cursor:pointer; color:#6b7280; font-size:24px; padding:0; width:32px; height:32px; display:flex; align-items:center; justify-content:center; border-radius:50%; transition:all 0.2s;" onmouseover="this.style.background='rgba(0,0,0,0.1)'" onmouseout="this.style.background='none'">
                ×
            </button>
        </div>

        <!-- Form Content -->
        <div style="max-height:70vh; overflow-y:auto; padding:32px;">
            @if (ViewData.ModelState.Values.SelectMany(v => v.Errors).Count() > 0)
            {
                <div style="background:#fee2e2; border:1px solid #fecaca; border-radius:8px; padding:16px; margin-bottom:20px; color:#991b1b;">
                    <h4 style="margin:0 0 8px 0; font-weight:600;">Error</h4>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p style="margin:4px 0; font-size:14px;">@error.ErrorMessage</p>
                    }
                </div>
            }

            <form asp-controller="Admin" asp-action="AddCourse" method="post">
                @Html.AntiForgeryToken()
                
                <!-- Course Information Section -->
                <section style="margin-bottom:32px;">
                    <h2 style="font-size:18px; font-weight:700; color:#111827; margin:0 0 20px 0; padding-bottom:12px; border-bottom:2px solid #E8F9E8;">Course Information</h2>
                    
                    <div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:20px; margin-bottom:20px;">
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Course Code <span style="color:#dc2626;">*</span></label>
                            <input type="text" asp-for="Code" placeholder="e.g., CS101" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;"/>
                            <span asp-validation-for="Code" style="color:#dc2626; font-size:12px; display:block; margin-top:4px;"></span>
                        </div>
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Course Name <span style="color:#dc2626;">*</span></label>
                            <input type="text" asp-for="Name" placeholder="e.g., Introduction to Computer Science" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;"/>
                            <span asp-validation-for="Name" style="color:#dc2626; font-size:12px; display:block; margin-top:4px;"></span>
                        </div>
                    </div>

                    <div style="display:grid; grid-template-columns:repeat(1, 1fr); gap:20px; margin-bottom:20px;">
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Course Description <span style="color:#dc2626;">*</span></label>
                            <textarea asp-for="Description" placeholder="Provide a detailed description of the course..." rows="4" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px; resize:vertical;"></textarea>
                            <span asp-validation-for="Description" style="color:#dc2626; font-size:12px; display:block; margin-top:4px;"></span>
                        </div>
                    </div>

                    <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:20px; margin-bottom:20px;">
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Credits <span style="color:#dc2626;">*</span></label>
                            <input type="number" asp-for="Credits" placeholder="3" min="1" max="6" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;"/>
                            <span asp-validation-for="Credits" style="color:#dc2626; font-size:12px; display:block; margin-top:4px;"></span>
                        </div>
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Level <span style="color:#dc2626;">*</span></label>
                            <select asp-for="Level" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;">
                                <option value="">-- Select a Level --</option>
                                @foreach (var level in Model.Levels)
                                {
                                    <option value="@level.Value">@level.Label</option>
                                }
                            </select>
                            <span asp-validation-for="Level" style="color:#dc2626; font-size:12px; display:block; margin-top:4px;"></span>
                        </div>
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Semester <span style="color:#dc2626;">*</span></label>
                            <select asp-for="SemesterId" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;">
                                <option value="">-- Select a Semester --</option>
                                @foreach (var semester in Model.Semesters)
                                {
                                    <option value="@semester.Id">@semester.SemesterName</option>
                                }
                            </select>
                            <span asp-validation-for="SemesterId" style="color:#dc2626; font-size:12px; display:block; margin-top:4px;"></span>
                        </div>
                    </div>

                    <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:20px; margin-bottom:20px;">
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Maximum Capacity <span style="color:#dc2626;">*</span></label>
                            <input type="number" asp-for="MaxCapacity" placeholder="30" min="1" max="500" step="1" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;"/>
                            <span asp-validation-for="MaxCapacity" style="color:#dc2626; font-size:12px; display:block; margin-top:4px;"></span>
                        </div>
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Instructor <span style="color:#dc2626;">*</span></label>
                            <select asp-for="InstructorId" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;">
                                <option value="">-- Select an Instructor --</option>
                                @foreach (var instructor in Model.Instructors)
                                {
                                    <option value="@instructor.UserTypeId">@instructor.FullName</option>
                                }
                            </select>
                            <span asp-validation-for="InstructorId" style="color:#dc2626; font-size:12px; display:block; margin-top:4px;"></span>
                        </div>
                        <div>
                            <label style="display:block; font-weight:600; color:#374151; margin-bottom:8px; font-size:14px;">Status <span style="color:#dc2626;">*</span></label>
                            <select asp-for="Status" style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:14px;">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                            <span asp-validation-for="Status" style="color:#dc2626; font-size:12px; display:block; margin-top:4px;"></span>
                        </div>
                    </div>
                </section>

                <!-- Form Actions -->
                <div style="display:flex; justify-content:flex-end; gap:12px;">
                    <button type="button" onclick="window.history.back()" style="padding:12px 32px; border-radius:6px; font-size:14px; font-weight:600; cursor:pointer; background:#ffffff; color:#374151; border:2px solid #d1d5db;">
                        Cancel
                    </button>
                    <button type="submit" style="padding:12px 32px; border-radius:6px; font-size:14px; font-weight:600; cursor:pointer; background:#059669; color:#ffffff; border:none; box-shadow:0 2px 4px rgba(5,150,105,0.2);">
                        Create Course
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Confirmation Modal (hidden by default) -->
<div id="confirmModalBackdrop" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.35); backdrop-filter:blur(3px); z-index:10000;" aria-hidden="true"></div>
<div id="confirmModal" style="display:none; position:fixed; left:50%; top:50%; transform:translate(-50%,-50%); z-index:10001; max-width:520px; width:90%; background:#fff; border-radius:12px; box-shadow:0 8px 30px rgba(0,0,0,0.2);">
    <div style="padding:20px; border-bottom:1px solid #eef2f7;">
        <h3 style="margin:0; font-size:18px; font-weight:800; color:#111827;">Confirm Create Course</h3>
        <p id="confirmSummary" style="margin:8px 0 0 0; color:#4b5563; font-size:14px;">Please confirm you want to create this course.</p>
    </div>
    <div style="display:flex; justify-content:flex-end; gap:12px; padding:16px;">
        <button id="confirmCancel" type="button" style="padding:10px 18px; border-radius:8px; border:1px solid #d1d5db; background:#fff; cursor:pointer;">Cancel</button>
        <button id="confirmProceed" type="button" style="padding:10px 18px; border-radius:8px; border:none; background:#059669; color:#fff; font-weight:700; cursor:pointer;">Yes, Create</button>
    </div>
</div>

<script>
    (function(){
        const form = document.querySelector('form[asp-controller="Admin"][asp-action="AddCourse"]');
        if (!form) return;

        const submitButton = form.querySelector('button[type="submit"]');
        const confirmModal = document.getElementById('confirmModal');
        const confirmBackdrop = document.getElementById('confirmModalBackdrop');
        const confirmSummary = document.getElementById('confirmSummary');
        const confirmCancel = document.getElementById('confirmCancel');
        const confirmProceed = document.getElementById('confirmProceed');

        function showConfirm() {
            // Build a small summary from important fields
            const code = form.querySelector('[asp-for="Code"]').value || '';
            const name = form.querySelector('[asp-for="Name"]').value || '';
            const level = form.querySelector('[asp-for="Level"]').value || '';
            const sem = form.querySelector('[asp-for="SemesterId"]').value || '';
            confirmSummary.textContent = `Course: ${name} (${code}) — Level: ${level} — Semester ID: ${sem}`;
            confirmModal.style.display = 'block';
            confirmBackdrop.style.display = 'block';
        }

        function hideConfirm() {
            confirmModal.style.display = 'none';
            confirmBackdrop.style.display = 'none';
        }

        // Intercept submit
        submitButton.addEventListener('click', function (e) {
            // If HTML5 form validation fails, don't show the modal
            if (!form.checkValidity()) return; 
            e.preventDefault();
            showConfirm();
        });

        confirmCancel.addEventListener('click', function(){ hideConfirm(); });
        confirmBackdrop.addEventListener('click', function(){ hideConfirm(); });

        // When user confirms, submit the form programmatically
        confirmProceed.addEventListener('click', function(){
            // remove listeners to avoid re-intercept on actual submit
            hideConfirm();
            form.submit();
        });
    })();
</script>

<style>
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(4px);
        z-index: 9998;
    }

    .modal-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 20px;
        pointer-events: none;
    }

    .modal-content {
        background: white;
        border-radius: 16px;
        max-width: 900px;
        width: 100%;
        max-height: 90vh;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        pointer-events: auto;
        animation: modalSlideIn 0.3s ease-out;
        display: flex;
        flex-direction: column;
    }

    @@keyframes modalSlideIn {
        from {
            opacity: 0;
            transform: translateY(-20px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    input[type="text"],
    input[type="number"],
    select {
        transition: border-color 0.2s ease;
    }

    input[type="text"]:focus,
    input[type="number"]:focus,
    select:focus {
        outline: none;
        border-color: #059669;
        box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.1);
    }

    input[type="text"]:invalid:not(:placeholder-shown),
    input[type="number"]:invalid:not(:placeholder-shown) {
        border-color: #dc2626;
    }
</style>

