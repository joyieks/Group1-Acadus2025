@using ASI.Basecode.WebApp.Models
@model CourseCreateViewModel

@{
    Layout = "~/Views/Shared/_AuthenticatedLayout.cshtml";
    ViewData["Title"] = "Add Course";
}

<script src="https://cdn.tailwindcss.com"></script>

<!-- Backdrop Blur Overlay -->
<div class="modal-backdrop" onclick="window.history.back()"></div>

<!-- Modal Content -->
<div class="modal-container">
    <div class="modal-content">
        <!-- Header -->
        <div class="flex justify-between items-center px-8 py-6 bg-[#E8F9E8] rounded-t-2xl">
            <h1 class="text-2xl font-extrabold text-gray-900 m-0">Add New Course</h1>
            <button type="button" onclick="window.history.back()" class="bg-transparent border-none cursor-pointer text-gray-500 text-2xl p-0 w-8 h-8 flex items-center justify-center rounded-full transition-all duration-200 hover:bg-black/10">
                ×
            </button>
        </div>

        <!-- Form Content -->
        <div class="max-h-[70vh] overflow-y-auto p-8">
            @if (ViewData.ModelState.Values.SelectMany(v => v.Errors).Count() > 0)
            {
                <div class="bg-red-100 border border-red-200 rounded-lg p-4 mb-5 text-red-800">
                    <h4 class="m-0 mb-2 font-semibold">Error</h4>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p class="my-1 text-sm">@error.ErrorMessage</p>
                    }
                </div>
            }

            <form asp-controller="Admin" asp-action="AddCourse" method="post">
                @Html.AntiForgeryToken()
                
                <!-- Course Information Section -->
                <section class="mb-8">
                    <h2 class="text-lg font-bold text-gray-900 m-0 mb-5 pb-3 border-b-2 border-[#E8F9E8]">Course Information</h2>
                    
                    <div class="grid grid-cols-2 gap-5 mb-5">
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">Course Code <span class="font-normal text-gray-500 text-xs">(Auto-generated)</span></label>
                            <input type="text" asp-for="Code" id="courseCodeInput" readonly placeholder="Will be generated automatically" class="w-full p-3 border border-gray-300 rounded-lg text-sm bg-gray-100 cursor-not-allowed" value=""/>
                            <small class="text-gray-500 text-xs block mt-1">Course code will be generated automatically based on Year Level</small>
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">Course Name <span class="text-red-600">*</span></label>
                            <input type="text" asp-for="Name" placeholder="e.g., Introduction to Computer Science" class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                            <span asp-validation-for="Name" class="text-red-600 text-xs block mt-1"></span>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-5 mb-5">
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">Course Description <span class="text-red-600">*</span></label>
                            <textarea asp-for="Description" placeholder="Provide a detailed description of the course..." rows="4" class="w-full p-3 border border-gray-300 rounded-lg text-sm resize-y"></textarea>
                            <span asp-validation-for="Description" class="text-red-600 text-xs block mt-1"></span>
                        </div>
                    </div>

                    <div class="grid grid-cols-3 gap-5 mb-5">
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">Units <span class="text-red-600">*</span></label>
                            <input type="number" asp-for="Credits" placeholder="3" min="1" max="6" class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                            <span asp-validation-for="Credits" class="text-red-600 text-xs block mt-1"></span>
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">Year Level <span class="text-red-600">*</span></label>
                            <select asp-for="Level" class="w-full p-3 border border-gray-300 rounded-lg text-sm">
                                <option value="">-- Select a Year Level --</option>
                                @if (Model.Levels != null && Model.Levels.Count > 0)
                                {
                                @foreach (var level in Model.Levels)
                                    {
                                        <option value="@level.Value">@level.Label</option>
                                    }
                                }
                                else
                                {
                                    <option value="1st Year">1st Year</option>
                                    <option value="2nd Year">2nd Year</option>
                                    <option value="3rd Year">3rd Year</option>
                                    <option value="4th Year">4th Year</option>
                                }
                            </select>
                            <span asp-validation-for="Level" class="text-red-600 text-xs block mt-1"></span>
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">Semester <span class="text-red-600">*</span></label>
                            <select asp-for="SemesterId" class="w-full p-3 border border-gray-300 rounded-lg text-sm">
                                <option value="">-- Select a Semester --</option>
                                @foreach (var semester in Model.Semesters)
                                {
                                    <option value="@semester.Id">@semester.SemesterName</option>
                                }
                            </select>
                            <span asp-validation-for="SemesterId" class="text-red-600 text-xs block mt-1"></span>
                        </div>
                    </div>

                    <div class="grid grid-cols-3 gap-5 mb-5">
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">Maximum Capacity <span class="text-red-600">*</span></label>
                            <input type="number" asp-for="MaxCapacity" placeholder="30" min="1" max="50" step="1" class="w-full p-3 border border-gray-300 rounded-lg text-sm"/>
                            <span asp-validation-for="MaxCapacity" class="text-red-600 text-xs block mt-1"></span>
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">Instructor <span class="text-red-600">*</span></label>
                            <select asp-for="InstructorId" class="w-full p-3 border border-gray-300 rounded-lg text-sm">
                                <option value="">-- Select an Instructor --</option>
                                @foreach (var instructor in Model.Instructors)
                                {
                                    <option value="@instructor.UserTypeId">@instructor.FullName</option>
                                }
                            </select>
                            <span asp-validation-for="InstructorId" class="text-red-600 text-xs block mt-1"></span>
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-2 text-sm">Status <span class="text-red-600">*</span></label>
                            <select asp-for="Status" class="w-full p-3 border border-gray-300 rounded-lg text-sm">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                            <span asp-validation-for="Status" class="text-red-600 text-xs block mt-1"></span>
                        </div>
                    </div>
                </section>

                <!-- Form Actions -->
                <div class="flex justify-end gap-3">
                    <button type="button" onclick="window.history.back()" class="px-8 py-3 rounded-md text-sm font-semibold cursor-pointer bg-white text-gray-700 border-2 border-gray-300">
                        Cancel
                    </button>
                    <button type="submit" class="px-8 py-3 rounded-md text-sm font-semibold cursor-pointer bg-emerald-600 text-white border-none shadow-[0_2px_4px_rgba(5,150,105,0.2)]">
                        Create Course
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Confirmation Modal (hidden by default) -->
<div id="confirmModalBackdrop" class="hidden fixed inset-0 bg-black/35 backdrop-blur-sm z-[10000]" aria-hidden="true"></div>
<div id="confirmModal" class="hidden fixed left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-[10001] max-w-[520px] w-[90%] bg-white rounded-xl shadow-[0_8px_30px_rgba(0,0,0,0.2)]">
    <div class="p-5 border-b border-gray-100">
        <h3 class="m-0 text-lg font-extrabold text-gray-900">Confirm Create Course</h3>
        <p id="confirmSummary" class="mt-2 mb-0 text-gray-600 text-sm">Please confirm you want to create this course.</p>
    </div>
    <div class="flex justify-end gap-3 p-4">
        <button id="confirmCancel" type="button" class="px-[18px] py-[10px] rounded-lg border border-gray-300 bg-white cursor-pointer">Cancel</button>
        <button id="confirmProceed" type="button" class="px-[18px] py-[10px] rounded-lg border-none bg-emerald-600 text-white font-bold cursor-pointer">Yes, Create</button>
    </div>
</div>

<script>
    (function(){
        const form = document.querySelector('form[asp-controller="Admin"][asp-action="AddCourse"]');
        if (!form) return;

        const submitButton = form.querySelector('button[type="submit"]');
        const confirmModal = document.getElementById('confirmModal');
        const confirmBackdrop = document.getElementById('confirmModalBackdrop');
        const confirmSummary = document.getElementById('confirmSummary');
        const confirmCancel = document.getElementById('confirmCancel');
        const confirmProceed = document.getElementById('confirmProceed');
        const courseCodeInput = document.getElementById('courseCodeInput');
        const levelSelect = form.querySelector('select[name="Level"]');

        // Generate course code when year level changes
        if (levelSelect && courseCodeInput) {
            levelSelect.addEventListener('change', async function() {
                const selectedLevel = this.value;
                if (selectedLevel) {
                    // Show loading state
                    courseCodeInput.value = 'Generating...';
                    courseCodeInput.style.color = '#6b7280';
                    
                    try {
                        // Call API to generate course code
                        const response = await fetch(`/Admin/GenerateCourseCode?level=${encodeURIComponent(selectedLevel)}`);
                        const data = await response.json();
                        
                        if (data.success) {
                            courseCodeInput.value = data.code;
                            courseCodeInput.style.color = '#111827';
                        } else {
                            courseCodeInput.value = '';
                            courseCodeInput.placeholder = 'Error generating code';
                            console.error('Error generating code:', data.message);
                        }
                    } catch (error) {
                        courseCodeInput.value = '';
                        courseCodeInput.placeholder = 'Error generating code';
                        console.error('Error:', error);
                    }
                } else {
                    courseCodeInput.value = '';
                    courseCodeInput.placeholder = 'Will be generated automatically';
                    courseCodeInput.style.color = '#111827';
                }
            });
        }

        function showConfirm() {
            // Build a small summary from important fields
            const name = form.querySelector('input[name="Name"]').value || '';
            const level = form.querySelector('select[name="Level"]').value || '';
            const sem = form.querySelector('select[name="SemesterId"]').value || '';
            const codePreview = courseCodeInput ? courseCodeInput.value : 'Auto-generated';
            confirmSummary.textContent = `Course: ${name} (Code: ${codePreview}) — Level: ${level} — Semester ID: ${sem}`;
            confirmModal.classList.remove('hidden');
            confirmBackdrop.classList.remove('hidden');
        }

        function hideConfirm() {
            confirmModal.classList.add('hidden');
            confirmBackdrop.classList.add('hidden');
        }

        // Intercept submit
        submitButton.addEventListener('click', function (e) {
            // If HTML5 form validation fails, don't show the modal
            if (!form.checkValidity()) return; 
            e.preventDefault();
            showConfirm();
        });

        confirmCancel.addEventListener('click', function(){ hideConfirm(); });
        confirmBackdrop.addEventListener('click', function(){ hideConfirm(); });

        // When user confirms, submit the form programmatically
        confirmProceed.addEventListener('click', function(){
            // remove listeners to avoid re-intercept on actual submit
            hideConfirm();
            form.submit();
        });
    })();
</script>

<style>
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(4px);
        z-index: 9998;
    }

    .modal-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 20px;
        pointer-events: none;
    }

    .modal-content {
        background: white;
        border-radius: 16px;
        max-width: 900px;
        width: 100%;
        max-height: 90vh;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        pointer-events: auto;
        animation: modalSlideIn 0.3s ease-out;
        display: flex;
        flex-direction: column;
    }

    @@keyframes modalSlideIn {
        from {
            opacity: 0;
            transform: translateY(-20px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    input[type="text"],
    input[type="number"],
    select {
        transition: border-color 0.2s ease;
    }

    input[type="text"]:focus,
    input[type="number"]:focus,
    select:focus {
        outline: none;
        border-color: #059669;
        box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.1);
    }

    input[type="text"]:invalid:not(:placeholder-shown),
    input[type="number"]:invalid:not(:placeholder-shown) {
        border-color: #dc2626;
    }
</style>

