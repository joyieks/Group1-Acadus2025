@using ASI.Basecode.WebApp.Models
@model UsersTableViewModel

@{
    Layout = "~/Views/Shared/_AuthenticatedLayout.cshtml";
    ViewData["Title"] = "Users";
}

<script src="https://cdn.tailwindcss.com"></script>

<section class="bg-[#E8F9E8] pb-6">
	<div class="container max-w-[1200px] mx-auto px-4">
		<!-- Header -->
		<div class="text-center py-6">
			<h1 class="text-[28px] font-extrabold m-0 mb-1">USERS</h1>
			<p class="m-0 text-gray-600">Create, manage, and view all your users</p>
		</div>

		<!-- KPI cards -->
		<div class="grid grid-cols-2 gap-6 max-w-[800px] mx-auto">
			<div class="bg-white rounded-xl py-[15px] px-6 text-center min-w-[200px] min-h-[120px] flex flex-col justify-center">
				<div class="flex items-center justify-center mb-2 text-gray-500">
					<span class="mr-2">≡</span>
					<span class="text-sm">Students</span>
				</div>
				<div class="text-4xl font-extrabold text-emerald-800">
					@(Model != null ? Model.TotalStudents : 0)
				</div>
			</div>

			<div class="bg-white rounded-xl py-[15px] px-6 text-center min-w-[200px] min-h-[120px] flex flex-col justify-center">
				<div class="flex items-center justify-center mb-2 text-gray-500">
					<span class="mr-2">≡</span>
					<span class="text-sm">Instructors</span>
				</div>
				<div class="text-4xl font-extrabold text-emerald-800">
					@(Model != null ? Model.TotalInstructors : 0)
				</div>
			</div>
		</div>
	</div>
</section>

<!-- White section with search and table -->
<section class="bg-white py-6">
	<div class="container max-w-[1200px] mx-auto px-4">
		
		@* Success modal markup (renders only if TempData["UserSuccessMessage"] is set) *@
		@if (TempData["UserSuccessMessage"] != null)
		{
			<div id="successModalBackdrop" class="fixed inset-0 bg-black/35 backdrop-blur-sm z-[10000]"></div>
			<div id="successModal" class="fixed left-1/2 top-[20%] -translate-x-1/2 z-[10001] max-w-[520px] w-[90%] bg-white rounded-xl shadow-[0_8px_30px_rgba(0,0,0,0.2)]">
				<div class="p-5 border-b border-gray-100">
					<h3 class="m-0 text-lg font-extrabold text-gray-900">Success</h3>
					<p class="mt-2 mb-0 text-gray-600 text-sm">@TempData["UserSuccessMessage"]</p>
				</div>
				<div class="flex justify-end gap-3 p-4">
					<a href="@Url.Action("Users", "Admin")" class="py-2.5 px-[18px] rounded-lg border border-gray-300 bg-white text-gray-700 no-underline">Close</a>
				</div>
			</div>
		}
		<!-- Search bar and Add buttons -->
		<div class="flex justify-between items-center mb-6 gap-3 flex-wrap">
			<div class="flex items-center gap-3 flex-wrap">
				<form method="get" asp-action="Users" class="flex items-center gap-3 flex-1 min-w-[350px] max-w-[700px]">
					<input type="hidden" name="tab" value="@Model?.ActiveTab" />
					<input type="hidden" name="status" value="@Model?.ActiveStatus" />
					<input type="text" name="search" placeholder="Search by name or ID number" 
						   value="@Model?.SearchTerm"
						   class="flex-1 min-w-[280px] py-2.5 px-4 border border-gray-300 rounded-lg text-sm bg-white">
					<button type="submit" class="bg-emerald-600 text-white border-none rounded-lg py-2.5 px-6 font-semibold cursor-pointer whitespace-nowrap">Search</button>
					
					<!-- Status Filter Dropdown - positioned beside Search button -->
					<select id="statusFilter" onchange="filterByStatus()" class="py-2.5 px-4 border border-gray-300 rounded-lg text-sm bg-white cursor-pointer">
						<option value="all" selected="@(Model?.ActiveStatus == "all" || string.IsNullOrEmpty(Model?.ActiveStatus))">All Status</option>
						<option value="active" selected="@(Model?.ActiveStatus == "active")">Active Only</option>
						<option value="inactive" selected="@(Model?.ActiveStatus == "inactive")">Inactive Only</option>
					</select>
					
					@if (!string.IsNullOrWhiteSpace(Model?.SearchTerm))
					{
						<a asp-action="Users" asp-route-tab="@Model.ActiveTab" asp-route-status="@Model.ActiveStatus" class="bg-gray-500 text-white border-none rounded-lg py-2.5 px-6 font-semibold cursor-pointer no-underline">Clear</a>
					}
				</form>
			</div>

			<div class="flex items-center gap-3">
				<a id="addStudentBtn" asp-controller="Admin" asp-action="AddStudent" class="hidden bg-emerald-600 text-white border-none rounded-lg py-2.5 px-6 font-semibold cursor-pointer no-underline min-w-[140px] text-center">Add Student</a>
				<a id="addTeacherBtn" asp-controller="Admin" asp-action="AddTeacher" class="hidden bg-emerald-600 text-white border-none rounded-lg py-2.5 px-6 font-semibold cursor-pointer no-underline min-w-[140px] text-center">Add Teacher</a>
			</div>
		</div>

		<!-- Tabs -->
		<div class="flex gap-0 bg-emerald-600 p-0 rounded-t-lg overflow-hidden">
			<a id="tabAll" asp-action="Users" asp-route-tab="all" asp-route-search="@Model?.SearchTerm" asp-route-status="@Model?.ActiveStatus"
			   class="bg-emerald-600 text-white border-none py-3 px-6 font-semibold cursor-pointer rounded-none relative border-b-[3px] transition-all duration-300 no-underline @(Model?.ActiveTab == "all" ? "border-b-[#84FFC2]" : "border-b-transparent")">All users</a>
			<a id="tabStudents" asp-action="Users" asp-route-tab="students" asp-route-search="@Model?.SearchTerm" asp-route-status="@Model?.ActiveStatus"
			   class="bg-emerald-600 border-none py-3 px-6 font-semibold cursor-pointer rounded-none relative border-b-[3px] transition-all duration-300 no-underline @(Model?.ActiveTab == "students" ? "text-white border-b-[#84FFC2]" : "text-white/70 border-b-transparent")">Students (@(Model?.Students.Count ?? 0))</a>
			<a id="tabInstructors" asp-action="Users" asp-route-tab="instructors" asp-route-search="@Model?.SearchTerm" asp-route-status="@Model?.ActiveStatus"
			   class="bg-emerald-600 border-none py-3 px-6 font-semibold cursor-pointer rounded-none relative border-b-[3px] transition-all duration-300 no-underline @(Model?.ActiveTab == "instructors" ? "text-white border-b-[#84FFC2]" : "text-white/70 border-b-transparent")">Instructors (@(Model?.Instructors.Count ?? 0))</a>
		</div>

		<!-- Table -->
		<div class="bg-white rounded-b-xl overflow-hidden shadow-sm">
			<table class="w-full border-collapse bg-white">
				<thead>
					<tr class="bg-gray-50 border-b-2 border-gray-200">
						<th class="py-3 px-4 text-left font-bold text-gray-900">ID No.</th>
						<th class="py-3 px-4 text-left font-bold text-gray-900">Name</th>
						<th class="py-3 px-4 text-left font-bold text-gray-900">Role</th>
						<th class="py-3 px-4 text-left font-bold text-gray-900">Status</th>
						<th class="py-3 px-4 text-left font-bold text-gray-900">Actions</th>
					</tr>
				</thead>
				<tbody>
					@if (Model?.DisplayedUsersWithRoles != null && Model.DisplayedUsersWithRoles.Count > 0)
					{
						int rowNumber = 1;
						foreach (var entry in Model.DisplayedUsersWithRoles)
						{
							var debugUserTypeId = entry.User.UserTypeId ?? "NULL";
							var userDisplay = $"{entry.User.FirstName} {entry.User.LastName}";
							Console.WriteLine($"🔍 ROW DEBUG - User: {userDisplay}, UserTypeId: '{debugUserTypeId}', Length: {debugUserTypeId.Length}");
							
							if (string.IsNullOrWhiteSpace(entry.User.UserTypeId))
							{
								Console.WriteLine($"   ⚠️  WARNING: UserTypeId is NULL/EMPTY for {userDisplay}");
							}
							else
							{
								Console.WriteLine($"   ✅ UserTypeId is valid for {userDisplay}");
							}
							<tr class="border-b border-gray-200" data-user-id="@entry.User.Id" data-user-type-id="@(string.IsNullOrWhiteSpace(entry.User.UserTypeId) ? "" : entry.User.UserTypeId)">
								<td class="py-4 px-4 text-gray-900">
									@if (!string.IsNullOrWhiteSpace(entry.User.UserDisplayId))
									{
										@entry.User.UserDisplayId
									}
									else
									{
										@rowNumber
									}
								</td>
								<td class="py-4 px-4 text-gray-900">@UsersTableViewModel.GetFullName(entry.User)</td>
								<td class="py-4 px-4 text-gray-900">@entry.GetRoleNames()</td>
								<td class="py-4 px-4">
									@if (entry.User.IsActive == true)
									{
										<span class="bg-emerald-100 text-emerald-800 py-1.5 px-3.5 rounded-2xl text-[13px] font-semibold">Active</span>
									}
									else
									{
										<span class="bg-gray-200 text-gray-600 py-1.5 px-3.5 rounded-2xl text-[13px] font-semibold">Inactive</span>
									}
								</td>
								<td class="py-4 px-4 relative">
									<button class="action-menu-btn bg-transparent border-none text-2xl font-extrabold cursor-pointer py-1 px-2 leading-none">⋮</button>
									<div class="action-menu hidden absolute right-10 top-1/2 -translate-y-1/2 bg-white border border-gray-200 rounded-lg shadow-[0_4px_12px_rgba(0,0,0,0.15)] min-w-[130px] z-10">
										<button class="block w-full py-2.5 px-4 border-none bg-transparent text-left cursor-pointer text-gray-900 text-sm" onclick="navigateToView(this)">View</button>
										<button class="block w-full py-2.5 px-4 border-none bg-transparent text-left cursor-pointer text-gray-900 text-sm" onclick="navigateToEdit(this)">Edit</button>
										@{
											var hasValidUserTypeId = !string.IsNullOrWhiteSpace(entry.User.UserTypeId);
											var disabledStyle = !hasValidUserTypeId ? "opacity-50 cursor-not-allowed" : "";
										}
										@if (entry.User.IsActive == true)
										{
											<button class="deactivate-action block w-full py-2.5 px-4 border-none bg-transparent text-left text-red-600 text-sm @disabledStyle @(hasValidUserTypeId ? "cursor-pointer" : "cursor-not-allowed")" onclick="@(hasValidUserTypeId ? "showDeactivateModal(this)" : "alert('Cannot deactivate: User has invalid/missing Supabase ID')")" title="@(!hasValidUserTypeId ? "This user cannot be deactivated due to missing Supabase ID" : "")">Deactivate</button>
										}
										else
										{
											<button class="reactivate-action block w-full py-2.5 px-4 border-none bg-transparent text-left text-emerald-600 text-sm @disabledStyle @(hasValidUserTypeId ? "cursor-pointer" : "cursor-not-allowed")" onclick="@(hasValidUserTypeId ? "showReactivateModal(this)" : "alert('Cannot reactivate: User has invalid/missing Supabase ID')")" title="@(!hasValidUserTypeId ? "This user cannot be reactivated due to missing Supabase ID" : "")">Reactivate</button>
										}
									</div>
								</td>
							</tr>
							rowNumber++;
						}
					}
					else
					{
						<tr class="border-b border-gray-200">
							<td colspan="5" class="py-8 px-4 text-center text-gray-500">
								@if (Model?.SearchTerm != null)
								{
									<p class="m-0">No users found matching "@Model.SearchTerm"</p>
								}
								else
								{
									<p class="m-0">No users available</p>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Tab logic for showing/hiding Add buttons
    const tabAll = document.getElementById('tabAll');
    const tabStudents = document.getElementById('tabStudents');
    const tabInstructors = document.getElementById('tabInstructors');
    const addStudentBtn = document.getElementById('addStudentBtn');
    const addTeacherBtn = document.getElementById('addTeacherBtn');

    function updateAddButtons() {
        // Hide both by default
        addStudentBtn.style.display = 'none';
        addTeacherBtn.style.display = 'none';
        // Show based on active tab
        if (window.location.href.includes('tab=students')) {
            addStudentBtn.style.display = 'inline-block';
        } else if (window.location.href.includes('tab=instructors')) {
            addTeacherBtn.style.display = 'inline-block';
        }
    }

    // Initial state
    updateAddButtons();

    // Add click listeners to tabs
    tabAll.addEventListener('click', function() {
        setTimeout(updateAddButtons, 100);
    });
    tabStudents.addEventListener('click', function() {
        setTimeout(updateAddButtons, 100);
    });
    tabInstructors.addEventListener('click', function() {
        setTimeout(updateAddButtons, 100);
    });
});

// Status filter function
function filterByStatus() {
    const statusValue = document.getElementById('statusFilter').value;
    const urlParams = new URLSearchParams(window.location.search);
    
    // Update status parameter
    urlParams.set('status', statusValue);
    
    // Preserve other parameters
    const tab = urlParams.get('tab') || 'all';
    const search = urlParams.get('search') || '';
    
    // Build new URL
    let newUrl = '@Url.Action("Users", "Admin")' + '?tab=' + tab + '&status=' + statusValue;
    if (search) {
        newUrl += '&search=' + encodeURIComponent(search);
    }
    
    // Navigate to new URL
    window.location.href = newUrl;
}
</script>

<!-- Deactivate Modal -->
<div id="deactivateModal" class="hidden fixed top-0 left-0 w-full h-full bg-black/50 z-[1000] items-center justify-center">
    <div class="bg-white rounded-xl p-8 max-w-[400px] w-[90%] my-5 shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1),0_10px_10px_-5px_rgba(0,0,0,0.04)]">
        <div class="text-center mb-6">
            <div class="w-16 h-16 rounded-full bg-red-50 flex items-center justify-center mx-auto mb-4">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 m-0 mb-2">Deactivate User</h3>
            <p class="text-gray-500 text-sm m-0" id="deactivateModalText">Are you sure you want to deactivate this user? This action will prevent them from accessing the system.</p>
        </div>
        <div class="flex gap-3">
            <button onclick="hideDeactivateModal()" class="flex-1 bg-gray-100 text-gray-700 border border-gray-300 rounded-md py-3 px-4 font-semibold cursor-pointer">Cancel</button>
            <button onclick="confirmDeactivate()" class="flex-1 bg-red-600 text-white border-none rounded-md py-3 px-4 font-semibold cursor-pointer">Deactivate</button>
        </div>
    </div>
</div>

<!-- Reactivate Modal -->
<div id="reactivateModal" class="hidden fixed top-0 left-0 w-full h-full bg-black/50 z-[1000] items-center justify-center">
    <div class="bg-white rounded-xl p-8 max-w-[400px] w-[90%] my-5 shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1),0_10px_10px_-5px_rgba(0,0,0,0.04)]">
        <div class="text-center mb-6">
            <div class="w-16 h-16 rounded-full bg-emerald-100 flex items-center justify-center mx-auto mb-4">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20,6 9,17 4,12"></polyline>
                </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 m-0 mb-2">Reactivate User</h3>
            <p class="text-gray-500 text-sm m-0" id="reactivateModalText">Are you sure you want to reactivate this user? This will restore their access to the system.</p>
        </div>
        <div class="flex gap-3">
            <button onclick="hideReactivateModal()" class="flex-1 bg-gray-100 text-gray-700 border border-gray-300 rounded-md py-3 px-4 font-semibold cursor-pointer">Cancel</button>
            <button onclick="confirmReactivate()" class="flex-1 bg-emerald-600 text-white border-none rounded-md py-3 px-4 font-semibold cursor-pointer">Reactivate</button>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div id="successModal" class="hidden fixed top-0 left-0 w-full h-full bg-black/50 z-[1000] items-center justify-center">
    <div class="bg-white rounded-xl p-8 max-w-[400px] w-[90%] my-5 shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1),0_10px_10px_-5px_rgba(0,0,0,0.04)]">
        <div class="text-center mb-6">
            <div class="w-16 h-16 rounded-full bg-emerald-100 flex items-center justify-center mx-auto mb-4">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20,6 9,17 4,12"></polyline>
                </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 m-0 mb-2">Success</h3>
            <p class="text-gray-500 text-sm m-0" id="successModalText">Operation completed successfully.</p>
        </div>
        <div class="flex justify-center">
            <button onclick="closeSuccessModal()" class="flex-1 bg-emerald-600 text-white border-none rounded-md py-3 px-4 font-semibold cursor-pointer">Close</button>
        </div>
    </div>
</div>

<script>
	function navigateToView(button) {
		const row = button.closest('tr');
		const userId = row ? row.getAttribute('data-user-id') : '';
		
		console.log('Navigating to view - User ID:', userId);
		
		// Validate userId before navigation
		if (!userId || userId === 'null' || userId === 'undefined' || userId === '0' || userId === '') {
			console.error('❌ Invalid user ID:', userId);
			alert('Error: Invalid user ID. Cannot view user details.');
			return;
		}
		
		// Parse and validate as integer
		const userIdInt = parseInt(userId);
		if (isNaN(userIdInt) || userIdInt <= 0) {
			console.error('❌ Invalid user ID after parsing:', userIdInt);
			alert('Error: Invalid user ID. Cannot view user details.');
			return;
		}
		
		// ✅ FIX: Route ALL users (students and teachers) to ViewUser action
		// ViewUser.cshtml already handles both roles dynamically
		window.location.href = '@Url.Action("ViewUser", "Admin")?id=' + userIdInt;
	}
	
	function navigateToEdit(button) {
		const row = button.closest('tr');
		const userId = row ? row.getAttribute('data-user-id') : '';
		
		console.log('Navigating to edit - User ID:', userId);
		
		// Validate userId before navigation
		if (!userId || userId === 'null' || userId === 'undefined' || userId === '0' || userId === '') {
			console.error('❌ Invalid user ID:', userId);
			alert('Error: Invalid user ID. Cannot edit user.');
			return;
		}
		
		// Parse and validate as integer
		const userIdInt = parseInt(userId);
		if (isNaN(userIdInt) || userIdInt <= 0) {
			console.error('❌ Invalid user ID after parsing:', userIdInt);
			alert('Error: Invalid user ID. Cannot edit user.');
			return;
		}
		
		// ✅ CRITICAL: Pass ID as URL parameter (not route parameter)
		window.location.href = '@Url.Action("EditUser", "Admin")?id=' + userIdInt;
	}
	
	let currentActionRow = null;
	
	function showDeactivateModal(button) {
		console.log('🔵 showDeactivateModal called');
		currentActionRow = button.closest('tr');
		const nameCell = currentActionRow.cells[1];
		const name = nameCell ? nameCell.textContent.trim() : 'this user';
		
		// DEBUG: Log all data attributes on the row
		console.log('Current action row attributes:');
		for (let attr of currentActionRow.attributes) {
			console.log(`  ${attr.name}: "${attr.value}"`);
		}
		
		console.log('🔍 Data attributes directly:');
		console.log('  data-user-id:', currentActionRow.getAttribute('data-user-id'));
		console.log('  data-user-type-id:', currentActionRow.getAttribute('data-user-type-id'));
		
		document.getElementById('deactivateModalText').textContent = `Are you sure you want to deactivate ${name}? This action will prevent them from accessing the system.`;
		document.getElementById('deactivateModal').style.display = 'flex';
	}
	
	function hideDeactivateModal() {
		document.getElementById('deactivateModal').style.display = 'none';
		currentActionRow = null;
	}
	
	function confirmDeactivate() {
		const rowToUpdate = currentActionRow; // Capture local reference
		if (rowToUpdate) {
			const userTypeId = rowToUpdate.getAttribute('data-user-type-id');
			const debugUserTypeId = rowToUpdate.getAttribute('data-debug-user-type-id');
			const nameCell = rowToUpdate.cells[1];
			const name = nameCell ? nameCell.textContent.trim() : 'this user';
			
			// ✅ ADDED: Validation and logging
			console.log('╔══════════════════════════════════════════════════════════╗');
			console.log('║         confirmDeactivate                               ║');
			console.log('╚══════════════════════════════════════════════════════════╝');
			console.log('User TypeID (UUID) from data-user-type-id:', userTypeId);
			console.log('User TypeID (UUID) from data-debug-user-type-id:', debugUserTypeId);
			console.log('User Name:', name);
			
			if (!userTypeId || userTypeId === 'null' || userTypeId === 'undefined' || userTypeId === '') {
				console.error('❌ Invalid user TypeID:', userTypeId);
				alert(`❌ ERROR: Cannot deactivate "${name}"\n\nThis user does not have a valid Supabase ID in the database. This is a data integrity issue.\n\nPlease contact an administrator to fix this user's record.`);
				hideDeactivateModal();
				return;
			}
			
			console.log('✅ Validation passed. Sending request...');
			
			// ⚡ OPTIMISTIC UPDATE: Update UI immediately
			const statusCell = rowToUpdate.cells[3];
			const statusSpan = statusCell.querySelector('span');
			const deactivateBtn = rowToUpdate.querySelector('.deactivate-action');
			const reactivateBtn = rowToUpdate.querySelector('.reactivate-action');
			
			if (statusSpan) {
				statusSpan.textContent = 'Inactive';
				statusSpan.style.background = '#e5e7eb';
				statusSpan.style.color = '#4b5563';
			}
			
			if (deactivateBtn) deactivateBtn.style.display = 'none';
			if (reactivateBtn) reactivateBtn.style.display = 'block';
			
			fetch('/Admin/SetUserStatus', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ id: userTypeId, isActive: false })
			})
			.then(response => {
				console.log('Response status:', response.status);
				console.log('Response statusText:', response.statusText);
				return response.json();
			})
			.then(data => {
				console.log('Response data:', data);
				if (data.success) {
					console.log('✅ User deactivated successfully (Server confirmed)');
					showSuccessModal(`${name} has been deactivated successfully.`);
				} else {
					console.error('❌ Deactivation failed:', data.message);
					// Revert UI changes
					if (statusSpan) {
						statusSpan.textContent = 'Active';
						statusSpan.style.background = '#d1fae5';
						statusSpan.style.color = '#065f46';
					}
					if (deactivateBtn) deactivateBtn.style.display = 'block';
					if (reactivateBtn) reactivateBtn.style.display = 'none';
					
					alert(data.message || 'Failed to deactivate user.');
				}
			})
			.catch(error => {
				console.error('❌ Error during fetch:', error);
				// Revert UI changes
				if (statusSpan) {
					statusSpan.textContent = 'Active';
					statusSpan.style.background = '#d1fae5';
					statusSpan.style.color = '#065f46';
				}
				if (deactivateBtn) deactivateBtn.style.display = 'block';
				if (reactivateBtn) reactivateBtn.style.display = 'none';
				
				alert('An error occurred: ' + error.message);
			});
		} else {
			console.error('❌ No current action row found');
		}
		hideDeactivateModal();
	}
	
	function showReactivateModal(button) {
		currentActionRow = button.closest('tr');
		const nameCell = currentActionRow.cells[1];
		const name = nameCell ? nameCell.textContent.trim() : 'this user';
		
		document.getElementById('reactivateModalText').textContent = `Are you sure you want to reactivate ${name}? This will restore their access to the system.`;
		document.getElementById('reactivateModal').style.display = 'flex';
	}
	
	function hideReactivateModal() {
		document.getElementById('reactivateModal').style.display = 'none';
		currentActionRow = null;
	}

	function showSuccessModal(message) {
		document.getElementById('successModalText').textContent = message;
		document.getElementById('successModal').style.display = 'flex';
	}

	function closeSuccessModal() {
		document.getElementById('successModal').style.display = 'none';
	}
	
	function confirmReactivate() {
		const rowToUpdate = currentActionRow; // Capture local reference
		if (rowToUpdate) {
			const userTypeId = rowToUpdate.getAttribute('data-user-type-id');
			const nameCell = rowToUpdate.cells[1];
			const name = nameCell ? nameCell.textContent.trim() : 'this user';
			
			// ✅ ADDED: Validation and logging
			console.log('╔══════════════════════════════════════════════════════════╗');
			console.log('║         confirmReactivate                               ║');
			console.log('╚══════════════════════════════════════════════════════════╝');
			console.log('User TypeID (UUID):', userTypeId);
			console.log('User Name:', name);
			
			if (!userTypeId || userTypeId === 'null' || userTypeId === 'undefined' || userTypeId === '') {
				console.error('❌ Invalid user TypeID:', userTypeId);
				alert(`❌ ERROR: Cannot reactivate "${name}"\n\nThis user does not have a valid Supabase ID in the database. This is a data integrity issue.\n\nPlease contact an administrator to fix this user's record.`);
				hideReactivateModal();
				return;
			}
			
			console.log('✅ Validation passed. Sending request...');
			
			// ⚡ OPTIMISTIC UPDATE: Update UI immediately
			const statusCell = rowToUpdate.cells[3];
			const statusSpan = statusCell.querySelector('span');
			const deactivateBtn = rowToUpdate.querySelector('.deactivate-action');
			const reactivateBtn = rowToUpdate.querySelector('.reactivate-action');
			
			if (statusSpan) {
				statusSpan.textContent = 'Active';
				statusSpan.style.background = '#d1fae5';
				statusSpan.style.color = '#065f46';
			}
			
			if (reactivateBtn) reactivateBtn.style.display = 'none';
			if (deactivateBtn) deactivateBtn.style.display = 'block';
			
			fetch('/Admin/SetUserStatus', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ id: userTypeId, isActive: true })
			})
			.then(response => {
				console.log('Response status:', response.status);
				return response.json();
			})
			.then(data => {
				console.log('Response data:', data);
				if (data.success) {
					console.log('✅ User reactivated successfully (Server confirmed)');
					showSuccessModal(`${name} has been reactivated successfully.`);
				} else {
					console.error('❌ Reactivation failed:', data.message);
					// Revert UI changes
					if (statusSpan) {
						statusSpan.textContent = 'Inactive';
						statusSpan.style.background = '#e5e7eb';
						statusSpan.style.color = '#4b5563';
					}
					if (reactivateBtn) reactivateBtn.style.display = 'block';
					if (deactivateBtn) deactivateBtn.style.display = 'none';
					
					alert(data.message || 'Failed to reactivate user.');
				}
			})
			.catch(error => {
				console.error('❌ Error during fetch:', error);
				// Revert UI changes
				if (statusSpan) {
					statusSpan.textContent = 'Inactive';
					statusSpan.style.background = '#e5e7eb';
					statusSpan.style.color = '#4b5563';
				}
				if (reactivateBtn) reactivateBtn.style.display = 'block';
				if (deactivateBtn) deactivateBtn.style.display = 'none';
				
				alert('An error occurred: ' + error.message);
			});
		} else {
			console.error('❌ No current action row found');
		}
		hideReactivateModal();
	}
	
	document.addEventListener('DOMContentLoaded', function() {
		const actionBtns = document.querySelectorAll('.action-menu-btn');
		
		actionBtns.forEach(btn => {
			btn.addEventListener('click', function(e) {
				e.stopPropagation();
				const menu = this.nextElementSibling;
				
				document.querySelectorAll('.action-menu').forEach(m => {
					if (m !== menu) m.style.display = 'none';
				});
				
				menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
			});
		});
		
		document.addEventListener('click', function() {
			document.querySelectorAll('.action-menu').forEach(menu => {
				menu.style.display = 'none';
			});
		});
	});

	window.onclick = function(event) {
		const deactivateModal = document.getElementById('deactivateModal');
		const reactivateModal = document.getElementById('reactivateModal');
		
		if (event.target === deactivateModal) hideDeactivateModal();
		if (event.target === reactivateModal) hideReactivateModal();
	}
</script>

