                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20,6 9,17 4,12"></polyline>
                </svg>
            </div>
            <h3 style="font-size:18px; font-weight:700; color:#111827; margin:0 0 8px 0;">Reactivate User</h3>
            <p style="color:#6b7280; font-size:14px; margin:0;" id="reactivateModalText">Are you sure you want to reactivate this user? This will restore their access to the system.</p>
        </div>
        <div style="display:flex; gap:12px;">
            <button onclick="hideReactivateModal()" style="flex:1; background:#f3f4f6; color:#374151; border:1px solid #d1d5db; border-radius:6px; padding:12px; font-weight:600; cursor:pointer;">Cancel</button>
            <button onclick="confirmReactivate()" style="flex:1; background:#059669; color:#ffffff; border:none; border-radius:6px; padding:12px; font-weight:600; cursor:pointer;">Reactivate</button>
        </div>
    </div>
</div>

<script>
	function navigateToView(button) {
		// Find the row and extract the ID number from the first cell and role from the third cell
		const row = button.closest('tr');
		const idCell = row?.cells?.[0];
		const roleCell = row?.cells?.[2];
		const id = idCell ? idCell.textContent.trim() : '';
		const role = roleCell ? roleCell.textContent.trim() : '';
		
		// Navigate to appropriate view based on role
		if (role === 'Teacher') {
			window.location.href = '@Url.Action("ViewTeacher", "Admin")' + (id ? ('?id=' + encodeURIComponent(id)) : '');
		} else {
			window.location.href = '@Url.Action("ViewUser", "Admin")' + (id ? ('?id=' + encodeURIComponent(id)) : '');
		}
	}
	
	function navigateToEdit(button) {
		// Find the row and extract the user ID from the data attribute
		const row = button.closest('tr');
		const userId = row ? row.getAttribute('data-user-id') : '';
		
		// Navigate to EditUser action
		window.location.href = '@Url.Action("EditUser", "Admin")' + (userId ? ('?id=' + encodeURIComponent(userId)) : '');
	}
	
	// Global variable to store the current row being acted upon
	let currentActionRow = null;
	
	function showDeactivateModal(button) {
		currentActionRow = button.closest('tr');
		const nameCell = currentActionRow.cells[1]; // Name column
		const roleCell = currentActionRow.cells[2]; // Role column
		const name = nameCell ? nameCell.textContent.trim() : 'this user';
		const role = roleCell ? roleCell.textContent.trim().toLowerCase() : 'user';
		
		document.getElementById('deactivateModalText').textContent = `Are you sure you want to deactivate ${name}? This action will prevent them from accessing the system.`;
		document.getElementById('deactivateModal').style.display = 'flex';
	}
	
	function hideDeactivateModal() {
		document.getElementById('deactivateModal').style.display = 'none';
		currentActionRow = null;
	}
	
	function confirmDeactivate() {
		if (currentActionRow) {
			const statusCell = currentActionRow.cells[4]; // Status column
			const statusSpan = statusCell.querySelector('span');
			const deactivateBtn = currentActionRow.querySelector('.deactivate-action');
			const reactivateBtn = currentActionRow.querySelector('.reactivate-action');
			
			// Update status to inactive
			statusSpan.textContent = 'Inactive';
			statusSpan.style.background = '#e5e7eb';
			statusSpan.style.color = '#4b5563';
			
			// Toggle action buttons
			deactivateBtn.style.display = 'none';
			reactivateBtn.style.display = 'block';
			
			// TODO: Implement actual deactivation logic (API call)
			alert('User deactivated successfully');
		}
		hideDeactivateModal();
	}
	
	function showReactivateModal(button) {
		currentActionRow = button.closest('tr');
		const nameCell = currentActionRow.cells[1]; // Name column
		const name = nameCell ? nameCell.textContent.trim() : 'this user';
		
		document.getElementById('reactivateModalText').textContent = `Are you sure you want to reactivate ${name}? This will restore their access to the system.`;
		document.getElementById('reactivateModal').style.display = 'flex';
	}
	
	function hideReactivateModal() {
		document.getElementById('reactivateModal').style.display = 'none';
		currentActionRow = null;
	}
	
	function confirmReactivate() {
		if (currentActionRow) {
			const statusCell = currentActionRow.cells[4]; // Status column
			const statusSpan = statusCell.querySelector('span');
			const deactivateBtn = currentActionRow.querySelector('.deactivate-action');
			const reactivateBtn = currentActionRow.querySelector('.reactivate-action');
			
			// Update status to active
			statusSpan.textContent = 'Active';
			statusSpan.style.background = '#d1fae5';
			statusSpan.style.color = '#065f46';
			
			// Toggle action buttons
			reactivateBtn.style.display = 'none';
			deactivateBtn.style.display = 'block';
			
			// TODO: Implement actual reactivation logic (API call)
			alert('User reactivated successfully');
		}
		hideReactivateModal();
	}
	
	// Toggle action menu dropdowns
	document.addEventListener('DOMContentLoaded', function() {
		const actionBtns = document.querySelectorAll('.action-menu-btn');
		
		actionBtns.forEach(btn => {
			btn.addEventListener('click', function(e) {
				e.stopPropagation();
				const menu = this.nextElementSibling;
				
				// Close all other menus
				document.querySelectorAll('.action-menu').forEach(m => {
					if (m !== menu) m.style.display = 'none';
				});
				
				// Toggle current menu
				menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
			});
		});
		
		// Close menus when clicking outside
		document.addEventListener('click', function() {
			document.querySelectorAll('.action-menu').forEach(menu => {
				menu.style.display = 'none';
			});
		});

		// Tab switching with animated underline and filtering
		const tabBtns = document.querySelectorAll('.tab-btn');
		const tableRows = document.querySelectorAll('tbody tr');
		const addStudentBtn = document.getElementById('addStudentBtn');
		const addTeacherBtn = document.getElementById('addTeacherBtn');
		
		tabBtns.forEach(btn => {
			btn.addEventListener('click', function() {
				// Remove active class from all tabs
				tabBtns.forEach(tab => {
					tab.classList.remove('active');
					tab.style.color = 'rgba(255,255,255,0.7)';
					tab.style.borderBottom = '3px solid transparent';
				});
				
				// Add active class to clicked tab
				this.classList.add('active');
				this.style.color = '#fff';
				this.style.borderBottom = '3px solid #84FFC2';
				
				// Filter table rows based on selected tab
				const tabText = this.textContent.trim();
				
				// Hide all buttons first
				addStudentBtn.style.display = 'none';
				addTeacherBtn.style.display = 'none';
				
				tableRows.forEach(row => {
					const roleCell = row.cells[2]; // Role column is at index 2
					const roleText = roleCell.textContent.trim();
					
					if (tabText === 'All users') {
						// Show all rows, no add button
						row.style.display = '';
					} else if (tabText === 'Students') {
						// Show only students, show Add Student button
						if (roleText === 'Student') {
							row.style.display = '';
						} else {
							row.style.display = 'none';
						}
						addStudentBtn.style.display = 'block';
					} else if (tabText === 'Teachers') {
						// Show only teachers, show Add Teacher button
						if (roleText === 'Teacher') {
							row.style.display = '';
						} else {
							row.style.display = 'none';
						}
						addTeacherBtn.style.display = 'block';
					}
				});
			});
		});
	});


// Close modals when clicking outside
window.onclick = function(event) {
	const deactivateModal = document.getElementById('deactivateModal');
	const reactivateModal = document.getElementById('reactivateModal');
	
	if (event.target === deactivateModal) {
		hideDeactivateModal();
	}
	if (event.target === reactivateModal) {
		hideReactivateModal();
	}
}
</script>

