@model List<ASI.Basecode.Data.Models.AuditLogModel>
@{
    Layout = null;
    var currentRole = ViewBag.CurrentRole as string ?? "all";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recent Activity</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        }

        @@keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @@keyframes slideUp {
            from { transform: translateY(30px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        .activity-item:hover {
            background: #f9fafb;
        }

        .activity-item.highlighted {
            background: #E8F9E8;
        }

        .role-tab:hover {
            background: rgba(5, 150, 105, 0.1);
            color: #059669;
        }

        .role-tab.active {
            color: #059669;
            border-bottom-color: #059669;
            background: rgba(5, 150, 105, 0.05);
        }
    </style>
</head>
<body>
    <div class="fixed top-0 left-0 w-full h-full bg-black/50 backdrop-blur-lg flex items-center justify-center z-[1000] animate-[fadeIn_0.3s_ease] overflow-y-auto p-5">
        <div class="bg-white rounded-2xl w-full max-w-[800px] max-h-[90vh] overflow-y-auto shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1)] animate-[slideUp_0.3s_ease] my-auto" onclick="event.stopPropagation()">
            <!-- Header -->
            <div class="bg-[#E8F9E8] pt-6 px-8 pb-0 rounded-t-2xl">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-2xl font-extrabold text-gray-900 m-0">Recent Activity</h2>
                    <button id="closeBtn" class="bg-transparent border-none text-[28px] text-gray-500 cursor-pointer w-8 h-8 rounded-md transition-all duration-200">&times;</button>
                </div>

                <!-- Role Filter Tabs -->
                <div class="flex gap-0 border-b-2 border-emerald-200 bg-[#E8F9E8]">
                    <a href="@Url.Action("RecentActivity", "Admin", new { role = "all" })" 
                       class="role-tab flex-1 py-3 px-4 bg-transparent border-none text-sm font-semibold text-gray-500 cursor-pointer transition-all duration-200 no-underline text-center border-b-[3px] border-transparent @(currentRole == "all" ? "active" : "")">
                        All
                    </a>
                    <a href="@Url.Action("RecentActivity", "Admin", new { role = "admin" })" 
                       class="role-tab flex-1 py-3 px-4 bg-transparent border-none text-sm font-semibold text-gray-500 cursor-pointer transition-all duration-200 no-underline text-center border-b-[3px] border-transparent @(currentRole == "admin" ? "active" : "")">
                        Admin
                    </a>
                    <a href="@Url.Action("RecentActivity", "Admin", new { role = "teacher" })" 
                       class="role-tab flex-1 py-3 px-4 bg-transparent border-none text-sm font-semibold text-gray-500 cursor-pointer transition-all duration-200 no-underline text-center border-b-[3px] border-transparent @(currentRole == "teacher" ? "active" : "")">
                        Teachers
                    </a>
                    <a href="@Url.Action("RecentActivity", "Admin", new { role = "student" })" 
                       class="role-tab flex-1 py-3 px-4 bg-transparent border-none text-sm font-semibold text-gray-500 cursor-pointer transition-all duration-200 no-underline text-center border-b-[3px] border-transparent @(currentRole == "student" ? "active" : "")">
                        Students
                    </a>
                </div>
            </div>

            <!-- Activity List -->
            <div class="py-6 px-8">
                @if (Model != null && Model.Any())
                {
                    <div class="rounded-lg overflow-hidden border border-gray-200">
                        @{
                            var rowIndex = 0;
                        }
                        @foreach (var activity in Model)
                        {
                            var isHighlighted = rowIndex % 2 == 0;
                            var dateTime = activity.CreatedAt.Kind == DateTimeKind.Utc ? activity.CreatedAt.ToLocalTime() : activity.CreatedAt;
                            var formattedDate = dateTime.ToString("MMMM dd, yyyy, hh:mm tt");
                            var highlightedClass = isHighlighted ? "highlighted" : "";

                            <div class="activity-item p-4 border-b border-gray-200 transition-colors duration-200 last:border-b-0 @highlightedClass">
                                <div class="font-bold text-gray-900 mb-1">@activity.ActionDescription</div>
                                <div class="text-gray-500 text-sm flex justify-between">
                                    <span>@activity.UserName</span>
                                    <span>@formattedDate</span>
                                </div>
                            </div>

                            rowIndex++;
                        }
                    </div>
                }
                else
                {
                    <div class="py-16 px-8 text-center">
                        <div class="text-5xl text-gray-300 mb-4">📋</div>
                        <div class="text-lg font-bold text-gray-900 mb-2">No Recent Activity</div>
                        <div class="text-sm text-gray-500">
                            @if (currentRole == "all")
                            {
                                <text>There are no activities to display yet. Activities will appear here as users interact with the system.</text>
                            }
                            else
                            {
                                <text>No activities found for @(char.ToUpper(currentRole[0]) + currentRole.Substring(1)) users.</text>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Footer -->
            <div class="py-5 px-8 bg-gray-50 border-t border-gray-200 rounded-b-2xl flex justify-center">
                <button id="closeFooterBtn" class="py-3 px-8 rounded-md text-sm font-semibold cursor-pointer bg-emerald-600 text-white border-none">Close</button>
            </div>
        </div>
    </div>

    <script>
        // Close modal and go back to dashboard
        function closeModal() {
            window.location.href = '@Url.Action("Dashboard", "Admin")';
        }

        // Close on ESC key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeModal();
        });

        // Close when clicking backdrop
        document.querySelector('.fixed').addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });

        // Close button in header
        document.getElementById('closeBtn').addEventListener('click', closeModal);

        // Close button in footer
        document.getElementById('closeFooterBtn').addEventListener('click', closeModal);
    </script>
</body>
</html>

