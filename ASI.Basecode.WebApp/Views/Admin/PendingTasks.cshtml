@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pending Tasks</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        }

        @@keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @@keyframes slideUp {
            from { transform: translateY(30px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        .task-item:hover {
            background: #f9fafb;
        }
    </style>
</head>
<body>
    <div class="fixed top-0 left-0 w-full h-full bg-black/50 backdrop-blur-lg flex items-center justify-center z-[1000] animate-[fadeIn_0.3s_ease] overflow-y-auto p-5" onclick="if(event.target === this) window.history.back()">
        <div class="bg-white rounded-2xl w-full max-w-[900px] max-h-[90vh] overflow-y-auto shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1)] animate-[slideUp_0.3s_ease] my-auto" onclick="event.stopPropagation()">
            <!-- Header -->
            <div class="bg-[#E8F9E8] py-6 px-8 rounded-t-2xl flex justify-between items-center border-b-2 border-emerald-200">
                <h2 class="text-2xl font-extrabold text-gray-900 m-0">Pending Tasks</h2>
                <button onclick="window.history.back()" class="bg-transparent border-none text-[28px] text-gray-500 cursor-pointer w-8 h-8 rounded-md transition-all duration-200">&times;</button>
            </div>

            <!-- Task List -->
            <div class="py-6 px-8">
                <div class="rounded-lg overflow-hidden border border-gray-200">
                    <!-- Task Item 1 -->
                    <div class="task-item p-4 border-b border-gray-200 flex justify-between items-center transition-colors duration-200 last:border-b-0">
                        <div>
                            <div class="font-bold text-gray-900 mb-1">Review new student application</div>
                            <div class="text-gray-500 text-sm">Submitted by: Admissions Office</div>
                        </div>
                        <div class="flex gap-2">
                            <button onclick="showConfirmation('approve', 'Review new student application')" class="bg-[#76C7C0] text-white border-none py-2 px-4 rounded-full cursor-pointer text-[13px] font-semibold">Approve</button>
                            <button onclick="showConfirmation('reject', 'Review new student application')" class="bg-[#E57373] text-white border-none py-2 px-4 rounded-full cursor-pointer text-[13px] font-semibold">Reject</button>
                        </div>
                    </div>

                    <!-- Task Item 2 -->
                    <div class="task-item p-4 border-b border-gray-200 flex justify-between items-center transition-colors duration-200 last:border-b-0">
                        <div>
                            <div class="font-bold text-gray-900 mb-1">Approve teacher leave request</div>
                            <div class="text-gray-500 text-sm">Requested by: John Smith</div>
                        </div>
                        <div class="flex gap-2">
                            <button onclick="showConfirmation('approve', 'Approve teacher leave request')" class="bg-[#76C7C0] text-white border-none py-2 px-4 rounded-full cursor-pointer text-[13px] font-semibold">Approve</button>
                            <button onclick="showConfirmation('reject', 'Approve teacher leave request')" class="bg-[#E57373] text-white border-none py-2 px-4 rounded-full cursor-pointer text-[13px] font-semibold">Reject</button>
                        </div>
                    </div>

                    <!-- Task Item 3 -->
                    <div class="task-item p-4 border-b border-gray-200 flex justify-between items-center transition-colors duration-200 last:border-b-0">
                        <div>
                            <div class="font-bold text-gray-900 mb-1">Verify course enrollment</div>
                            <div class="text-gray-500 text-sm">Student: Jane Doe</div>
                        </div>
                        <div class="flex gap-2">
                            <button onclick="showConfirmation('approve', 'Verify course enrollment')" class="bg-[#76C7C0] text-white border-none py-2 px-4 rounded-full cursor-pointer text-[13px] font-semibold">Approve</button>
                            <button onclick="showConfirmation('reject', 'Verify course enrollment')" class="bg-[#E57373] text-white border-none py-2 px-4 rounded-full cursor-pointer text-[13px] font-semibold">Reject</button>
                        </div>
                    </div>

                    <!-- Task Item 4 -->
                    <div class="task-item p-4 border-b border-gray-200 flex justify-between items-center transition-colors duration-200 last:border-b-0">
                        <div>
                            <div class="font-bold text-gray-900 mb-1">Schedule change request</div>
                            <div class="text-gray-500 text-sm">Department: Computer Science</div>
                        </div>
                        <div class="flex gap-2">
                            <button onclick="showConfirmation('approve', 'Schedule change request')" class="bg-[#76C7C0] text-white border-none py-2 px-4 rounded-full cursor-pointer text-[13px] font-semibold">Approve</button>
                            <button onclick="showConfirmation('reject', 'Schedule change request')" class="bg-[#E57373] text-white border-none py-2 px-4 rounded-full cursor-pointer text-[13px] font-semibold">Reject</button>
                        </div>
                    </div>

                    <!-- Task Item 5 -->
                    <div class="task-item p-4 border-b border-gray-200 flex justify-between items-center transition-colors duration-200 last:border-b-0">
                        <div>
                            <div class="font-bold text-gray-900 mb-1">Budget approval request</div>
                            <div class="text-gray-500 text-sm">Submitted by: Finance Department</div>
                        </div>
                        <div class="flex gap-2">
                            <button onclick="showConfirmation('approve', 'Budget approval request')" class="bg-[#76C7C0] text-white border-none py-2 px-4 rounded-full cursor-pointer text-[13px] font-semibold">Approve</button>
                            <button onclick="showConfirmation('reject', 'Budget approval request')" class="bg-[#E57373] text-white border-none py-2 px-4 rounded-full cursor-pointer text-[13px] font-semibold">Reject</button>
                        </div>
                    </div>

                    <!-- Task Item 6 -->
                    <div class="task-item p-4 border-b border-gray-200 flex justify-between items-center transition-colors duration-200 last:border-b-0">
                        <div>
                            <div class="font-bold text-gray-900 mb-1">Grade dispute resolution</div>
                            <div class="text-gray-500 text-sm">Student: Mark Johnson</div>
                        </div>
                        <div class="flex gap-2">
                            <button onclick="showConfirmation('approve', 'Grade dispute resolution')" class="bg-[#76C7C0] text-white border-none py-2 px-4 rounded-full cursor-pointer text-[13px] font-semibold">Approve</button>
                            <button onclick="showConfirmation('reject', 'Grade dispute resolution')" class="bg-[#E57373] text-white border-none py-2 px-4 rounded-full cursor-pointer text-[13px] font-semibold">Reject</button>
                        </div>
                    </div>

                    <!-- Task Item 7 -->
                    <div class="task-item p-4 border-b border-gray-200 flex justify-between items-center transition-colors duration-200 last:border-b-0">
                        <div>
                            <div class="font-bold text-gray-900 mb-1">Room reservation approval</div>
                            <div class="text-gray-500 text-sm">Requested by: Student Council</div>
                        </div>
                        <div class="flex gap-2">
                            <button onclick="showConfirmation('approve', 'Room reservation approval')" class="bg-[#76C7C0] text-white border-none py-2 px-4 rounded-full cursor-pointer text-[13px] font-semibold">Approve</button>
                            <button onclick="showConfirmation('reject', 'Room reservation approval')" class="bg-[#E57373] text-white border-none py-2 px-4 rounded-full cursor-pointer text-[13px] font-semibold">Reject</button>
                        </div>
                    </div>

                    <!-- Task Item 8 -->
                    <div class="task-item p-4 border-b border-gray-200 flex justify-between items-center transition-colors duration-200 last:border-b-0">
                        <div>
                            <div class="font-bold text-gray-900 mb-1">Faculty hiring recommendation</div>
                            <div class="text-gray-500 text-sm">Department: Mathematics</div>
                        </div>
                        <div class="flex gap-2">
                            <button onclick="showConfirmation('approve', 'Faculty hiring recommendation')" class="bg-[#76C7C0] text-white border-none py-2 px-4 rounded-full cursor-pointer text-[13px] font-semibold">Approve</button>
                            <button onclick="showConfirmation('reject', 'Faculty hiring recommendation')" class="bg-[#E57373] text-white border-none py-2 px-4 rounded-full cursor-pointer text-[13px] font-semibold">Reject</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="py-5 px-8 bg-gray-50 border-t border-gray-200 rounded-b-2xl flex justify-center">
                <button onclick="window.history.back()" class="py-3 px-8 rounded-md text-sm font-semibold cursor-pointer bg-emerald-600 text-white border-none">Close</button>
            </div>
        </div>
    </div>

    <!-- Confirmation Modal -->
    <div id="confirmationModal" class="hidden fixed top-0 left-0 w-full h-full bg-black/60 backdrop-blur-sm items-center justify-center z-[2000] animate-[fadeIn_0.2s_ease]">
        <div class="bg-white rounded-xl p-8 max-w-[400px] w-[90%] shadow-[0_20px_25px_-5px_rgba(0,0,0,0.2)] animate-[slideUp_0.3s_ease] text-center" id="confirmationBox">
            <!-- Content will be dynamically inserted -->
        </div>
    </div>

    <script>
        let currentAction = '';
        let currentTask = '';

        function showConfirmation(action, taskTitle) {
            currentAction = action;
            currentTask = taskTitle;
            
            const modal = document.getElementById('confirmationModal');
            const box = document.getElementById('confirmationBox');
            
            if (action === 'approve') {
                box.innerHTML = `
                    <div class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-5 text-[32px] bg-emerald-200 text-emerald-600">✓</div>
                    <h3 class="text-xl font-extrabold text-gray-900 mb-3">Approve Task?</h3>
                    <p class="text-sm text-gray-500 mb-6">Are you sure you want to approve "${taskTitle}"?</p>
                    <div class="flex gap-3 justify-center">
                        <button onclick="closeConfirmation()" class="py-[10px] px-6 rounded-md text-sm font-semibold cursor-pointer bg-white text-gray-600 border border-gray-300">Cancel</button>
                        <button onclick="confirmAction()" class="py-[10px] px-6 rounded-md text-sm font-semibold cursor-pointer bg-[#76C7C0] text-white border-none">Yes, Approve</button>
                    </div>
                `;
            } else {
                box.innerHTML = `
                    <div class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-5 text-[32px] bg-red-100 text-red-600">✕</div>
                    <h3 class="text-xl font-extrabold text-gray-900 mb-3">Reject Task?</h3>
                    <p class="text-sm text-gray-500 mb-6">Are you sure you want to reject "${taskTitle}"?</p>
                    <div class="flex gap-3 justify-center">
                        <button onclick="closeConfirmation()" class="py-[10px] px-6 rounded-md text-sm font-semibold cursor-pointer bg-white text-gray-600 border border-gray-300">Cancel</button>
                        <button onclick="confirmAction()" class="py-[10px] px-6 rounded-md text-sm font-semibold cursor-pointer bg-[#E57373] text-white border-none">Yes, Reject</button>
                    </div>
                `;
            }
            
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeConfirmation() {
            const modal = document.getElementById('confirmationModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function confirmAction() {
            const box = document.getElementById('confirmationBox');
            
            // Show success message
            if (currentAction === 'approve') {
                box.innerHTML = `
                    <div class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-5 text-[32px] bg-emerald-200 text-emerald-600">✓</div>
                    <h3 class="text-xl font-extrabold text-gray-900 mb-3">Task Approved!</h3>
                    <p class="text-sm text-gray-500 mb-6">The task "${currentTask}" has been approved successfully.</p>
                    <button onclick="closeConfirmation()" class="py-[10px] px-6 rounded-md text-sm font-semibold cursor-pointer bg-emerald-600 text-white border-none mt-2">Close</button>
                `;
            } else {
                box.innerHTML = `
                    <div class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-5 text-[32px] bg-emerald-200 text-emerald-600">✓</div>
                    <h3 class="text-xl font-extrabold text-gray-900 mb-3">Task Rejected!</h3>
                    <p class="text-sm text-gray-500 mb-6">The task "${currentTask}" has been rejected.</p>
                    <button onclick="closeConfirmation()" class="py-[10px] px-6 rounded-md text-sm font-semibold cursor-pointer bg-emerald-600 text-white border-none mt-2">Close</button>
                `;
            }
            
            // TODO: Implement actual approve/reject logic here
        }

        // Close on ESC key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                const confirmModal = document.getElementById('confirmationModal');
                if (!confirmModal.classList.contains('hidden')) {
                    closeConfirmation();
                } else {
                    window.history.back();
                }
            }
        });

        // Close confirmation modal when clicking outside
        document.getElementById('confirmationModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeConfirmation();
            }
        });
    </script>
</body>
</html>

