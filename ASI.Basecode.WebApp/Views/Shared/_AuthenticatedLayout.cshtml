        @{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}

@using ASI.Basecode.Resources.Views

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Acadus</title>
    <link rel="icon" type="image/png" href="~/img/acaduslogo.png" />
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'acadus-green': '#337D58',
                        'white-fill': '#F0FFF9',
                        'lighter-shade': '#6CA9BA',
                        'mid-color': '#77F77F',
                        'darker-shade': '#337D58',
                    },
                    fontFamily: {
                        'poppins': ['Poppins', 'sans-serif'],
                        'geologica': ['Geologica', 'sans-serif'],
                    },
                }
            }
        }
    </script>

</head>
<body class="min-h-screen flex flex-col bg-gray-50">
    @await Html.PartialAsync("_Navbar")

    <!-- Main Body -->
    <main class="flex-grow">
        @RenderBody()
    </main>

    @await Html.PartialAsync("_Footer")

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script>
        var currentController = '@controller';
        (function() {
            const notifBtn = document.getElementById('notifBtn');
            let notifPanel = document.getElementById('notifPanel');
            const userMenuBtn = document.getElementById('userMenuBtn');
            const userAvatarBtn = document.getElementById('userAvatarBtn');
            let userMenu = document.getElementById('userMenu');
            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const mobileMenu = document.getElementById('mobileMenu');
            const mobileMenuCloseBtn = document.getElementById('mobileMenuCloseBtn');

            function ensurePanel(id) {
                let el = document.getElementById(id);
                if (!el) {
                    el = document.createElement('div');
                    el.id = id;
                    el.className = 'hidden';
                    document.body.appendChild(el);
                }
                return el;
            }

            // Ensure notification panel exists so the script never throws
            if (!notifPanel) notifPanel = document.getElementById('notifPanel') || ensurePanel('notifPanel');

            // ------------------ Notifications ------------------
            async function loadDropdown() {
                if (!notifPanel) return;
                try {
                    const response = await fetch('/' + currentController + '/NotificationDropdown', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    const html = await response.text();
                    notifPanel.innerHTML = html;
                    positionNotifPanel();
                    const root = notifPanel.querySelector('[data-count]');
                    const count = root ? parseInt(root.getAttribute('data-count') || '0') : 0;
                    const dot = document.getElementById('notifDot');
                    if (dot) dot.style.display = count > 0 ? 'block' : 'none';
                } catch (e) { console.error(e); }
            }

            (async function initNotifDot() {
                try {
                    const res = await fetch('/' + currentController + '/NotificationCount', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    const data = await res.json();
                    const dot = document.getElementById('notifDot');
                    if (dot) dot.style.display = (data && data.count > 0) ? 'block' : 'none';
                } catch (_) {}
            })();

            function openNotif() {
                if (!notifPanel) return;
                if (notifPanel.parentElement !== document.body) {
                    document.body.appendChild(notifPanel);
                }
                notifPanel.style.position = 'fixed';
                notifPanel.style.zIndex = '999999';
                notifPanel.classList.remove('hidden');
                loadDropdown();
                positionNotifPanel();
            }

            function closeNotif() {
                if (!notifPanel) return;
                notifPanel.classList.add('hidden');
                notifPanel.innerHTML = '';
            }

            function positionNotifPanel() {
                if (!notifBtn || !notifPanel) return;
                const rect = notifBtn.getBoundingClientRect();
                const top = rect.bottom + 8;
                const right = (window.innerWidth - rect.right) + 6;
                notifPanel.style.top = top + 'px';
                notifPanel.style.right = right + 'px';
            }

            function toggleNotif(e) {
                if (e) { e.preventDefault(); e.stopPropagation(); }
                if (!notifPanel) return;
                if (notifPanel.classList.contains('hidden')) {
                    openNotif();
                    if (userMenu) userMenu.classList.add('hidden');
                } else {
                    closeNotif();
                }
            }

            if (notifBtn) {
                notifBtn.addEventListener('click', toggleNotif);
            }

            // ------------------ User Menu (moved to body to avoid stacking context issues) ------------------
            function positionUserMenu() {
                if (!userMenu) return;
                const ref = userAvatarBtn || userMenuBtn;
                if (!ref) return;
                const rect = ref.getBoundingClientRect();
                const top = rect.bottom + 8;
                const right = (window.innerWidth - rect.right) + 6;
                userMenu.style.top = top + 'px';
                userMenu.style.right = right + 'px';
            }

            function openUserMenu() {
                if (!userMenu) return;
                if (userMenu.parentElement !== document.body) {
                    document.body.appendChild(userMenu);
                }
                userMenu.style.position = 'fixed';
                userMenu.style.zIndex = '999999';
                userMenu.classList.remove('hidden');
                positionUserMenu();
                if (notifPanel) closeNotif();
            }

            function closeUserMenu() {
                if (!userMenu) return;
                userMenu.classList.add('hidden');
            }

            function toggleUserMenu(e) {
                if (e) { e.preventDefault(); e.stopPropagation(); }
                if (!userMenu) return;
                if (userMenu.classList.contains('hidden')) {
                    openUserMenu();
                } else {
                    closeUserMenu();
                }
            }

            if (userMenuBtn) userMenuBtn.addEventListener('click', toggleUserMenu);
            if (userAvatarBtn) userAvatarBtn.addEventListener('click', toggleUserMenu);

            // ------------------ Mobile Menu Overlay ------------------
            if (mobileMenuBtn && mobileMenu && mobileMenuCloseBtn) {
                mobileMenuBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    mobileMenu.classList.remove('hidden');
                    closeNotif();
                    closeUserMenu();
                });

                mobileMenuCloseBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    mobileMenu.classList.add('hidden');
                });

                document.addEventListener('click', function() {
                    mobileMenu.classList.add('hidden');
                });

                mobileMenu.addEventListener('click', function(e) {
                    e.stopPropagation();
                });
            }

            // ------------------ Global behavior ------------------
            document.addEventListener('click', function(e) {
                // Don't close menus if clicking inside them
                if (notifPanel && notifPanel.contains(e.target)) return;
                if (userMenu && userMenu.contains(e.target)) return;
                // Don't close if clicking the buttons that open them
                if (notifBtn && notifBtn.contains(e.target)) return;
                if (userMenuBtn && userMenuBtn.contains(e.target)) return;
                if (userAvatarBtn && userAvatarBtn.contains(e.target)) return;
                
                closeNotif();
                closeUserMenu();
            });

            if (notifPanel) notifPanel.addEventListener('click', function(e) { e.stopPropagation(); });
            if (userMenu) {
                userMenu.addEventListener('click', function(e) { 
                    e.stopPropagation(); 
                    // Allow Profile link clicks to navigate
                    if (e.target.tagName === 'A' && e.target.closest('#userMenu')) {
                        // Let the link navigate normally
                        return true;
                    }
                });
            }

            window.addEventListener('resize', function() { if (notifPanel && !notifPanel.classList.contains('hidden')) positionNotifPanel(); if (userMenu && !userMenu.classList.contains('hidden')) positionUserMenu(); });
            window.addEventListener('scroll', function() { if (notifPanel && !notifPanel.classList.contains('hidden')) positionNotifPanel(); if (userMenu && !userMenu.classList.contains('hidden')) positionUserMenu(); }, true);
        })();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
