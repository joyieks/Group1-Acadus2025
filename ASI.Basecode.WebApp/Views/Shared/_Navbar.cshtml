@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<!-- Header / Navbar -->
<header class="bg-white/90 backdrop-blur-sm border-b border-black/10 px-4 md:px-8 py-4 flex justify-between items-center sticky top-0 z-50">
    <!-- Logo -->
    <div class="flex items-center gap-2 text-xl font-semibold text-acadus-green">
        <img src="~/img/acaduslogo.png" alt="Acadus Logo" class="h-12" />
        <div class="text-[#295239] font-bold text-2xl">
            Acadus
        </div>
    </div>

    <!-- Center Nav (desktop) -->
    <nav class="hidden md:flex gap-4 font-[Poppins]">
        @if (controller == "Student")
        {
            <!-- Courses -->
            <a asp-controller="Student" asp-action="Courses"
               class="px-4 py-2 rounded-md text-sm transition-all duration-200 no-underline 
                    @(action == "Courses" ? 
                    "bg-acadus-green text-white font-bold shadow-sm" : "text-[#337D58] hover:bg-acadus-green/10")">
                Courses
            </a>

            <!-- Dashboard -->
            <a asp-controller="Student" asp-action="Index"
               class="px-4 py-2 rounded-md text-sm transition-all duration-200 no-underline 
                    @(action == "Index" ? 
                    "bg-acadus-green text-white font-bold shadow-sm" : "text-[#337D58] hover:bg-acadus-green/10")">
                Dashboard
            </a>

            <!-- Reports -->
            <a asp-controller="Student" asp-action="Reports"
               class="px-4 py-2 rounded-md text-sm transition-all duration-200 no-underline
                    @(action == "Reports" ? 
                    "bg-acadus-green text-white font-bold shadow-sm" : "text-[#337D58] hover:bg-acadus-green/10")">
               Reports
            </a>
        }
        else if (controller == "Teacher")
        {
            <!-- Courses -->
            <a asp-controller="Teacher" asp-action="Courses"
               class="px-4 py-2 rounded-md text-sm transition-all duration-200 no-underline 
                    @(action == "Courses" ? 
                    "bg-acadus-green text-white font-bold shadow-sm" : "text-[#337D58] hover:bg-acadus-green/10")">
                Courses
            </a>

            <!-- Dashboard -->
            <a asp-controller="Teacher" asp-action="Index"
               class="px-4 py-2 rounded-md text-sm transition-all duration-200 no-underline 
                    @(action == "Index" ? 
                    "bg-acadus-green text-white font-bold shadow-sm" : "text-[#337D58] hover:bg-acadus-green/10")">
                Dashboard
            </a>
        }
        else if (controller == "Admin")
        {
            <!-- Courses -->
            <a asp-controller="Admin" asp-action="Courses"
               class="px-4 py-2 rounded-md text-sm transition-all duration-200 no-underline 
                    @(action == "Courses" ? 
                    "bg-acadus-green text-white font-bold shadow-sm" : "text-[#337D58] hover:bg-acadus-green/10")">
                Courses
            </a>

            <!-- Dashboard -->
            <a asp-controller="Admin" asp-action="Dashboard"
               class="px-4 py-2 rounded-md text-sm transition-all duration-200 no-underline 
                    @(action == "Dashboard" ? 
                    "bg-acadus-green text-white font-bold shadow-sm" : "text-[#337D58] hover:bg-acadus-green/10")">
                Dashboard
            </a>

            <!-- Users -->
            <a asp-controller="Admin" asp-action="Users"
               class="px-4 py-2 rounded-md text-sm transition-all duration-200 no-underline
                    @(action == "Users" || action == "AddStudent" || action == "AddTeacher" ? 
                    "bg-acadus-green text-white font-bold shadow-sm" : "text-[#337D58] hover:bg-acadus-green/10")">
               Users
            </a>
        }
    </nav>

    <!-- Mobile Menu Toggle -->
    <button id="mobileMenuBtn" class="md:hidden inline-flex items-center justify-center p-2 rounded-md text-[#337D58] hover:bg-acadus-green/10 focus:outline-none" aria-controls="mobileMenu" aria-expanded="false">
        <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
    </button>

    <!-- Right side: User (desktop) -->
    <div class="hidden md:flex items-center gap-4 relative">
        <div class="flex items-center gap-3 relative">
            <!-- Name button (toggle) -->
            <button id="userMenuBtn" type="button" data-user-toggle="true" class="text-left"> Username </button>

            <!-- Avatar Circle (toggle) -->
            <button id="userAvatarBtn" type="button" data-user-toggle="true" class="w-10 h-10 rounded-full bg-gray-300 flex items-center justify-center overflow-hidden">
                <span class="text-gray-500 text-sm font-semibold">U</span>
            </button>

            <!-- User Menu Dropdown (template) -->
            <div id="userMenu" data-user-menu-template="true" class="hidden absolute right-0 top-12 z-[9999] bg-white shadow-lg rounded-xl border border-gray-100 w-48">
                @if (controller == "Admin")
                {
                    <a asp-controller="Admin" asp-action="EditProfile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Profile</a>
                }
                else if (controller == "Teacher")
                {
                    <a asp-controller="Teacher" asp-action="Profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Profile</a>
                }
                else if (controller == "Student")
                {
                    <a asp-controller="Student" asp-action="Profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Profile</a>
                }
                else
                {
                    <a href="/Home/Profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Profile</a>
                }
                <a href="/Auth/Login" class="block px-4 py-2 text-sm text-red-600 hover:bg-gray-50">Logout</a>
            </div>
        </div>
    </div>
</header>

