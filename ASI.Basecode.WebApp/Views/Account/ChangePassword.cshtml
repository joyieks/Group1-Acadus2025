@{
    Layout = "~/Views/Shared/_AuthenticatedLayout.cshtml";
    ViewData["Title"] = "Change Password";
}

<script src="https://cdn.tailwindcss.com"></script>

<main class="max-w-md mx-auto px-4 md:px-8 pt-8 pb-12">
    <h1 class="text-2xl font-bold text-[#337D58] mb-6">Change Password</h1>

    <!-- ✅ Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
   <div class="mb-6 bg-green-50 border border-green-200 text-green-800 rounded-lg p-4">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- ✅ Single Error Message Container (Shows either server or client-side errors, never both) -->
    <div id="errorMessage" class="mb-6 bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 @(ViewData.ModelState.IsValid ? "hidden" : "")">
 <div id="errorText">
            @if (!ViewData.ModelState.IsValid)
          {
            @* Show only the FIRST error message to avoid stacking *@
      var firstError = ViewData.ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault();
       if (firstError != null)
  {
            @firstError.ErrorMessage
        }
 }
   </div>
    </div>

    <form asp-controller="Account" asp-action="ChangePassword" method="post" class="space-y-4" id="changePasswordForm">
        @Html.AntiForgeryToken()

        <!-- Current Password -->
        <div>
       <label class="block text-sm font-medium text-gray-700 mb-1">Current Password</label>
    <div class="relative">
           <input type="password" name="CurrentPassword" id="currentPassword" 
         class="w-full px-4 py-2 border rounded-lg pr-10" required />
     <button type="button" id="toggleCurrentPassword" 
     class="absolute inset-y-0 right-0 px-3 text-gray-500">Show</button>
      </div>
     </div>

        <!-- New Password -->
      <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">New Password</label>
            <div class="relative">
     <input type="password" name="NewPassword" id="newPassword" 
         class="w-full px-4 py-2 border rounded-lg pr-10" required minlength="8" />
     <button type="button" id="toggleNewPassword" 
          class="absolute inset-y-0 right-0 px-3 text-gray-500">Show</button>
            </div>
   <p class="mt-2 text-xs text-gray-500">Must be at least 8 characters with uppercase, lowercase, number, and special character</p>
      </div>

        <!-- Confirm New Password -->
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Confirm New Password</label>
  <div class="relative">
       <input type="password" name="ConfirmPassword" id="confirmPassword" 
           class="w-full px-4 py-2 border rounded-lg pr-10" required minlength="8" />
      <button type="button" id="toggleConfirmPassword" 
class="absolute inset-y-0 right-0 px-3 text-gray-500">Show</button>
         </div>
  </div>

        <!-- Password Requirements -->
   <div>
<div id="password-requirements" class="space-y-2 text-sm text-gray-600">
        <div id="req-length">• At least 8 characters</div>
     <div id="req-uppercase">• One uppercase letter (A-Z)</div>
         <div id="req-lowercase">• One lowercase letter (a-z)</div>
        <div id="req-number">• One number (0-9)</div>
       <div id="req-special">• One special character (!*(),.?":{}|<>)</div>
       </div>
         <div id="password-strength" class="mt-2 text-sm"></div>
        </div>

        <button type="submit" class="w-full bg-acadus-green text-white px-4 py-2 rounded-lg hover:bg-acadus-light-green transition">
   Update Password
     </button>
    </form>
</main>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const newPassword = document.getElementById('newPassword');
const confirmPassword = document.getElementById('confirmPassword');
    const toggleNew = document.getElementById('toggleNewPassword');
    const toggleConfirm = document.getElementById('toggleConfirmPassword');
    const toggleCurrent = document.getElementById('toggleCurrentPassword');
    const currentPassword = document.getElementById('currentPassword');
    const strength = document.getElementById('password-strength');
    const form = document.getElementById('changePasswordForm');
    const errorContainer = document.getElementById('errorMessage');
    const errorText = document.getElementById('errorText');
    
    let autoHideTimeout = null;

    // ✅ Professional Error Display Function (Shows ONE error at a time)
  function showError(message, focusElement) {
        // Clear any existing auto-hide timeout
        if (autoHideTimeout) {
          clearTimeout(autoHideTimeout);
    }

errorText.textContent = message;
        errorContainer.classList.remove('hidden');
        
        // Scroll to error message
  errorContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
        
        // Focus the problematic field
        if (focusElement) {
            setTimeout(() => focusElement.focus(), 300);
        }
        
        // ✅ Auto-hide after 3 seconds (reduced from 5)
        autoHideTimeout = setTimeout(() => {
            errorContainer.classList.add('hidden');
  }, 3000);
    }

    function hideError() {
        if (autoHideTimeout) {
            clearTimeout(autoHideTimeout);
        }
        errorContainer.classList.add('hidden');
    }

    // Toggle password visibility
    function toggle(field, btn){
   if (!field || !btn) return;
        btn.addEventListener('click', function(){
          const isText = field.type === 'text';
   field.type = isText ? 'password' : 'text';
      btn.textContent = isText ? 'Show' : 'Hide';
        });
    }
    toggle(newPassword, toggleNew);
    toggle(confirmPassword, toggleConfirm);
    toggle(currentPassword, toggleCurrent);

    // Password requirement checker
    function checkReq(id, ok){
        const el = document.getElementById(id);
    if (!el) return;
   el.style.color = ok ? '#059669' : '';
      el.style.fontWeight = ok ? '600' : '';
    }

    // Password strength indicator
    function updateStrength(pw){
        if (!strength) return;
 if (!pw){ strength.textContent=''; return; }
        let s = 0;
        if (pw.length >= 8) s++;
        if (pw.length >= 12) s++;
        if (/[A-Z]/.test(pw)) s++;
if (/[a-z]/.test(pw)) s++;
        if (/\d/.test(pw)) s++;
        const specials = '!*(),.?":{}|<>';
        if (pw.split('').some(c => specials.includes(c))) s++;
        strength.textContent = s < 3 ? 'Weak password' : (s < 5 ? 'Medium strength' : 'Strong password');
        strength.style.color = s < 3 ? '#dc2626' : (s < 5 ? '#d97706' : '#059669');
    }

    // Real-time password validation
    newPassword && newPassword.addEventListener('input', function(){
        const pw = newPassword.value;
        checkReq('req-length', pw.length >= 8);
    checkReq('req-uppercase', /[A-Z]/.test(pw));
      checkReq('req-lowercase', /[a-z]/.test(pw));
        checkReq('req-number', /\d/.test(pw));
        const specials = '!*(),.?":{}|<>';
     checkReq('req-special', pw.split('').some(c => specials.includes(c)));
        updateStrength(pw);
   
        // Hide error when user starts typing
        hideError();
    });

    // Hide error when user types in any field
    [currentPassword, confirmPassword].forEach(field => {
  field && field.addEventListener('input', hideError);
    });

  // ✅ Form submission validation (CLIENT-SIDE ONLY - Basic checks)
    form && form.addEventListener('submit', function(e) {
        const currentPw = currentPassword.value;
        const newPw = newPassword.value;
 const confirmPw = confirmPassword.value;

        // ✅ Check if passwords match (client-side only)
        if (newPw !== confirmPw) {
   e.preventDefault();
  showError('New password and confirm password do not match.', confirmPassword);
 return false;
      }

        // ✅ Check if new password is same as current password (client-side only)
        // NOTE: This is just a basic check. Server will verify current password properly.
        if (currentPw && newPw && currentPw === newPw) {
        e.preventDefault();
            showError('New password must be different from your current password.', newPassword);
            return false;
        }

        // All client-side checks passed, submit to server for proper validation
    });
});
</script>
