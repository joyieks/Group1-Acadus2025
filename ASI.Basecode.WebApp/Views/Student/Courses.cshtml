@model ASI.Basecode.WebApp.Models.CourseCardViewModel[]

@{
    ViewData["Title"] = "Course Overview - Acadus";
}

<script src="https://cdn.tailwindcss.com"></script>

<main class="max-w-7xl mx-auto px-4 md:px-8 pt-4 pb-12">
    <section class="text-center mb-12">
        <h1 class="text-4xl font-bold text-[#337D58] mb-2">Course Overview</h1>
        <p class="text-lg text-gray-600">Select a course to view details and track progress</p>
    </section>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center text-gray-500 text-lg mt-20">
            No courses available yet.
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            @foreach (var course in Model)
            {
                @try
                {
                    @await Component.InvokeAsync("CourseCard", course)
                }
                catch (Exception ex)
                {
                    <div class="text-red-500">Error rendering course card: @ex.Message</div>
                }
            }
        </div>
    }
</main>
